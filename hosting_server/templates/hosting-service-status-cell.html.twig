{#
/**
 * @file
 * Template for hosting service status cell.
 *
 * Available variables:
 * - text: The status text to display.
 * - available: Boolean indicating if the service is available.
 * - service_type: The type of service.
 * - provider_id: The service provider ID.
 * - provider_label: The service provider label.
 * - attributes: HTML attributes for the span element.
 */
#}
<span{{ attributes }}>{{ text }}</span>
