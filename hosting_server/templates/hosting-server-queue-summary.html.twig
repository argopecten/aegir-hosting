{#
/**
 * @file
 * Template for hosting server queue summary section.
 *
 * Available variables:
 * - title: The section title.
 * - list: The queue summary list.
 * - attributes: HTML attributes for the section element.
 */
#}
<section{{ attributes }}>
  {% if title %}
    <h3>{{ title }}</h3>
  {% endif %}
  {{ list }}
</section>
