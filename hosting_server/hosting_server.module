<?php

/**
 * @file
 * Hosting server module.
 */

/**
 * Implements hook_hosting_feature().
 */
function hosting_server_hosting_feature() {
  return [
    'server' => [
      'title' => t('Servers'),
      'description' => t('Server records and service assignments.'),
      'module' => 'hosting_server',
      'required' => TRUE,
      'dependencies' => [],
    ],
  ];
}

/**
 * Implements hook_theme().
 */
function hosting_server_theme($existing, $type, $theme, $path): array {
  return [
    'hosting_server' => [
      'render element' => 'elements',
      'template' => 'hosting-server',
    ],
    'hosting_service_status_cell' => [
      'variables' => [
        'text' => NULL,
        'available' => NULL,
        'service_type' => NULL,
        'provider_id' => NULL,
        'provider_label' => NULL,
        'attributes' => NULL,
      ],
      'template' => 'hosting-service-status-cell',
    ],
    'hosting_server_sidebar' => [
      'variables' => [
        'content' => NULL,
        'attributes' => NULL,
      ],
      'template' => 'hosting-sidebar',
      'path' => \Drupal::service('extension.list.module')->getPath('hosting') . '/templates',
    ],
    'hosting_server_task_queue' => [
      'variables' => [
        'title' => NULL,
        'list' => NULL,
        'attributes' => NULL,
      ],
      'template' => 'hosting-task-queue',
      'path' => \Drupal::service('extension.list.module')->getPath('hosting') . '/templates',
    ],
    'hosting_server_navigation' => [
      'variables' => [
        'title' => NULL,
        'list' => NULL,
        'attributes' => NULL,
      ],
      'template' => 'hosting-navigation',
      'path' => \Drupal::service('extension.list.module')->getPath('hosting') . '/templates',
    ],
    'hosting_server_queue_summary' => [
      'variables' => [
        'title' => NULL,
        'list' => NULL,
        'attributes' => NULL,
      ],
      'template' => 'hosting-server-queue-summary',
    ],
  ];
}

/**
 * Prepares variables for hosting server templates.
 *
 * Default template: hosting-server.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the server information and any
 *     fields attached to the entity.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_hosting_server(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'];
  $variables['server'] = $variables['elements']['#hosting_server'];
  $variables['entity'] = $variables['server'];
  
  // Helpful $content variable for templates.
  foreach (\Drupal\Core\Render\Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
  
  // Add title prefix/suffix.
  $variables['title_prefix'] = $variables['elements']['#title_prefix'] ?? [];
  $variables['title_suffix'] = $variables['elements']['#title_suffix'] ?? [];
  
  // Set label and title attributes.
  $variables['label'] = $variables['server']->label();
  $variables['title_attributes'] = $variables['elements']['#title_attributes'] ?? new \Drupal\Core\Template\Attribute();
  
  // Pass sidebar if it exists.
  $variables['sidebar'] = $variables['content']['hosting_sidebar'] ?? NULL;
  unset($variables['content']['hosting_sidebar']);

  // Extract info table and task table for template regions.
  $variables['info'] = $variables['content']['info'] ?? NULL;
  unset($variables['content']['info']);
  $variables['tasks_view'] = $variables['content']['tasks_view'] ?? NULL;
  unset($variables['content']['tasks_view']);
}

/**
 * Implements hook_entity_view().
 */
function hosting_server_entity_view(array &$build, \Drupal\Core\Entity\EntityInterface $entity, $display, $view_mode): void {
  if ($entity->getEntityTypeId() !== 'hosting_server') {
    return;
  }

  /** @var \Drupal\hosting_server\Entity\HostingServer $entity */
  $date_formatter = \Drupal::service('date.formatter');

  // Build info table matching D7 hosting_server_view().
  $info_items = [];

  // Human name.
  $human_name = $entity->get('human_name')->value ?? '';
  if ($human_name) {
    $info_items[] = [
      'label' => t('Name'),
      'value' => ['#markup' => \Drupal\Component\Utility\Html::escape($human_name)],
      'weight' => -20,
    ];
  }

  // Hostname.
  $hostname = $entity->get('hostname')->value ?? '';
  if ($hostname) {
    $info_items[] = [
      'label' => t('Hostname'),
      'value' => ['#markup' => '<code>' . \Drupal\Component\Utility\Html::escape($hostname) . '</code>'],
      'weight' => -18,
    ];
  }

  // IP addresses.
  $ip_field = $entity->get('ip_addresses');
  $ip_values = [];
  foreach ($ip_field as $item) {
    if ($item->value) {
      $ip_values[] = $item->value;
    }
  }
  if ($ip_values) {
    $info_items[] = [
      'label' => t('IP addresses'),
      'value' => ['#markup' => '<code>' . implode('</code>, <code>', array_map([\Drupal\Component\Utility\Html::class, 'escape'], $ip_values)) . '</code>'],
      'weight' => -15,
    ];
  }

  // Verified.
  $verified = (int) $entity->get('verified')->value;
  $info_items[] = [
    'label' => t('Verified'),
    'value' => ['#markup' => $verified ? $date_formatter->formatTimeDiffSince($verified) . ' ' . t('ago') : t('Never')],
    'weight' => -10,
  ];

  // Status.
  $status = (int) $entity->get('status')->value;
  $status_map = [
    \Drupal\hosting_server\Entity\HostingServer::STATUS_QUEUED => ['label' => t('Queued'), 'class' => 'hosting-queue'],
    \Drupal\hosting_server\Entity\HostingServer::STATUS_ENABLED => ['label' => t('Enabled'), 'class' => 'hosting-success'],
    \Drupal\hosting_server\Entity\HostingServer::STATUS_LOCKED => ['label' => t('Locked'), 'class' => 'hosting-warning'],
    \Drupal\hosting_server\Entity\HostingServer::STATUS_DELETED => ['label' => t('Deleted'), 'class' => 'hosting-error'],
  ];
  $status_info = $status_map[$status] ?? ['label' => t('Unknown'), 'class' => ''];
  $info_items[] = [
    'label' => t('Status'),
    'value' => ['#markup' => '<span class="' . $status_info['class'] . '">' . $status_info['label'] . '</span>'],
    'weight' => -5,
  ];

  $build['info'] = [
    '#theme' => 'hosting_info_table',
    '#items' => $info_items,
    '#attributes' => ['id' => 'hosting-server-info'],
    '#weight' => -5,
  ];

  // Services table.
  $storage = \Drupal::entityTypeManager()->getStorage('hosting_service_instance');
  $instances = $storage->loadByProperties(['server' => $entity->id()]);

  if ($instances) {
    $service_manager = \Drupal::service('hosting.service_manager');
    $rows = [];
    foreach ($instances as $instance) {
      $service_type = (string) $instance->get('service_type')->value;
      $provider_id = (string) $instance->get('provider')->value;
      $available = (bool) $instance->get('available')->value;
      $providers = $service_manager->getProvidersForType($service_type);
      $provider_label = (string) ($providers[$provider_id] ?? $provider_id);
      $rows[] = [
        'data' => [
          $service_type,
          $provider_label,
          $available ? t('Yes') : t('No'),
        ],
      ];
    }

    $build['hosting_services'] = [
      '#type' => 'table',
      '#header' => [t('Service type'), t('Provider'), t('Available')],
      '#rows' => $rows,
      '#attributes' => ['class' => ['hosting-table', 'hosting-services-table']],
      '#weight' => 50,
    ];
  }

  // Task table.
  $task_resolver = \Drupal::service('hosting.task_availability_resolver');
  $build['tasks_view'] = $task_resolver->buildTaskTable($entity);
  $build['tasks_view']['#weight'] = 9;

  // Attach task table AJAX refresh.
  $build['#attached']['library'][] = 'hosting_task/task-table-refresh';
  $build['#attached']['drupalSettings']['hostingTaskTable']['refreshUrl'] = \Drupal\Core\Url::fromRoute('hosting_task.refresh.task_table', [
    'entity_type_id' => 'hosting_server',
    'entity_id' => $entity->id(),
  ])->toString();

  // Sidebar: recent tasks + queues + navigation.
  $context_storage = \Drupal::entityTypeManager()->getStorage('hosting_context');
  $context_records = $context_storage->loadByProperties([
    'entity_type' => 'hosting_server',
    'entity_id' => $entity->id(),
  ]);
  $context_record = $context_records ? reset($context_records) : NULL;
  $context_name = $context_record ? (string) $context_record->get('context_name')->value : '';

  $task_items = [];
  $task_tags = [];
  if ($context_name !== '') {
    $task_query = \Drupal::entityQuery('hosting_task')
      ->condition('context_name', $context_name)
      ->sort('id', 'DESC')
      ->range(0, 5)
      ->accessCheck(TRUE);
    $task_ids = $task_query->execute();
    if ($task_ids) {
      $task_storage = \Drupal::entityTypeManager()->getStorage('hosting_task');
      $tasks = $task_storage->loadMultiple($task_ids);
      foreach ($tasks as $task) {
        $t_status = (string) $task->get('status')->value;
        $task_items[] = [
          '#type' => 'container',
          '#attributes' => [
            'class' => ['hosting-task-item', 'hosting-task-item--' . \Drupal\Component\Utility\Html::getClass($t_status)],
          ],
          'title' => [
            '#type' => 'link',
            '#title' => $task->label(),
            '#url' => $task->toUrl(),
          ],
          'status' => [
            '#type' => 'html_tag',
            '#tag' => 'span',
            '#value' => $t_status,
            '#attributes' => ['class' => ['hosting-task-status']],
          ],
        ];
        $task_tags = \Drupal\Core\Cache\Cache::mergeTags($task_tags, $task->getCacheTags());
      }
    }
  }

  $queue_dispatcher = \Drupal::service('hosting.queue_dispatcher');
  $queues = $queue_dispatcher->getQueuesWithState();
  $queue_items = [];
  foreach ($queues as $queue) {
    $queue_items[] = [
      '#type' => 'container',
      '#attributes' => [
        'class' => ['hosting-queue-item', $queue['enabled'] ? 'is-enabled' : 'is-disabled'],
      ],
      'label' => [
        '#type' => 'html_tag',
        '#tag' => 'strong',
        '#value' => (string) $queue['label'],
        '#attributes' => ['class' => ['hosting-queue-label']],
      ],
      'status' => [
        '#type' => 'html_tag',
        '#tag' => 'span',
        '#value' => $queue['enabled'] ? t('Enabled') : t('Disabled'),
        '#attributes' => ['class' => ['hosting-queue-status']],
      ],
    ];
  }

  $build['hosting_sidebar'] = [
    '#theme' => 'hosting_server_sidebar',
    '#content' => [
      'task_queue' => [
        '#theme' => 'hosting_server_task_queue',
        '#title' => t('Task queue'),
        '#list' => [
          '#theme' => 'item_list',
          '#items' => $task_items,
          '#empty' => t('No tasks available.'),
          '#attributes' => ['class' => ['hosting-task-queue']],
        ],
        '#attributes' => ['class' => ['hosting-panel', 'hosting-panel--task-queue']],
      ],
      'navigation' => [
        '#theme' => 'hosting_server_navigation',
        '#title' => t('Navigation'),
        '#list' => [
          '#theme' => 'item_list',
          '#items' => [
            ['#type' => 'link', '#title' => t('All tasks'), '#url' => \Drupal\Core\Url::fromRoute('entity.hosting_task.collection')],
            ['#type' => 'link', '#title' => t('Queues'), '#url' => \Drupal\Core\Url::fromRoute('hosting.admin.queues')],
            ['#type' => 'link', '#title' => t('Edit server'), '#url' => $entity->toUrl('edit-form')],
            ['#type' => 'link', '#title' => t('All servers'), '#url' => \Drupal\Core\Url::fromRoute('entity.hosting_server.collection')],
            ['#type' => 'link', '#title' => t('All sites'), '#url' => \Drupal\Core\Url::fromRoute('entity.hosting_site.collection')],
            ['#type' => 'link', '#title' => t('All platforms'), '#url' => \Drupal\Core\Url::fromRoute('entity.hosting_platform.collection')],
          ],
          '#attributes' => ['class' => ['hosting-navigation']],
        ],
        '#attributes' => ['class' => ['hosting-panel', 'hosting-panel--navigation']],
      ],
      'queue_summary' => [
        '#theme' => 'hosting_server_queue_summary',
        '#title' => t('Queues summary'),
        '#list' => [
          '#theme' => 'item_list',
          '#items' => $queue_items,
          '#empty' => t('No queues configured.'),
          '#attributes' => ['class' => ['hosting-queue-summary']],
        ],
        '#attributes' => ['class' => ['hosting-panel', 'hosting-panel--queue-summary']],
      ],
    ],
    '#attributes' => ['class' => ['hosting-sidebar']],
    '#weight' => 60,
  ];

  $build['#attributes']['class'][] = 'hosting-server-view';

  $tags = $build['#cache']['tags'] ?? [];
  if ($instances) {
    foreach ($instances as $instance) {
      $tags = \Drupal\Core\Cache\Cache::mergeTags($tags, $instance->getCacheTags());
    }
  }
  if ($task_tags) {
    $tags = \Drupal\Core\Cache\Cache::mergeTags($tags, $task_tags);
  }
  if ($tags) {
    $build['#cache']['tags'] = $tags;
  }

  $build['hosting_sidebar']['#queue_summary']['#cache']['max-age'] = 0;
}
