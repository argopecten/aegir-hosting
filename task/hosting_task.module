<?php
/**
 * @file
 * Web server node type is defined here.
 */

/**
 * Implements hook_page_attachments().
 */
function hosting_task_page_attachments(array &$attachments) {
  $attachments['#attached']['drupalSettings']['hostingTaskRefresh'] = array(
    'refreshTimeout' => \Drupal::config('hosting_task.settings')->get('hosting_task_refresh_timeout') ?? 30000,
  );
}

/**
 * Load a hosting task entity.
 */
function hosting_task_load_entity($task_id) {
  if (!is_numeric($task_id)) {
    return NULL;
  }
  return \Drupal::entityTypeManager()->getStorage('hosting_task')->load($task_id);
}

/**
 * Normalize task ID from entity or scalar.
 */
function hosting_task_entity_id($task) {
  if ($task instanceof \Drupal\Core\Entity\EntityInterface) {
    return (int) $task->id();
  }
  return is_numeric($task) ? (int) $task : NULL;
}

/**
 * Get the changed timestamp for a hosting entity.
 */
function hosting_task_entity_changed($entity) {
  if ($entity instanceof \Drupal\Core\Entity\ContentEntityInterface && method_exists($entity, 'getChangedTime')) {
    return (int) $entity->getChangedTime();
  }
  if (is_object($entity) && isset($entity->changed)) {
    return (int) $entity->changed;
  }
  return 0;
}


/**
 * Read additional task log data, served via AJAX.
 */
function hosting_task_log_ajax($task, $last_position, $id) {
  $commands = array();

  // Long polling for ten seconds.
  $expire = time() + 10;
  $table = FALSE;
  while ((empty($table) || !count($table['#rows'])) && (time() < $expire)) {
    usleep(200000);
    $table = _hosting_task_log_table($task, $last_position);
  }

  if (isset($table['#refresh_url'])) {
    $url = $table['#refresh_url'];
  }
  else {
    $url = \Drupal\Core\Url::fromUserInput('/hosting/task/log/ajax/' . hosting_task_entity_id($task) . '/' . $last_position)->toString();
  }

  if (!empty($table)) {
    unset($table['#header']);
    $commands[] = hosting_task_ajax_command_hosting_table_append('#' . $id, \Drupal::service('renderer')->render($table));
  }

  if (!hosting_task_task_has_finished($task)) {
    $commands[] = hosting_task_ajax_command_hosting_table_check('#' . $id, $url);
  }

  return array(
    '#type' => 'ajax',
    '#commands' => $commands,
  );
}

/**
 * Determine if the given task has finished and completed.
 *
 * @param $task
 *   The task node to check.
 *
 * @return bool
 *   True if task has finished, false otherwise.
 */
function hosting_task_task_has_finished($task) {
  $delta = NULL;
  $executed = NULL;
  if ($task instanceof \Drupal\Core\Entity\EntityInterface && $task->getEntityTypeId() === 'hosting_task') {
    $delta = (int) $task->get('delta')->value;
    $executed = (int) $task->get('executed')->value;
  }
  elseif (is_object($task)) {
    $delta = isset($task->delta) ? (int) $task->delta : NULL;
    $executed = isset($task->executed) ? (int) $task->executed : NULL;
  }
  // Allow an additional 30 seconds for the logs to be entered into the DB.
  return !empty($delta) && $executed + $delta + 30 < REQUEST_TIME;
}

/**
 * Prepare a JS command array for AJAX to append to a hosting task log table.
 *
 * @param string $selector
 *   HTML css selector of the table to append entries to.
 * @param string $html
 *   HTML table of rows to append.
 * @param array $settings
 *   Extra settings to add to Drupal.settings.
 *
 * @return array
 *   A JS command array.
 */
function hosting_task_ajax_command_hosting_table_append($selector, $html, $settings = NULL) {
  return array(
    'command' => 'hosting_table_append',
    'selector' => $selector,
    'data' => $html,
    'settings' => $settings,
  );
}

/**
 * Prepare a JS command array for AJAX to poll for additional log entries.
 *
 * @param string $selector
 *   HTML css selector of the log entries table.
 * @param string $url
 *   URL to poll for changes.
 * @param array $settings
 *   Extra settings to add to Drupal.settings.
 *
 * @return array
 *   A JS command array.
 */
function hosting_task_ajax_command_hosting_table_check($selector, $url, $settings = NULL) {
  return array(
    'command' => 'hosting_table_check',
    'selector' => $selector,
    'url' => $url,
    'settings' => $settings,
  );
}

/**
 * Page callback to provide JSON output for a task.
 */
function hosting_task_ajax_list($entity) {
  $table_build = hosting_task_table($entity);
  $return['markup'] = \Drupal::service('renderer')->renderPlain($table_build);
  $return['changed'] = hosting_task_entity_changed($entity);
  if ($entity instanceof \Drupal\Core\Entity\EntityInterface) {
    $return['navigate_url'] = $entity->toUrl('canonical')->toString();
  }
  else {
    $fallback = hosting_entity_load_any(hosting_entity_id($entity));
    $return['navigate_url'] = $fallback instanceof \Drupal\Core\Entity\EntityInterface
      ? $fallback->toUrl('canonical')->toString()
      : \Drupal\Core\Url::fromRoute('<front>')->toString();
  }
  return $return;
}

/**
 * AJAX callback for refreshing task list.
 */
function hosting_task_ajax_queue() {
  $view = \Drupal\views\Views::getView('hosting_task_list');
  if (!$view) {
    $return['markup'] = '';
    return $return;
  }
  $view->set_display('block');
  $view->pre_execute();
  $return['markup'] = $view->render('block');
  return $return;
}

/**
 * Cancel a task before it's started.
 */
function hosting_task_cancel($task) {
  if ($task instanceof \Drupal\Core\Entity\EntityInterface && $task->getEntityTypeId() === 'hosting_task' && (int) $task->get('task_status')->value === HOSTING_TASK_QUEUED) {
    $task->set('task_status', HOSTING_TASK_WARNING);
    $task->save();

    // Log the cancellation.
    hosting_task_log($task->id(), 'warning', t("Task was cancelled."));
    $ref = hosting_entity_load_from_context_id($task->get('rid')->value);
    if ($ref instanceof \Drupal\Core\Entity\EntityInterface) {
      return new \Symfony\Component\HttpFoundation\RedirectResponse($ref->toUrl('canonical')->toString());
    }
    $fallback = hosting_entity_load_any($task->get('rid')->value);
    $redirect_url = $fallback instanceof \Drupal\Core\Entity\EntityInterface
      ? $fallback->toUrl('canonical')->toString()
      : \Drupal\Core\Url::fromRoute('<front>')->toString();
    return new \Symfony\Component\HttpFoundation\RedirectResponse($redirect_url);
  }

  throw new \Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException();
}

/**
 * Implements hook_access().
 *
 * @param $node object
 *   the node object we're trying to access
 */
function hosting_task_cancel_access($task) {
  $account = \Drupal::currentUser();
  $account_id = $account->id();
  if (!$task instanceof \Drupal\Core\Entity\EntityInterface || $task->getEntityTypeId() !== 'hosting_task') {
    return FALSE;
  }

  // To prevent CSRF attacks, a unique token based upon user is used. Deny
  // access if the token is missing or invalid.
  $token_service = \Drupal::service('csrf_token');
  if (!isset($_GET['token']) || !$token_service->validate((string) $_GET['token'], (string) $account_id)) {
    return FALSE;
  }

  // 'administer tasks' allows cancelling any and all tasks on the system.
  if (\Drupal::currentUser()->hasPermission('administer tasks')) {
    return TRUE;
  }
  // 'cancel own tasks' allows cancelling any task the user *could have* created,
  // on nodes she can view.
  if (\Drupal::currentUser()->hasPermission('cancel own tasks')
    && \Drupal::currentUser()->hasPermission('create ' . $task->get('task_type')->value . ' task')
    && $task->access('view')) {
    return TRUE;
  }
}

/**
 * Task access controls.
 *
 * This function defines which tasks should be showed to the user but
 * especially which will be accessible to him, in the permissions system.
 *
 * @arg $node object
 *   the node object we're trying to access
 *
 * @arg $task string
 *   the task type we're trying to do on the $node
 *
 * @see hosting_task_menu()
 */
function hosting_task_menu_access($node, $task, \Drupal\Core\Session\AccountInterface $account = NULL) {
  if ($node instanceof \Drupal\Core\Entity\EntityInterface
    && $node->getEntityTypeId() === 'menu'
    && $account instanceof \Drupal\Core\Session\AccountInterface) {
    return \Drupal\Core\Access\AccessResult::neutral();
  }

  if (\Drupal::currentUser()->hasPermission("create " . $task . " task")) {
    $task_scope = hosting_entity_task_scope($node);
    $entity_id = hosting_entity_id($node);
    $entity_status = hosting_entity_status($node, $task_scope);

    if ($task_scope == 'site') {
      if (hosting_task_outstanding($entity_id, 'delete') || ($entity_status == HOSTING_SITE_DELETED)) {
        return FALSE;
      }
      if (($task == 'login-reset') && ($entity_status != HOSTING_SITE_ENABLED)) {
        return FALSE;
      }
      $safe_tasks = array('backup', 'backup-delete', 'verify', 'enable');
      if (!in_array($task, $safe_tasks)) {
        // Don't show certain tasks if the site is the 'special' main aegir site.
        if ($entity_id == hosting_get_hostmaster_site_id()) {
          return FALSE;
        }
      }

      $site_enabled = (hosting_task_outstanding($entity_id, 'enable') || ($entity_status == HOSTING_SITE_ENABLED));
      $deletable = ($task == "delete");
      $enabable = ($task == "enable");

      $delete_or_enable = ($deletable || $enabable);

      // If the site is not enabled, we can either delete it, or enable it again.
      if (!$site_enabled) {
        return ($delete_or_enable);
      }
      else {
        // Site is enabled.
        return (
                 // If we can just delete a site without disabling, allow that.
                 (!(\Drupal::config('hosting.settings')->get('hosting_require_disable_before_delete') ?? TRUE)) && $deletable
                 // Otherwise we must disable it first, hide the delete task and the enable task as well.
                 || !$delete_or_enable
               );
      }
    }
    if ($task_scope == 'platform') {
      // If the user can't edit this node, he can't create tasks on it.
      if (!$node->access('update', \Drupal::currentUser())) {
        return FALSE;
      }
      // If the platform is in a deleted state, nothing else can be done with it.
      if (hosting_task_outstanding($entity_id, 'delete') || ($entity_status == HOSTING_PLATFORM_DELETED)) {
        return FALSE;
      }
      // If the platform's been locked, we can unlock it, delete, batch migrate existing sites or verify.
      if ($entity_status == HOSTING_PLATFORM_LOCKED) {
        $platform_tasks = array('verify', 'unlock', 'delete', 'migrate');
        return (in_array($task, $platform_tasks));
      }
      else {
        // If the platform's unlocked, we can lock it, delete it or batch migrate sites
        $platform_tasks = array('verify', 'lock', 'delete', 'migrate');
      }
      return (in_array($task, $platform_tasks));
    }
    if ($task_scope === 'server') {
      // If the user can't edit this node, he can't create tasks on it.
      if (!$node->access('update', \Drupal::currentUser())) {
        return FALSE;
      }
      // todo probably need more checks
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Access callback helper for hosting task menu items.
 *
 * Implemented as a helper function since we only want to validate the CSRF
 * token when the user accesses a certain path, not when (for example) building
 * the list of tasks a user has access to.
 *
 * @arg $node object
 *   the node object we're trying to access
 *
 * @arg $task string
 *   the task type we're trying to do on the $node
 *
 *
 * @see hosting_task_menu_access()
 */
function hosting_task_menu_access_csrf($node, $task) {
  $account_id = \Drupal::currentUser()->id();

  $interactive_tasks = array('migrate', 'clone');

  // To prevent CSRF attacks, a unique token based upon user is used. Deny
  // access if the token is missing or invalid. We only do this on
  // non-interactive tasks.
  $token_service = \Drupal::service('csrf_token');
  if (!in_array($task, $interactive_tasks) && (!isset($_GET['token']) || !$token_service->validate((string) $_GET['token'], (string) $account_id))) {
    return FALSE;
  }
  // Call the main menu access handler.
  return hosting_task_menu_access($node, $task);
}

/**
 * Implements hook_hosting_queues().
 *
 * Return a list of queues that this module needs to manage.
 */
function hosting_task_hosting_queues() {
  $queue['tasks'] = array(
    'name' => t('Task queue'),
    'description' => t('Process the queue of outstanding hosting tasks.'),
    'type' => 'serial', // Run queue sequentially. always with the same parameters.
    'frequency' => strtotime("1 minute", 0), # run queue every minute.
    'items' => 5, # process 20 queue items per execution.
    'total_items' => hosting_task_count(),
    'singular' => t('task'),
    'plural' => t('tasks'),
    'running_items' => hosting_task_count_running(),
  );
  return $queue;
}

/**
 * Insert an entry in the task log.
 *
 * @param $task_id
 *   The task entity ID to add an entry for.
 * @param $type
 *   The type of log entry being added.
 * @param $message
 *   The message for this log entry.
 * @param $error
 *   (optional) The error code associated to this log entry.
 * @param $timestamp
 *   (optional) The UNIX timestamp of this log message, this defaults to the
 *   current time.
 */
function hosting_task_log($task_id, $type, $message, $error = '', $timestamp = NULL) {
  $timestamp = ($timestamp) ? $timestamp : REQUEST_TIME;
  $task_id = (int) $task_id;

  $id = \Drupal::database()->insert('hosting_task_log')
    ->fields(array(
      'task_id' => $task_id,
      'type' => $type,
      'message' => $message,
      'error' => isset($error) ? $error : '',
      'timestamp' => $timestamp,
    ))
    ->execute();
}

/**
 * Save task arguments for a hosting task entity.
 */
function hosting_task_save_arguments($task_id, array $args) {
  \Drupal::database()->delete('hosting_task_arguments')
    ->condition('task_id', $task_id)
    ->execute();
  foreach ($args as $key => $value) {
    \Drupal::database()->insert('hosting_task_arguments')
      ->fields(array(
        'task_id' => $task_id,
        'name' => $key,
        'value' => $value,
      ))
      ->execute();
  }
}

/**
 * Copy task arguments between task entities.
 */
function hosting_task_clone_arguments($source_task_id, $target_task_id) {
  $args = \Drupal::database()->query("SELECT name, value FROM {hosting_task_arguments} WHERE task_id = :task_id", array(':task_id' => $source_task_id))->fetchAllKeyed();
  if (!empty($args)) {
    hosting_task_save_arguments($target_task_id, $args);
  }
}

/**
 * Populate task_args property on a task entity.
 */
function hosting_task_load_arguments($task) {
  if (!$task instanceof \Drupal\Core\Entity\EntityInterface || $task->getEntityTypeId() !== 'hosting_task') {
    return $task;
  }
  $result = \Drupal::database()->query("SELECT name, value FROM {hosting_task_arguments} WHERE task_id = :task_id", array(':task_id' => $task->id()));
  $task->task_args = array();
  foreach ($result as $arg) {
    $task->task_args[$arg->name] = $arg->value;
  }
  return $task;
}

/**
 * Retry the given task
 */
function hosting_task_retry($task_id) {
  $task = hosting_task_load_entity($task_id);
  if (!$task) {
    return NULL;
  }
  if ((int) $task->get('task_status')->value != HOSTING_TASK_QUEUED) {
    \Drupal::messenger()->addMessage(t("The task is being retried and has been added to the hosting queue again"));
    hosting_task_log($task->id(), 'queue', t("The task is being retried and has been added to the hosting queue again"));

    $new_task = $task->createDuplicate();
    $new_task->set('task_status', HOSTING_TASK_QUEUED);
    $new_task->set('executed', 0);
    $new_task->set('delta', 0);
    $new_task->set('created', REQUEST_TIME);
    $new_task->set('changed', REQUEST_TIME);
    $new_task->save();

    hosting_task_clone_arguments($task->id(), $new_task->id());

    return new \Symfony\Component\HttpFoundation\RedirectResponse($new_task->toUrl('canonical')->toString());
  }
}

/**
 * Helper function to generate new task node
 */
function hosting_add_task($target, $type, $args = NULL, $status = HOSTING_TASK_QUEUED, $entity_type_id = NULL) {
  $account_id = \Drupal::currentUser()->id();

  $entity = NULL;
  if ($target instanceof \Drupal\Core\Entity\EntityInterface) {
    $entity = $target;
  }
  $target_id = hosting_entity_id($target);
  if (!$entity && $entity_type_id) {
    $entity = \Drupal::entityTypeManager()->getStorage($entity_type_id)->load($target_id);
  }

  // Guard against destructive tasks run on guarded nodes.
  if (!hosting_task_dangerous_task_is_allowed($type, $target_id)) {
    return FALSE;
  }

  $label = $entity ? hosting_entity_label($entity) : NULL;
  $owner_id = NULL;
  if ($entity && method_exists($entity, 'getOwnerId')) {
    $owner_id = $entity->getOwnerId();
  }
  if (!$label && $target_id) {
    $fallback_entity = hosting_entity_load_any($target_id);
    if ($fallback_entity) {
      $label = hosting_entity_label($fallback_entity);
      if (!$owner_id && method_exists($fallback_entity, 'getOwnerId')) {
        $owner_id = $fallback_entity->getOwnerId();
      }
    }
  }

  $task = \Drupal::entityTypeManager()->getStorage('hosting_task')->create(array(
    'label' => t("!type !title", array('!type' => $type, '!title' => $label)),
    'task_type' => $type,
    'rid' => $target_id,
    'task_status' => $status,
    'status' => 1,
    'uid' => $account_id ?: (int) $owner_id,
  ));
  /*
   * fallback the owner of the task to the owner of the node we operate
   * upon
   *
   * this is mostly for the signup form, which runs as the anonymous
   * user, but for which the node is set to the right user
   */
  $task->save();
  if (is_array($args)) {
    hosting_task_save_arguments($task->id(), $args);
  }
  return $task;
}

/**
 * Implements hook_form().
 */
function hosting_task_confirm_form($form, $form_state, $node, $task) {
  $form['#attached']['library'][] = 'hosting_task/task';
  $task_scope = hosting_entity_task_scope($node);
  $tasks = hosting_available_tasks($task_scope);
  $entity_id = hosting_entity_id($node);
  $entity_type_id = hosting_entity_type_id($node);
  if ($entity_type_id && strpos($entity_type_id, 'hosting_') !== 0) {
    $entity_type_id = NULL;
  }

  $form['help'] = array('#value' => $tasks[$task]['description']);
  $form['entity_id'] = array(
    '#type' => 'value',
    '#value' => $entity_id,
  );
  $form['entity_type'] = array(
    '#type' => 'value',
    '#value' => $entity_type_id,
  );
  $form['task'] = array(
    '#type' => 'value',
    '#value' => $task,
  );
  $form['parameters'] = array('#tree' => TRUE);

  // Invoke hosting_task_TASK_TYPE_form.
  $func = 'hosting_task_' . str_replace('-', '_', $task) . '_form';
  if (function_exists($func)) {
    $form['parameters'] += $func($node);
  }

  // Invoke hosting_task_TASK_TYPE_form_validate.
  $func = $func . '_validate';
  if (function_exists($func)) {
    $form['#validate'][] = $func;
    $form['#func_param_1'] = $node;
    $form['#func_param_2'] = $task;
  }
  $question = t("Are you sure you want to @task @object?", array('@task' => $task, '@object' => hosting_entity_label($node)));
  if (!empty($_REQUEST['destination'])) {
    $path = $_REQUEST['destination'];
  }
  elseif ($node instanceof \Drupal\Core\Entity\EntityInterface) {
    $path = ltrim($node->toUrl('canonical')->toString(), '/');
  }
  else {
    $fallback_entity = $entity_id ? hosting_entity_load_any($entity_id) : NULL;
    $path = $fallback_entity instanceof \Drupal\Core\Entity\EntityInterface ? ltrim($fallback_entity->toUrl('canonical')->toString(), '/') : '<front>';
  }
  $form['#title'] = $question;
  $form['actions'] = array('#type' => 'actions');
  $form['actions']['submit'] = array(
    '#type' => 'submit',
    '#value' => $tasks[$task]['title'],
  );
  $form['actions']['cancel'] = array(
    '#type' => 'link',
    '#title' => t('Cancel'),
    '#url' => \Drupal\Core\Url::fromUserInput('/' . ltrim($path, '/')),
  );

  // Add an extra class to the actions to allow us to
  // disable the cancel link via javascript for the modal dialog.
  $form['actions']['#prefix'] = '<div id="hosting-task-confirm-form-actions" class="container-inline">';
  $form['actions']['#suffix'] = '</div>';

  return $form;
}

/**
 * Customize the task confirmation form for restore.
 *
 * This adds the backup listing to the confirmation dialog.
 */
function hosting_task_restore_form($node) {
  $list = hosting_site_backup_list(hosting_entity_id($node));
  if (count($list)) {
    $form['bid'] = array(
      '#type' => 'radios',
      '#title' => t('Backups'),
      '#options' => $list,
      '#required' => TRUE,
    );
  }
  else {
    $form['no_backups'] = array(
      '#type' => 'item',
      '#title' => t('Backups'),
      '#markup' => t('There are no valid backups available.'),
    );
  }
  return $form;
}

/**
 * Implements hook_form_alter().
 *
 * TODO: Move restore functions to hosting_site, where backup functions are.
 */
function hosting_task_restore_form_validate($form, \Drupal\Core\Form\FormStateInterface $form_state) {
  if (isset($form['parameters']['no_backups'])) {
    $form_state->setErrorByName('no_backups', t('There are no valid backups available.'));
  }
}

/**
 * Generic form submit handler for tasks confirmation.
 *
 * This handler gets called after any task has been confirmed by the user. It
 * will inject a new task in the queue and redirect the user to the
 * originating node.
 *
 * @see hosting_add_task()
 */
function hosting_task_confirm_form_submit($form, &$form_state) {
  $values = $form_state['values'];
  $parameters = isset($values['parameters']) ? $values['parameters'] : array();
  $entity_id = $values['entity_id'] ?? NULL;
  hosting_add_task($entity_id, $values['task'], $parameters, HOSTING_TASK_QUEUED, $values['entity_type'] ?? NULL);
  $redirect_path = '<front>';
  $entity = NULL;
  if (!empty($values['entity_type']) && $entity_id) {
    $entity = \Drupal::entityTypeManager()->getStorage($values['entity_type'])->load($entity_id);
  }
  elseif ($entity_id) {
    $entity = hosting_entity_load_any($entity_id);
  }
  if (!empty($entity)) {
    $redirect_path = ltrim($entity->toUrl('canonical')->toString(), '/');
  }
  $form_state['redirect'] = $redirect_path;

  if (\Drupal::moduleHandler()->moduleExists('overlay')) {
    overlay_close_dialog();
  }
}

/**
 * Set the title of tasks automatically and in a consistent way.
 *
 * Tasks should always be named 'task_type node_title'.
 */
function hosting_task_set_title(&$task) {
  if (!$task instanceof \Drupal\Core\Entity\EntityInterface || $task->getEntityTypeId() !== 'hosting_task') {
    return;
  }
  $ref = hosting_entity_load_from_context_id($task->get('rid')->value);
  if (!$ref) {
    return;
  }
  $ref_type = hosting_entity_task_scope($ref);
  $tasks = hosting_available_tasks($ref_type);

  $ref_title = hosting_entity_label($ref);
  $task_type = $task->get('task_type')->value;
  if (isset($tasks[$task_type]['title'])) {
    $task->set('label', \Drupal\Component\Utility\Unicode::ucfirst($tasks[$task_type]['title']) . ': ' . $ref_title);
    $task->save();
  }
}

/**
 * Process the hosting task queue.
 *
 * Iterates through the list of outstanding tasks, and execute the commands on the back end.
 */
function hosting_tasks_queue($count = 20) {
  global $provision_errors;

  $tasks = hosting_get_new_tasks($count);

  if (count($tasks)) {
    hosting_log(t('Found @count tasks (max @max) in queue. Running...', [
      '@count' => count($tasks),
      '@max' => $count,
    ]), 'notice');
  }
  else {
    hosting_log(t('Found no tasks in queue. Not running.'), 'notice');
  }

  foreach ($tasks as $task) {
    hosting_task_execute($task, array('fork' => hosting_get_cli_option('fork', TRUE)));
  }
}

/**
 * Executes a task while logging to watchdog and CLI.
 * Implemented by hosting-tasks and hosting-queued commands.
 *
 * @param $task
 *   A fully loaded task node.
 *
 * @param $backend_options
 *   @see hosting_run_drush_command().
 */
function hosting_task_execute($task, $backend_options = array()) {
  $task_id = hosting_task_entity_id($task);
  $task_label = $task instanceof \Drupal\Core\Entity\EntityInterface ? $task->label() : (hosting_entity_label($task) ?? '');
  $date_formatter = \Drupal::service('date.formatter');
  // Log in watchdog and drush.
  \Drupal::logger('hosting_task')->notice('Starting task "@title" [task/@id].', ['@title' => $task_label, '@id' => $task_id]);
  hosting_log(t('Starting task "@title" [task/@id].', [
    '@title' => $task_label,
    '@id' => $task_id,
  ]), 'ok', [], 'hosting_task');

  // Execute in it's own process.
  hosting_run_drush_command('@self', 'hosting-task', array($task_id), array('strict' => FALSE), $backend_options);

  // Log a message, depending on forked process or not.
  // If forked, the process may not have completed yet, so we should change the message.
  if (isset($backend_options['fork']) && $backend_options['fork']) {
    hosting_log(t('Launched task "@title" in a forked process. [task/@id]', [
      '@title' => $task_label,
      '@id' => $task_id,
    ]), 'ok', [], 'hosting_task');
  }
  // If not forked, load and display the task status.
  else {
    $task = hosting_task_load_entity($task_id);
    hosting_log(t('Finished task "@title" with status "@status" in @duration [task/@id].', [
      '@title' => $task ? $task->label() : $task_label,
      '@id' => $task_id,
      '@status' => $task ? _hosting_parse_error_code($task->get('task_status')->value) : '',
      '@duration' => $task ? $date_formatter->formatInterval($task->get('delta')->value, 1) : '',
    ]), 'ok', [], 'hosting_task');
  }
}

/**
 * Determine whether there is an outstanding task of a specific type.
 *
 * This is used to ensure that there are not multiple tasks of the same type queued.
 */
function hosting_task_outstanding($entity_id, $type) {
  $return = \Drupal::database()->query("
      SELECT t.id FROM {hosting_task} t
      WHERE
        t.rid = :rid
        AND (t.task_status = :status_queued OR t.task_status = :status_processing)
        AND t.task_type = :type
        ORDER BY t.id DESC
        LIMIT 1",
        array(
          ':rid' => $entity_id,
          ':status_queued' => HOSTING_TASK_QUEUED,
          ':status_processing' => HOSTING_TASK_PROCESSING,
          ':type' => $type
        ))->fetchField();
  return $return;
}

/**
 * Return the amount of items still in the queue.
 */
function hosting_task_count() {
  $result = \Drupal::database()->query("SELECT COUNT(t.id) FROM {hosting_task} t WHERE t.task_status = :task_status", array(':task_status' => HOSTING_TASK_QUEUED))->fetchField();
  return $result;
}

/**
 * Return the amount of items running in the queue.
 */
function hosting_task_count_running() {
  return \Drupal::database()->query("SELECT COUNT(t.id) FROM {hosting_task} t WHERE t.task_status = :task_status AND t.executed > (UNIX_TIMESTAMP() - :timeout)",
    array(
      ':task_status' => HOSTING_TASK_PROCESSING,
      ':timeout' => 28800,
    )
  )->fetchField();
}

/**
 * Get a list of tasks that can be invoked by the user.
 *
 * Note this does not check permissions or relevance of the tasks.
 *
 * Modules can extend this list using hook_hosting_tasks().
 *
 * @param string|null $type
 *   Tasks are grouped by the type of thing that the task is performed on. This
 *   parameter should either be NULL, or a string indicating the type of thing
 *   that you want possible tasks to operate on.
 * @param bool $reset
 *   This function has an internal static cache, to reset the cache, pass in
 *   TRUE.
 *
 * @return array
 *   Depending on the value of the $type parameter, you will either be returned:
 *   - If $type is NULL: an associative array whose keys are things that can be
 *     acted upon by the tasks defined in the corresponding values.
 *   - If $type is a string, then an associative array whose keys are task types
 *     and whose values are definitions for those tasks.
 *
 * @see hook_hosting_tasks()
 * @see hook_hosting_tasks_alter()
 * @see hosting_task_menu_access()
 */
function hosting_available_tasks($type = NULL, $reset = FALSE) {
  static $cache = array();

  if (!count($cache) || $reset) {
    // Invoke hook_hosting_tasks().
    $cache = \Drupal::moduleHandler()->invokeAll('hosting_tasks');

    // Invoke hook_hosting_tasks_alter().
    \Drupal::moduleHandler()->alter('hosting_tasks', $cache);
  }
  if (isset($type)) {
    return $cache[$type];
  }
  else {
    return $cache;
  }
}

/**
 * Implements hook_hosting_tasks_alter()
 *
 * Set 'command' property for tasks that don't implement it.
 */
function hosting_task_hosting_tasks_alter(&$cache) {

  // For any task type that doesn't use "command", add it as 'provision-$TYPE'.
  foreach ($cache as &$tasks) {
    foreach ($tasks as $type => &$task_type) {
      if (!isset($task_type['command']) || empty($task_type['command'])) {
        $task_type['command'] = 'provision-' . $type;
      }
    }
  }
}

/**
 * Implements hook_action_info().
 */
function hosting_task_action_info() {
  $available_tasks = hosting_available_tasks();
  $actions = array();
  foreach ($available_tasks as $module => $tasks) {
    foreach ($tasks as $task => $task_info) {
      // Search for dashes an replace accordingly.
      $task = str_replace('-', '_', $task);
      $function = 'hosting_' . $module . '_' . $task . '_action';
      if (function_exists($function)) {
        $label = ucwords($module . ': ' . $task);
        $actions[$function] = array(
          'type' => 'node',
          'label' => t($label),
          'configurable' => FALSE,
          'behavior' => array('none'),
        );
      }
    }
  }
  return $actions;
}

/**
 * Implements hook_insert().
 */
function hosting_task_insert($task) {
  if (!$task instanceof \Drupal\Core\Entity\EntityInterface || $task->getEntityTypeId() !== 'hosting_task') {
    return;
  }
  if (isset($task->task_args) && is_array($task->task_args)) {
    hosting_task_save_arguments($task->id(), $task->task_args);
  }
  \Drupal::moduleHandler()->invokeAll('hosting_task_update_status', [$task, (int) $task->get('task_status')->value]);
}

/**
 * Implements hook_update().
 *
 * As an existing node is being updated in the database, we need to do our own
 * database updates.
 */
function hosting_task_update($task) {
  if (!$task instanceof \Drupal\Core\Entity\EntityInterface || $task->getEntityTypeId() !== 'hosting_task') {
    return;
  }
  if (isset($task->task_args) && is_array($task->task_args)) {
    hosting_task_save_arguments($task->id(), $task->task_args);
  }
  \Drupal::moduleHandler()->invokeAll('hosting_task_update_status', [$task, (int) $task->get('task_status')->value]);
}

/**
 * Implements hook_delete().
 */
function hosting_task_delete($task) {
  if (!$task instanceof \Drupal\Core\Entity\EntityInterface || $task->getEntityTypeId() !== 'hosting_task') {
    return;
  }
  \Drupal::database()->delete('hosting_task_arguments')
    ->condition('task_id', $task->id())
    ->execute();
  \Drupal::database()->delete('hosting_task_log')
    ->condition('task_id', $task->id())
    ->execute();
}

/**
 * Delete tasks related to a given site, platform, server, etc.
 */
function hosting_task_delete_related_tasks($entity_id) {
  $task_ids = \Drupal::entityQuery('hosting_task')
    ->condition('rid', $entity_id)
    ->accessCheck(FALSE)
    ->execute();
  if (!$task_ids) {
    return;
  }
  $storage = \Drupal::entityTypeManager()->getStorage('hosting_task');
  $tasks = $storage->loadMultiple($task_ids);
  $storage->delete($tasks);
  \Drupal::database()->delete('hosting_task_arguments')
    ->condition('task_id', array_values($task_ids), 'IN')
    ->execute();
  \Drupal::database()->delete('hosting_task_log')
    ->condition('task_id', array_values($task_ids), 'IN')
    ->execute();
}

/**
 * Implements hook_load().
 */
function hosting_task_load($nodes) {
  $types = \Drupal::moduleHandler()->invokeAll('hosting_tasks');
  \Drupal::moduleHandler()->alter('hosting_tasks', $types);

  foreach ($nodes as $id => &$task) {
    if ($task instanceof \Drupal\Core\Entity\EntityInterface && $task->getEntityTypeId() === 'hosting_task') {
      $task = hosting_task_load_arguments($task);
      $context_name = \Drupal::database()->query("SELECT name FROM {hosting_context} WHERE entity_id = :entity_id", array(':entity_id' => $task->get('rid')->value))->fetchField();
      if ($context_name) {
        $entity_type_id = hosting_entity_type_from_context_name($context_name);
        $task->ref_type = $entity_type_id ? hosting_entity_type_to_task_scope($entity_type_id) : NULL;
      }
      if (!empty($task->ref_type) && isset($types[$task->ref_type][$task->get('task_type')->value]['command'])) {
        $task->task_command = $types[$task->ref_type][$task->get('task_type')->value]['command'];
      }
    }
  }
}

/**
 * Adds a retry button to failed task nodes.
 */
function hosting_task_retry_form($form, $form_state, $task_id) {
  $form['#prefix'] = '<div class="hosting-task-retry">';
  $form['task'] = array(
    '#type' => 'hidden',
    '#default_value' => $task_id,
  );
  $form['retry'] = array(
    '#type' => 'submit',
    '#value' => t('Retry'),
  );
  $form['#suffix'] = '</div>';
  return $form;
}

/**
 * Submit handler for the task retry button.
 */
function hosting_task_retry_form_submit($form, &$form_state) {
  hosting_task_retry($form_state['values']['task']);
  if (\Drupal::moduleHandler()->moduleExists('overlay')) {
    overlay_close_dialog();
  }
}

/**
 * Adds button to update the status of task nodes stuck in the 'processing' state.
 */
function hosting_task_update_status_form($form, &$form_state, $task_id) {
  $form['#prefix'] = '<div class="hosting-task-retry">';
  $form['task'] = array(
    '#type' => 'hidden',
    '#default_value' => $task_id,
  );
  $form['update-status'] = array(
    '#type' => 'submit',
    '#value' => t('Update status'),
  );
  $form['#suffix'] = '</div>';
  return $form;
}

/**
 * Submit handler for the 'update status' button.
 */
function hosting_task_update_status_form_submit($form, &$form_state) {
  hosting_task_update_status($form_state['values']['task']);
  if (\Drupal::moduleHandler()->moduleExists('overlay')) {
    overlay_close_dialog();
  }
  if (\Drupal::moduleHandler()->moduleExists('hosting_queued')) {
    // Release the hosting_queued lock.
    // Cannot use lock release because it uses semaphore value, which only works in a single request.
    global $locks;
    unset($locks['hosting_queue_tasks_running']);
    \Drupal::database()->delete('semaphore')
      ->condition('name', 'hosting_queue_tasks_running')
      ->execute();
  }

}

/**
 * Implements hook_view().
 */
function hosting_task_view($task, $view_mode, $langcode = NULL) {
  return hosting_task_build_view($task);
}

/**
 * Build a render array for a hosting task entity.
 */
function hosting_task_build_view($task) {
  if (!$task instanceof \Drupal\Core\Entity\EntityInterface || $task->getEntityTypeId() !== 'hosting_task') {
    return array();
  }

  $date_formatter = \Drupal::service('date.formatter');
  $task = hosting_task_load_arguments($task);
  $task_status = (int) $task->get('task_status')->value;
  $build = array(
    '#attached' => array(
      'library' => array(
        'hosting/admin',
      ),
    ),
  );

  $ref = hosting_entity_load_from_context_id($task->get('rid')->value);
  $ref_label = $ref ? hosting_entity_task_scope($ref) : t('Reference');

  $build['info'] = array(
    '#type' => 'container',
    '#attributes' => array(
      'id' => 'hosting-task-info',
      'class' => array('clear-block'),
    ),
  );
  if ($ref) {
    $build['info']['reference'] = array(
      '#type' => 'item',
      '#title' => \Drupal\Component\Utility\Unicode::ucfirst($ref_label),
      '#markup' => _hosting_node_link($ref),
    );
  }

  if ($task_status != HOSTING_TASK_QUEUED) {
    if ($task_status == HOSTING_TASK_PROCESSING) {
      $build['info']['started'] = array(
        '#type' => 'item',
        '#title' => t('Started'),
        '#markup' => $date_formatter->format($task->get('executed')->value, 'medium'),
        '#weight' => 1,
      );
      $build['info']['delta'] = array(
        '#type' => 'item',
        '#title' => t('Processing time'),
        '#markup' => $date_formatter->formatInterval(REQUEST_TIME - $task->get('executed')->value),
        '#weight' => 2,
      );
    }
    elseif ($task->get('executed')->value) {
      $build['info']['executed'] = array(
        '#type' => 'item',
        '#title' => t('Executed'),
        '#markup' => $date_formatter->format($task->get('executed')->value, 'medium'),
        '#weight' => 1,
      );
      $build['info']['delta'] = array(
        '#type' => 'item',
        '#title' => t('Execution time'),
        '#markup' => $date_formatter->formatInterval($task->get('delta')->value),
        '#weight' => 2,
      );
    }
  }
  else {
    $queues = hosting_get_queues();
    $queue = $queues['tasks'];
    $next = _hosting_queue_next_run($queue);
    $build['info']['notexecuted'] = array(
      '#type' => 'item',
      '#title' => t('This task has not been processed yet'),
      '#markup' => t('It will be processed around %date, if the queue is not too crowded. The queue is currently run every %freq, was last run %last and processes %items items at a time. Server time is %time.', array('%freq' => $date_formatter->formatInterval($queue['frequency']), '%date' => $date_formatter->format($next, 'custom', 'H:i:sO'), '%last' => hosting_format_interval($queue['last_run']), '%items' => $queue['items'], '%time' => $date_formatter->format(REQUEST_TIME, 'custom', 'H:i:sO'))),
    );
  }

  if ($task_status) {
    $build['info']['status'] = array(
      '#type' => 'item',
      '#title' => t('Status'),
      '#markup' => _hosting_parse_error_code($task_status),
    );
  }

  if (\Drupal::currentUser()->hasPermission('retry failed tasks') && (
      $task_status == HOSTING_TASK_ERROR ||
      $task_status == HOSTING_TASK_WARNING ||
      $task_status == HOSTING_TASK_SUCCESS
    )) {
    $build['retry'] = array(
      'form' => \Drupal::formBuilder()->getForm('hosting_task_retry_form', $task->id()),
      '#weight' => 5,
    );

    if ($task_status == HOSTING_TASK_WARNING || $task_status == HOSTING_TASK_SUCCESS) {
      $build['retry']['form']['retry']['#value'] = t('Run Again');
    }
  }

  if (\Drupal::currentUser()->hasPermission('update status of tasks') && ($task_status == HOSTING_TASK_PROCESSING)) {
    $build['update-status'] = array(
      'form' => \Drupal::formBuilder()->getForm('hosting_task_update_status_form', $task->id()),
      '#weight' => 5,
    );
  }

  if (\Drupal::currentUser()->hasPermission('access task logs')) {
    if (in_array($task_status, array(HOSTING_TASK_ERROR, HOSTING_TASK_WARNING))) {
      $url_options = array(
        'attributes' => array(
          'class' => array(
            'hosting-button-enabled',
          ),
          'target' => '_self',
        ),
        'fragment' => 'warning',
      );
      if (\Drupal::moduleHandler()->moduleExists('overlay') && overlay_get_mode() == 'child') {
        $url_options['query'] = array('render' => 'overlay');
      }
      $build['jump-link-warning'] = array(
        '#markup' => '<div>' . \Drupal\Core\Link::fromTextAndUrl(t('Jump to first warning'), \Drupal\Core\Url::fromUserInput(\Drupal::service('path.current')->getPath(), $url_options))->toString() . '</div>',
        '#weight' => 8,
      );
    }
    if ($task_status == HOSTING_TASK_ERROR) {
      $url_options['fragment'] = 'error';
      $build['jump-link-error'] = array(
        '#markup' => '<div>' . \Drupal\Core\Link::fromTextAndUrl(t('Jump to first error'), \Drupal\Core\Url::fromUserInput(\Drupal::service('path.current')->getPath(), $url_options))->toString() . '</div>',
        '#weight' => 9,
      );
    }
    if ($table = _hosting_task_log_table($task)) {
      $build['hosting_log'] = array(
        '#weight' => 10,
        'table' => $table,
      );
    }
  }

  return $build;
}

/**
 * Display table containing the logged information for this task.
 */
function _hosting_task_log_table($task, $last_position = 0) {

  $types = \Drupal::config('hosting.settings')->get('hosting_task_logs_types_display') ?? hosting_log_types();
  $task_id = hosting_task_entity_id($task);
  $query_args = array(':task_id' => $task_id, ':lid' => $last_position, ':types' => $types);

  $result = \Drupal::database()->query("SELECT * FROM {hosting_task_log} WHERE task_id = :task_id AND lid > :lid AND type IN (:types) ORDER BY lid", $query_args);
  if ($result) {
    $headers = array('data' => 'Log message', 'execution_time' => 'Execution time', '');
    $rows = array();
    $last_lid = $last_position;
    $last_timestamp = 0;
    $exec_time = '';
    $row_count = -1;
    foreach ($result as $entry) {
      if (strlen($entry->message) > 300) {
        $summary = "<span class='hosting-task-summary'>" . \Drupal\Component\Utility\Xss::filter(substr($entry->message, 0, 75), []) . "... <a href='javascript:void(0)' class='hosting-summary-expand modalframe-exclude'>(" . t('Expand') . ')</a></span>';
        $message = $summary . "<span class='hosting-task-full'>" . \Drupal\Component\Utility\Xss::filter($entry->message) . '</span>';
      }
      else {
        $message = \Drupal\Component\Utility\Xss::filter($entry->message);
      }

      // Add error and warning anchors, so we can provide a quick link to them.
      if ($entry->type == 'error') {
        $message = '<a name="error"></a>' . $message;
      }
      elseif ($entry->type == 'warning') {
        $message = '<a name="warning"></a>' . $message;
      }

      // Add the exec_time to the previous row
      $exec_time = $entry->timestamp - $last_timestamp;

      // "1" is unreliable because timestamps don't allow sub-second granularity.
      if ($exec_time < 1) {
        $exec_time = '<div>-</div>';
      }
      elseif ($exec_time == 1) {
        $exec_time = '<div title="Many tasks take less than 1 second to perform. This duration represents an aggregate of the preceding tasks\' duration."><strong>' . $exec_time . ' s.</strong></div>';
      }
      else {
        $exec_time = '<div><strong>' . $exec_time . ' s.</strong></div>';
      }

      if ($row_count > -1) {
        $rows[$row_count]['data'][1] = array(
          'data' => $exec_time,
        );
      }

      $row_count++;
      $last_timestamp = $entry->timestamp;

      $row = array(
        array(
          'data' => $message,
          'class' => array('hosting-status'),
        ),
        '',
        $entry->type,
      );

      $rows[] = array(
        'data' => $row,
        'class' => array(_hosting_task_log_class($entry->type)),
      );

      // Record that we've seen this log row.
      $last_lid = $entry->lid;
    }


    $table = array(
      '#theme' => "table",
      '#header' => $headers,
      '#rows' => $rows,
      '#attributes' => array(
        'id' => 'hosting-task-log',
        'class' => array(
          'hosting-table',
        ),
      ),
    );
    // If the task has not finished executing, update via AJAX.
    if (!hosting_task_task_has_finished($task)) {
      $table += array(
        '#refresh_url' => \Drupal\Core\Url::fromUserInput('/hosting/task/log/ajax/' . $task_id . '/' . $last_lid)->toString(),
        '#attached' => array(
          'drupalSettings' => array(
            'hosting_task' => array(
              'refresh_url' => \Drupal\Core\Url::fromUserInput('/hosting/task/log/ajax/' . $task_id . '/' . $last_lid)->toString(),
            ),
          ),
          'library' => array(
            'hosting_task/table',
            'core/drupal.ajax',
          ),
        ),
      );
    }
    return $table;
  }

  return FALSE;
}

/**
 * Map entry statuses to coincide with our CSS classes.
 *
 * @todo make this irrelevant.
 * @see _drush_print_log()
 */
function _hosting_task_log_class($type) {
  switch (strtolower($type)) {
    case 'warning':
    case 'cancel':
    case 'rollback':   // aegir-specific
      $type = 'warning';
      break;
    case 'failed':
    case 'error':
      $type = 'error';
      break;
    case 'queue':   // aegir-specific
      $type = 'queue';
      break;
    case 'ok':
    case 'completed':
    case 'success':
      $type = 'success';
      break;
    case 'notice':
    case 'info':
    case 'message':
    default:
      $type = 'info';
  }

  return 'hosting-' . $type;
}

/**
 * Retrieve the latest task related to the specified platform, of a specific type.
 *
 * This is used for documenting issues with verification.
 */
function hosting_get_most_recent_task($rid, $type) {
  $task_id = \Drupal::database()->query("SELECT t.id FROM {hosting_task} t WHERE task_type = :task_type and t.rid = :t_rid ORDER BY t.id DESC limit 1", array(':task_type' => $type, ':t_rid' => $rid))->fetchField();
  if ($task_id) {
    return hosting_task_load_entity($task_id);
  }
  return FALSE;
}

/**
 * Retrieve tasks with specified criteria.
 *
 * @arg $filter_by string a field to filter the list with, unchecked
 * @arg $filter_value string what to restrict the field to, checked
 * @arg $count integer the number of tasks to return
 * @arg $element integer which element to start from
 */
function hosting_get_tasks($filter_by = NULL, $filter_value = NULL, $count = 5, $element = 0) {
  $query = \Drupal::entityQuery('hosting_task')
    ->accessCheck(FALSE)
    ->sort('id', 'DESC')
    ->range($element, $count);
  if (isset($filter_by) && isset($filter_value)) {
    $query->condition($filter_by, $filter_value);
  }
  $task_ids = $query->execute();
  if (!$task_ids) {
    return array();
  }
  return \Drupal::entityTypeManager()->getStorage('hosting_task')->loadMultiple($task_ids);
}

/**
 * Retrieve a list of outstanding, queued, tasks.
 *
 * @param int $limit
 *   The maximum number of tasks to return.
 * @param null $rid
 *   The NID of the referenced Node to filter by.
 * @param null $task_type
 *   The task type to filter by.
 *
 * @return array
 *   An associative array containing task nodes, indexed by node id.
 */
function hosting_get_new_tasks($limit = 20, $rid = NULL, $task_type = NULL) {
  $query = \Drupal::database()->select('hosting_task', 't');
  $query
    ->fields('t', array('id'))
    ->condition('t.task_status', HOSTING_TASK_QUEUED)
    ->orderBy('t.changed')
    ->orderBy('t.id')
    ->groupBy('t.rid')
    ->range(0, $limit)
    ->addTag('hosting_get_new_tasks');

  if ($rid) {
    $query->condition('t.rid', $rid);
  }

  if ($task_type) {
    $query->condition('t.task_type', $task_type);
  }

  $task_ids = $query->execute()->fetchCol();
  if (!$task_ids) {
    return array();
  }
  return \Drupal::entityTypeManager()->getStorage('hosting_task')->loadMultiple($task_ids);
}

/**
 * Retrieve a list of outstanding, queued, tasks.
 *
 * @deprecated First deprecated in Hosting 3.9 because this function was made
 * part of the public API, use hosting_get_new_tasks() instead.
 *
 * @see hosting_get_new_tasks
 */
function _hosting_get_new_tasks($limit = 20) {
  return hosting_get_new_tasks($limit);
}

/**
 * @name Error status definitions
 * @{
 * Bitmask values used to generate the error code to return.
 * @see hosting_task_set_error(), hosting_task_get_last_error(), hosting_task_has_error()
 */

/**
 * The task is being processed
 */
define('HOSTING_TASK_PROCESSING', -1);

/**
 * The task is queued
 */
define('HOSTING_TASK_QUEUED', 0);

/**
 * The command completed succesfully.
 */
define('HOSTING_TASK_SUCCESS', 1);

/**
 * The command was not successfully completed. This is the default error
 * status.
 */
define('HOSTING_TASK_ERROR', 2);

/**
 * The command was completed successfully, but with warnings. This is requires
 * attention.
 */
define('HOSTING_TASK_WARNING', 3);

/**
 * @} End of "name Error status definitions".
 */

/**
 * Turn bitmask integer error code into associative array.
 */
function _hosting_task_error_codes() {
  $codes = array(
    HOSTING_TASK_SUCCESS => t('Successful'),
    HOSTING_TASK_QUEUED => t('Queued'),
    HOSTING_TASK_ERROR => t('Failed'),
    HOSTING_TASK_PROCESSING => t('Processing'),
    HOSTING_TASK_WARNING => t('Warning'),
  );
  return $codes;
}

/**
 * Turn bitmask integer error code into translatable label.
 */
function _hosting_parse_error_code($code) {
  $messages = _hosting_task_error_codes();
  return $messages[$code];
}

/**
 * Return the status of the task matching the specification.
 */
function hosting_task_status($filter_by, $filter_value, $type = 'install') {
  $query = \Drupal::database()->select('hosting_task', 't')
    ->fields('t', array('task_status'))
    ->condition('t.task_type', $type);
  if ($filter_by && $filter_value) {
    $query->condition('t.' . $filter_by, $filter_value);
  }
  $query->orderBy('t.id', 'DESC');

  return $query->execute()->fetchField();
}

/**
 * Return the status of a task in human-readable form.
 *
 * @see hosting_task_status()
 */
function hosting_task_status_output($filter_by, $filter_value, $type = 'install') {
  $status = hosting_task_status($filter_by, $filter_value, $type);
  if (is_int($status)) {
    return _hosting_parse_error_code($status);
  }
  else {
    // should be NULL.
    return $status;
  }
}

/**
 * Display list of tasks.
 */
function hosting_task_list($filter_by = NULL, $filter_value = NULL) {
  return _hosting_task_list($filter_by, $filter_value, 25, 12, 'title');
}

/**
 * A concise table listing of the tasks affecting this node.
 *
 * This shows a table view of the tasks relevant to this node. It will show
 * tasks that can be executed as well as tasks that have been in a single
 * simple interface.
 */
function hosting_task_table($node) {
  $build = array();

  $headers[] = t('Task');
  $headers[] = array(
    'data' => t('Actions'),
    'class' => array('hosting-actions'),
  );

  $entity_id = hosting_entity_id($node);
  $entity_type_id = hosting_entity_type_id($node);
  $task_scope = hosting_entity_task_scope($node);
  $tasklist = hosting_task_fetch_tasks($entity_id);
  $rows = array();

  foreach ($tasklist as $task => $info) {
    $row = array();

    if (!isset($info['id']) && !$info['task_permitted']) {
      // Just don't show those tasks, since we'll not be able to run them.
      continue;
    }

    if (empty($info['title'])) {
      // Skip tasks from types that have since been removed.
      continue;
    }

    $row['type'] = array(
      'data' => $info['title'],
      'class' => array('hosting-status'),
    );
    $actions = array();

    if (isset($info['task_status']) && ($info['task_status'] == 0)) {
      $actions['cancel'] = _hosting_task_button(t('Cancel'), sprintf("hosting/tasks/%d/cancel", $info['id']), t("Cancel the task and remove it from the queue"), 'hosting-button-stop', !$info['task_permitted']);
    }
    else {
      $actions['run'] = _hosting_task_button(t('Run'), sprintf("hosting_confirm/%s/%d/%s_%s", $entity_type_id, $entity_id, $task_scope, $task), $info['description'], 'hosting-button-run', $info['task_permitted'], $info['dialog']);
    }

    $actions['log'] = _hosting_task_button(t('View'), isset($info['id']) ? 'hosting/task/' . $info['id'] : '<front>', t("Display the task log"), 'hosting-button-log', isset($info['id']) &&  \Drupal::currentUser()->hasPermission('access task logs'), TRUE, FALSE);
    $row['actions'] = array(
      'data' => \Drupal\Core\Render\Markup::create(implode('', $actions)),
      'class' => array('hosting-actions'),
    );

    $rows[] = array(
      'data' => $row,
      'class' => array($info['class']),
    );
  }
  $build['table'] = array(
    '#type' => 'table',
    '#header' => $headers,
    '#rows' => $rows,
    '#attributes' => array(
      'class' => array('hosting-table'),
    ),
  );

  if ($entity_type_id && $entity_id) {
    $build['#attached']['drupalSettings']['hostingTaskRefresh'] = array(
      'entityType' => $entity_type_id,
      'entityId' => $entity_id,
      'changed' => hosting_task_entity_changed($node),
    );
  }
  return $build;
}

/**
 * Utility function to create HTML for a task button.
 */
function _hosting_task_button($title, $link, $description, $class = '', $status = TRUE, $dialog = FALSE, $add_token = TRUE) {
  $account_id = \Drupal::currentUser()->id();

  if ($status) {
    $classes[] = 'hosting-button-enabled';
    if (!empty($class)) {
      $classes[] = $class;
    }
    if ($dialog) {
      $classes[] = 'hosting-button-dialog';
    }

    $options['attributes'] = array(
      'title' => $description,
      'class' => $classes,
    );
    if ($add_token) {
      $options['query'] = array(
        'token' => \Drupal::service('csrf_token')->get((string) $account_id),
      );
    }
    if ($link === '<front>' || $link === '') {
      $url = \Drupal\Core\Url::fromRoute('<front>', $options);
    }
    elseif (preg_match('/^https?:/i', $link)) {
      $url = \Drupal\Core\Url::fromUri($link, $options);
    }
    else {
      $url = \Drupal\Core\Url::fromUserInput('/' . ltrim($link, '/'), $options);
    }
    return \Drupal\Core\Link::fromTextAndUrl($title, $url)->toString();
  }
  else {
    return "<span class='hosting-button-disabled'>" . $title . "</span>";
  }
}

/**
 * Theme a task list
 */
function _hosting_task_list($filter_by, $filter_value, $count = 5, $element = 0, $field = 'title', $skip = array(), $pager = TRUE) {
  $nodes = hosting_get_tasks($filter_by, $filter_value, $count, $element);
  $date_formatter = \Drupal::service('date.formatter');

  if (!$nodes) {
    return t('No tasks available');
  }
  else {
    $headers[t('Task')] = '';
    foreach ($nodes as $node) {
      $row = array();

      if ($field == 'title') {
        $ref = hosting_entity_load_from_context_id($node->get('rid')->value);
        $data = \Drupal\Component\Utility\Unicode::ucfirst($node->get('task_type')->value) . ' ' . _hosting_node_link($ref);
      }
      else {
        $data = $node->get($field)->value;
      }
      $row['type'] = array(
        'data' => $data,
        'class' => array('hosting-status'),
      );

      if (!in_array('created', $skip)) {
        $row['created'] = t("@interval ago", array('@interval' => $date_formatter->formatInterval(REQUEST_TIME - $node->get('created')->value, 1)));
        $headers[t('Created')] = '';
      }

      if ((int) $node->get('task_status')->value == 0) {
        $row['executed'] = '';
      }
      else {
        $row['executed'] = t("@interval ago", array('@interval' => $date_formatter->formatInterval(REQUEST_TIME - $node->get('changed')->value, 1)));
      }
      $headers[t('Executed')] = '';

      $headers[t('Actions')] = '';

      $actions['log'] = \Drupal\Core\Link::fromTextAndUrl(t('View'), \Drupal\Core\Url::fromUserInput('/hosting/task/' . $node->id(), array('attributes' => array('class' => array('hosting-button-dialog', 'hosting-button-enabled', 'hosting-button-log')))))->toString();

      $row['actions'] = array(
        'data' => $actions['log'],
        'class' => array('hosting-actions'),
      );

      $class = hosting_task_status_class((int) $node->get('task_status')->value);

      $rows[] = array(
        'data' => $row,
        'class' => array($class),
      );
    }

    $output = \Drupal::service('theme.manager')->render('table', array('header' => array_keys($headers), 'rows' => $rows, 'attributes' => array('class' => array('hosting-table'))));
    if ($pager === TRUE) {
      $output .= \Drupal::service('theme.manager')->render('pager', array('tags' => NULL, 'element' => $element));
    }
    elseif (is_string($pager)) {
      $output .= $pager;
    }
    return $output;
  }
}

/**
 * @todo Please document this function.
 * @see http://drupal.org/node/1354
 */
function hosting_task_fetch_tasks($rid) {
  $entity = hosting_entity_load_from_context_id($rid);
  $task_scope = hosting_entity_task_scope($entity);

  $result = \Drupal::database()->query("SELECT t.id, t.task_type, t.task_status FROM {hosting_task} t
    WHERE t.rid = :trid
    ORDER BY t.changed ASC", array(':trid' => $rid));

  foreach ($result as $obj) {
    $return[$obj->task_type] = array(
      'id' => $obj->id,
      'task_status' => $obj->task_status,
      'exists' => TRUE,
    );
  }

  $tasks = $task_scope ? hosting_available_tasks($task_scope) : array();
  ksort($tasks);

  foreach ($tasks as $type => $hook_task) {

    if (!isset($return[$type])) {
      $return[$type] = array();
    }

    $access_callback = !empty($hook_task['access callback']) ? $hook_task['access callback'] : 'hosting_task_menu_access';

    $task = array();
    $task = array_merge($return[$type], $hook_task);

    $allowed = (isset($task['exists']) && !in_array($task['task_status'], array(HOSTING_TASK_QUEUED, HOSTING_TASK_PROCESSING))) || !isset($task['exists']);
    if ($allowed && empty($task['hidden']) && $entity && $access_callback($entity, $type)) {
      $task['task_permitted'] = TRUE;
    }
    else {
      $task['task_permitted'] = FALSE;
    }
    // @TODO: Use task defaults array to prevent notices.
    if (!isset($task['dialog'])) {
      $task['dialog'] = FALSE;
    }
    if (!isset($task['task_status'])) {
      $task['task_status'] = NULL;
    }
    $task['class'] = hosting_task_status_class($task['task_status']);

    $return[$type] = $task;
  }

  return $return;
}

/**
 * Return a machine name for each state.
 */
function hosting_task_status_name($hosting_task_status = NULL) {
  $codes = array(
    HOSTING_TASK_SUCCESS    => 'success',
    HOSTING_TASK_QUEUED     => 'queued',
    HOSTING_TASK_ERROR      => 'error',
    HOSTING_TASK_PROCESSING => 'processing',
    HOSTING_TASK_WARNING    => 'warning',
  );
  if (!is_null($hosting_task_status) && isset($codes[$hosting_task_status])) {
    return $codes[$hosting_task_status];
  }
  elseif (!is_null($hosting_task_status) && !isset($codes[$hosting_task_status])) {
    return '';
  }
  else {
    return $codes;
  }
}

/**
 * Return a css class from a hosting task status integer value.
 */
function hosting_task_status_class($status = NULL) {
  if (!is_null($status) && $name = hosting_task_status_name($status)) {
    return 'hosting-' . $name;
  }
  else {
    return '';
  }
}

