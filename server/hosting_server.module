<?php

/**
 * @file
 * Hook implementations for the Hosting server module.
 */

include_once "hosting_server.service.inc";
include_once "hosting.ip.inc";

/**
 * This server has been deleted.
 */
define('HOSTING_SERVER_DELETED', -2);

/**
 * This server has been locked. Its services will not be available for use.
 */
define('HOSTING_SERVER_LOCKED', -1);

/**
 * This platform has been queued for registration (and eventually creation).
 */
define('HOSTING_SERVER_QUEUED', 0);

/**
 * This server is created and enabled. Its services will be available for use.
 */
define('HOSTING_SERVER_ENABLED', 1);

/**
 * Helper function to map status codes to labels and classes.
 */
function _hosting_server_status_codes() {
  $codes = array(
    HOSTING_SERVER_QUEUED => array(
      'label' => 'Queued',
      'class' => 'hosting-queue',
    ),
    HOSTING_SERVER_ENABLED => array(
      'label' => 'Enabled',
      'class' => 'hosting-success',
    ),
    HOSTING_SERVER_DELETED => array(
      'label' => 'Deleted',
      'class' => 'hosting-error',
    ),
    HOSTING_SERVER_LOCKED => array(
      'label' => 'Locked',
      'class' => 'hosting-disable',
    ),
  );
  return $codes;
}

/**
 * Server status codes to human-readable label map.
 */
function _hosting_server_status_codes_labels() {
  $labels = array();
  foreach (_hosting_server_status_codes() as $code => $info) {
    $labels[$code] = $info['label'];
  }
  return $labels;
}

/**
 * Return the appropriate status label.
 */
function _hosting_server_status($status) {
  static $labels;
  $labels = _hosting_server_status_codes();
  if (is_object($status)) {
    $value = $status->server_status ?? $status->status ?? HOSTING_SERVER_QUEUED;
    return $labels[$value]['label'];
  }
  return $labels[$status]['label'];
}

/**
 * Define the classes that correspond to the platform status.
 */
function _hosting_server_list_class($status) {
  static $labels;
  $labels = _hosting_server_status_codes();
  if (is_object($status)) {
    $value = $status->server_status ?? $status->status ?? HOSTING_SERVER_QUEUED;
    return $labels[$value]['class'];
  }
  return $labels[$status]['class'];
}

/**
 * Implements hook_hosting_tasks().
 */
function hosting_server_hosting_tasks() {
  $tasks = array();
  $tasks['server']['verify'] = array(
    'title' => t('Verify Server'),
    'description' => t('Verify that the server is correctly installed and working.'),
    'weight' => 10,
    'provision_save' => TRUE,
  );

  $tasks['server']['delete'] = array(
    'title' => t('Delete Server'),
    'description' => t('Delete the server.'),
  );

  return $tasks;
}

/**
 * Return an associative array of services enabled on this system.
 */
function hosting_server_services() {
  static $services;

  if (!isset($services)) {
    $module_handler = \Drupal::moduleHandler();
    $module_handler->loadAll();
    foreach (array_keys($module_handler->getModuleList()) as $module) {
      if (function_exists($module . '_hosting_service_type') || function_exists($module . '_hosting_service')) {
        $module_handler->loadInclude($module, 'service.inc');
      }
    }

    // Invoke hook_hosting_service_type().
    $services = $module_handler->invokeAll('hosting_service_type');
    foreach (array_keys($module_handler->getModuleList()) as $module) {
      if (!function_exists($module . '_hosting_service')) {
        continue;
      }
      // Invoke hook_hosting_service().
      $service_types = $module_handler->invoke($module, 'hosting_service');
      foreach ((array) $service_types as $service => $service_type) {
        $services[$service_type]['types'][$service] = 'hostingService_' . $service_type . '_' . $service;
      }
    }
  }

  return $services;
}

/**
 * Factory method for generating new instance of a service class.
 */
function hosting_services_new_object($name, $type, $node, $values = NULL) {
  $services = hosting_server_services();

  $class = $services[$name]['types'][$type];
  if (!$class) {
    return;
  }
  return new $class($node, $values);
}

/**
 * Return a key for caching service objects per server instance.
 */
function _hosting_server_service_cache_key($server) {
  if ($server instanceof \Drupal\Core\Entity\EntityInterface) {
    $id = $server->id();
    if ($id) {
      return 'id:' . $id;
    }
  }
  if (is_object($server)) {
    return 'obj:' . spl_object_hash($server);
  }
  return NULL;
}

/**
 * Service object cache.
 */
function &hosting_server_service_cache() {
  static $cache = array();
  return $cache;
}

/**
 * Set cached service objects for a server.
 */
function hosting_server_service_cache_set($server, array $services) {
  $cache = &hosting_server_service_cache();
  $key = _hosting_server_service_cache_key($server);
  if ($key) {
    $cache[$key] = $services;
  }
}

/**
 * Load service objects for a server.
 */
function hosting_server_service_objects($server, $reset = FALSE) {
  $cache = &hosting_server_service_cache();
  $key = _hosting_server_service_cache_key($server);
  if (!$key) {
    return array();
  }
  if ($reset || !isset($cache[$key])) {
    $services = array();
    $server_id = hosting_entity_id($server);
    if ($server_id) {
      $result = \Drupal::database()->query("SELECT service, type
                          FROM {hosting_service}
                          WHERE server_id = :server_id
                          AND available = :available",
        array(
          ':server_id' => $server_id,
          ':available' => 1,
        )
      );
      foreach ($result as $record) {
        $name = $record->service;
        if ($service_object = hosting_services_new_object($name, $record->type, $server)) {
          $services[$name] = $service_object;
        }
      }
    }
    $cache[$key] = $services;
  }
  return $cache[$key];
}

/**
 * Return a specific service object for a server.
 */
function hosting_server_service($server, $name) {
  $services = hosting_server_service_objects($server);
  return $services[$name] ?? NULL;
}

/**
 * Add a service to an existing server.
 */
function hosting_services_add($server, $name, $type, $values = array()) {
  $values['available'] = (isset($values['available'])) ? $values['available'] : 1;

  return hosting_services_new_object($name, $type, $server, $values);
}

/**
 * Translate a server form submission into populated service objects.
 */
function hosting_server_services_from_post(&$node) {
  if (!isset($node->services) || !is_array($node->services)) {
    return hosting_server_service_objects($node);
  }
  $services = array();
  foreach (hosting_server_services() as $name => $data) {
    if (isset($node->services[$name]) && is_array($node->services[$name])) {
      if ($node->services[$name]['type'] !== 'null') {
        if ($service_object = hosting_services_new_object($name, $node->services[$name]['type'], $node, $node->services[$name][$node->services[$name]['type']])) {
          $service_object->available = TRUE;
          $services[$name] = $service_object;
        }
      }
    }
  }
  hosting_server_service_cache_set($node, $services);
  return $services;
}

/**
 * Hide the delete button on server nodes.
 */
function hosting_server_form_alter(&$form, &$form_state, $form_id) {
  // Remove delete button from server edit form,
  // unless the server's already been deleted via the Delete task.
  if (in_array($form_id, array('hosting_server_form', 'hosting_server_add_form', 'hosting_server_edit_form'), TRUE)) {
    $node = $form['#entity'] ?? $form['#node'] ?? NULL;
    if (isset($form['actions']['delete']) && $node && hosting_entity_status($node, 'server') !== HOSTING_SERVER_DELETED) {
      $form['actions']['delete']['#type'] = 'hidden';
    }
  }
}

/**
 * Invoke a method on all enabled services.
 */
function hosting_server_invoke_services(&$node, $method, &$arg1 = NULL, &$arg2 = NULL, &$arg3 = NULL, &$arg4 = NULL) {
  $return = array();
  foreach (hosting_server_service_objects($node) as $name => $service) {
    $result = $service->$method($arg1, $arg2, $arg3, $arg4);
    if (isset($result) && is_array($result)) {
      $return = array_merge_recursive($return, $result);
    }
    elseif (isset($result)) {
      $return[] = $result;
    }
  }
  return $return;
}


/**
 * Legacy wrapper to build a hosting_server form section.
 */
function hosting_server_form($node, &$form_state) {
  if (!$node instanceof \Drupal\Core\Entity\ContentEntityInterface || $node->getEntityTypeId() !== 'hosting_server') {
    $node = \Drupal::entityTypeManager()->getStorage('hosting_server')->create();
  }
  $form['#entity'] = $node;
  $form['#node'] = $node;
  if (is_object($form_state) && method_exists($form_state, 'set')) {
    $form_state->set('node', $node);
  }
  else {
    $form_state['node'] = $node;
  }

  $form_display = \Drupal::service('entity_display.repository')->getFormDisplay('hosting_server', 'default');
  $form_display->buildForm($node, $form, $form_state);
  hosting_server_apply_form_overrides($form, $form_state, $node);

  return $form;
}

/**
 * Apply dynamic overrides to the server form.
 */
function hosting_server_apply_form_overrides(array &$form, &$form_state, $node) {
  if (!$node instanceof \Drupal\Core\Entity\ContentEntityInterface || $node->getEntityTypeId() !== 'hosting_server') {
    return;
  }

  if (isset($form['actions']['delete']) && hosting_entity_status($node, 'server') !== HOSTING_SERVER_DELETED) {
    $form['actions']['delete']['#type'] = 'hidden';
  }

  $form['services'] = $form['services'] ?? array();
  $form['services']['#weight'] = $form['services']['#weight'] ?? 5;
  $form['services']['#tree'] = TRUE;

  $active_services = hosting_server_service_objects($node);

  $form['ips_wrapper'] = array(
    '#title' => t('IP addresses'),
    '#description' => t('A list of IP addresses this server is publicly available under, one per line. If none is specified, X509 certificates will be offered through the SNI mechanism by TLS-enabled webservers. <br /><strong>This should point to the public network, if you have such a separation.</strong>'),
    '#type' => 'fieldset',
    '#tree' => FALSE,
    '#weight' => 2,
    '#prefix' => '<div class="clear-block" id="hosting-ips-wrapper">',
    '#suffix' => '</div>',
  );

  $form['ips_wrapper']['ip_addresses'] = array(
    '#prefix' => '<div id="hosting-ip-addresses">',
    '#suffix' => '</div>',
    '#tree' => TRUE,
  );

  $ips = isset($node->ip_addresses) && is_array($node->ip_addresses) ? $node->ip_addresses : hosting_server_ip_addresses($node);
  $ips_count = max(3, empty($ips) ? 3 : count($ips) + 1);

  foreach ($ips as $id => $ip) {
    $form['ips_wrapper']['ip_addresses'][$id] = array(
      '#type' => 'textfield',
      '#default_value' => $ip,
    );
    $ips_count--;
  }
  $form['ips_wrapper']['new_ip_addresses'] = array(
    '#prefix' => '<div id="hosting-ip-addresses">',
    '#suffix' => '</div>',
    '#tree' => TRUE,
  );
  for ($delta = 0; $delta < $ips_count; $delta++) {
    $form['ips_wrapper']['new_ip_addresses'][$delta] = array(
      '#type' => 'textfield',
    );
  }

  $form['services_tabs'] = array(
    '#type' => 'vertical_tabs',
  );
  foreach (hosting_server_services() as $name => $service) {
    $form['services'][$name] = array(
      '#type' => 'fieldset',
      '#group' => 'services_tabs',
      '#title' => \Drupal\Component\Utility\Html::escape($service['title']),
      '#weight' => isset($service['weight']) ? $service['weight'] : 0,
    );
    if (array_key_exists('types', $service)) {
      $options = array(
        'null' => t('None'),
      );
      foreach ($service['types'] as $type => $class_name) {
        $service_objects[$name][$type] = hosting_services_new_object($name, $type, $node);
        $options[$type] = $service_objects[$name][$type]->getName();
      }

      $form['services'][$name]['type'] = array(
        '#type' => 'radios',
        '#weight' => -99,
        '#options' => $options,
        '#default_value' => isset($active_services[$name]->available) && $active_services[$name]->available ? $active_services[$name]->type : 'null',
      );

      foreach ($service['types'] as $type => $class) {
        $form['services'][$name][$type] = array(
          '#states' => array(
            'visible' => array(
              ":input[name='services[{$name}][type]']" => array('value' => $type),
            ),
          ),
          '#type' => 'container',
        );
        if (isset($active_services[$name]) && $active_services[$name]->type === $type) {
          $active_services[$name]->form($form['services'][$name][$type]);
        }
        else {
          $service_object = $service_objects[$name][$type];
          $service_object->form($form['services'][$name][$type]);
        }
      }
    }
    else {
      \Drupal::messenger()->addMessage(t('No implementations available for the :type service. Please visit the !features_link page and enable one.', array(':type' => $service['title'], '!features_link' => \Drupal\Core\Link::fromTextAndUrl(t('Hosting Features'), \Drupal\Core\Url::fromUserInput('/admin/hosting'))->toString())), 'warning');
    }
  }

  foreach (array('verified', 'platform_status') as $extra_attribute) {
    if (!isset($form[$extra_attribute])) {
      $form[$extra_attribute] = array(
        '#type' => 'value',
        '#value' => isset($node->$extra_attribute) ? $node->$extra_attribute : NULL,
      );
    }
  }
}

/**
 * Resolve an error name for a server field widget.
 */
function hosting_server_form_error_name(array $form, $field_name, array $value_keys) {
  if (isset($form[$field_name]['widget'][0])) {
    foreach ($value_keys as $key) {
      if (isset($form[$field_name]['widget'][0][$key]['#parents'])) {
        return implode('][', $form[$field_name]['widget'][0][$key]['#parents']);
      }
    }
  }
  return $field_name;
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 *
 * We notice the operator if no IP was given. We do not set any to allow
 * operators to use SNI. We also fire up the regular services hooks.
 */
function hosting_server_presave(\Drupal\Core\Entity\EntityInterface $node) {
  if ($node->getEntityTypeId() !== 'hosting_server') {
    return;
  }
  $ip_addresses = isset($node->ip_addresses) && is_array($node->ip_addresses) ? $node->ip_addresses : hosting_server_ip_addresses($node);
  if (empty($ip_addresses)) {
    // This returns an array or FALSE.
    $ips = gethostbynamel(hosting_entity_label($node));
    if ($ips) {
      \Drupal::messenger()->addMessage(t('No IP addresses provided for server. We guess the IP is %ip based on hostname %name. You should set IP addreses in the server node unless you are ready to use SNI (Server Name Indication) which is incompatible with IE and Safari on Windows XP.', array('%ip' => join(',', $ips), '%name' => hosting_entity_label($node))), 'message');
    }
  }
  hosting_server_services_from_post($node);
}

/**
 * Implements hook_validate().
 */
function hosting_server_validate(&$node, &$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  if ($node->op != t('Delete')) {
    // Make sure the server name is unique, to avoid context clashes.
    $server_id = hosting_entity_id($node);
    $result = \Drupal::database()->query("SELECT label AS name
                          FROM {hosting_server}
                         WHERE label = :title
                           AND id <> :id
                           AND status >= :status",
      array(
        ':title' => hosting_entity_label($node),
        ':id' => $server_id ?: 0,
        ':status' => HOSTING_SERVER_LOCKED,
      )
    )->fetchField();
    if ($result) {
      $form_state->setErrorByName(hosting_server_form_error_name($form, 'label', array('value')),
        t('The hostname `%name` is already in use. Server names must be unique.',
        array('%name' => $result))
      );
    }

    _hosting_ip_validate($node, $form_state);
    if (!_hosting_valid_fqdn(hosting_entity_label($node))) {
      $form_state->setErrorByName(hosting_server_form_error_name($form, 'label', array('value')), t('Invalid hostname. Use a proper hostname or an IP address.'));
    }

    hosting_server_services_from_post($node);

    hosting_server_invoke_services($node, 'validate', $node, $form, $form_state);
  }
}


/**
 * Implements hook_update().
 *
 * As an existing node is being updated in the database, we need to do our own
 * database updates.
 */
function hosting_server_update($node) {
  // If this is a new node or we're adding a new revision.
  if (!empty($node->revision)) {
    hosting_server_insert($node);
  }
  else {
    $services = hosting_server_services_from_post($node);
    hosting_server_invoke_services($node, 'save', $node);
    hosting_server_invoke_services($node, 'update', $node);

    // Remove disabled services.
    $server_id = hosting_entity_id($node);
    foreach (array_diff(array_keys(hosting_server_services()), array_keys($services)) as $name) {
      \Drupal::database()->delete('hosting_service')
        ->condition('service', $name)
        ->condition('server_id', $server_id)
        ->execute();
    }
  }

  if ($node->server_status == HOSTING_SERVER_DELETED) {
    $node->no_verify = TRUE;
  }

  $id = \Drupal::database()->update('hosting_server')
    ->fields(array(
      'human_name' => $node->human_name,
      'verified' => $node->verified,
      'status' => $node->server_status,
    ))
    ->condition('id', hosting_entity_id($node))
    ->execute();

  _hosting_ip_save($node, TRUE);

  if (!isset($node->no_verify) || !$node->no_verify) {
    hosting_add_task(hosting_entity_id($node), 'verify');
  }
}

/**
 * Implements hook_insert().
 */
function hosting_server_insert($node) {
  // Always generate a new context.
  $server_id = hosting_entity_id($node);
  $hosting_name = isset($node->hosting_name) ? $node->hosting_name : 'server_' . preg_replace("/[!\W\.\-]/", "", hosting_entity_label($node));
  hosting_context_register($server_id, $hosting_name);

  \Drupal::database()->update('hosting_server')
    ->fields(array(
      'human_name' => isset($node->human_name) ? $node->human_name : '',
      'verified' => isset($node->verified) ? $node->verified : 0,
      'status' => isset($node->platform_status) ? $node->platform_status : (isset($node->status) ? $node->status : 0),
    ))
    ->condition('id', $server_id)
    ->execute();

  _hosting_ip_save($node, FALSE);

  hosting_server_services_from_post($node);
  hosting_server_invoke_services($node, 'save', $node);
  hosting_server_invoke_services($node, 'insert', $node);

  if (!isset($node->no_verify) || !$node->no_verify) {
    hosting_add_task($server_id, 'verify');
  }
}

/**
 * Implements hook_delete().
 */
function hosting_server_delete($node) {
  if ($node instanceof \Drupal\Core\Entity\EntityInterface && $node->getEntityTypeId() === 'hosting_server') {
    $server_id = $node->id();
    _hosting_ip_delete($node);
    hosting_context_delete($server_id);
    hosting_task_delete_related_tasks($server_id);
    hosting_server_invoke_services($node, 'delete_revision');
    return;
  }
  \Drupal::database()->delete('hosting_server')
    ->condition('id', hosting_entity_id($node))
    ->execute();
  _hosting_ip_delete($node);
  $server_id = hosting_entity_id($node);
  hosting_context_delete($server_id);
  hosting_task_delete_related_tasks($server_id);
  hosting_server_invoke_services($node, 'delete_revision');
}

/**
 * Implements hook_load().
 */
function hosting_server_load($nodes) {
  foreach ($nodes as $entity_id => &$node) {
    $additions = \Drupal::database()->query('SELECT human_name, verified, status AS server_status FROM {hosting_server} WHERE id = :id', array(':id' => hosting_entity_id($node)))->fetch();
    // Avoid PHP 5.4 warning when platform doesn't exist yet.
    // See: https://drupal.org/node/1940378
    $additions = $additions ? $additions : new stdClass();

    hosting_server_invoke_services($node, 'load');

    foreach ($additions as $property => &$value) {
      $node->$property = is_numeric($value) ? (int) $value : $value;
    }
  }
}

/**
 * Menu wildcard loader callback.
 *
 * Loads a hosting_server entity.
 * @see hosting_task_menu()
 *
 * @arg $arg a numeric server id
 */
function hosting_server_wildcard_load($arg) {
  if (!is_numeric($arg)) {
    return FALSE;
  }
  return \Drupal::entityTypeManager()->getStorage('hosting_server')->load($arg) ?: FALSE;
}


/**
 * Implements hook_view().
 */
function hosting_server_view($node, $view_mode, $langcode = NULL) {
  hosting_set_breadcrumb($node);

  $services = hosting_server_services();
  $service_objects = hosting_server_service_objects($node);

  $node->content['info'] = array(
    '#prefix' => '<div id="hosting-server-info" class="hosting-info-list">',
    '#suffix' => '</div>',
  );
  $node->content['info']['status'] = array(
    '#type' => 'item',
    '#title' => t('Status'),
    '#markup' => _hosting_server_status($node->server_status),
  );
  $node->content['info']['verified'] = array(
    '#type' => 'item',
    '#title' => t('Verified'),
    '#markup' => hosting_format_interval($node->verified),
    '#weight' => -10,
  );
  $node->content['info']['hostname'] = array(
    '#title' => 'hostname',
    '#type' => 'item',
    '#markup' => hosting_entity_label($node),
    '#weight' => -50,
  );

  _hosting_ip_view($node);
  if (isset($node->content->info->ip_addresses['#weight'])) {
    $node->content->info->ip_addresses['#weight'] = -30;
  }

  if (!empty($service_objects)) {
    foreach ($service_objects as $name => $service) {
      $node->content['info'][$name] = array(
        '#prefix' => '<div class="hosting-service-info hosting-service-' . $name . '-info">',
        '#suffix' => '</div>',
      );
      if (isset($services[$name]['weight'])) {
        $node->content['info'][$name]['#weight'] = $services[$name]['weight'];
      }

      $node->content['info'][$name]['title'] = array(
        '#title' => $services[$name]['title'],
        '#markup' => $service->type,
        '#type' => 'item',
        '#weight' => -20,
      );

      $service->view($node->content['info'][$name]);
    }
  }

  if ($view_mode == 'full') {
    // Task list.
    if (hosting_entity_id($node)) {
      $tasks_view = hosting_task_table($node);
      $tasks_view['#prefix'] = '<div id="hosting-task-list">';
      $tasks_view['#suffix'] = '</div>';
      $tasks_view['#weight'] = 10;
      $node->content['tasks_view'] = $tasks_view;
      $node->content['#attached']['library'][] = 'hosting_task/task';
    }
  }

  return $node;
}

/**
 * Implements hook_field_extra_fields().
 */
function hosting_server_field_extra_fields() {
  $return['node']['server'] = array(
    'display' => array(
      'info' => array(
        'label' => t('Aegir Server Information'),
        'description' => t('Detailed information about this server.'),
        'weight' => 0,
      ),
      'tasks_view' => array(
        'label' => t('Aegir Server Tasks'),
        'description' => t('List of available tasks.'),
        'weight' => 1,
      ),
    ),
  );
  return $return;
}

/**
 * Implements hook_entity_property_info().
 */
function hosting_server_entity_property_info() {
  $info['node']['bundles']['server']['properties'] = array(
    'human_name' => array(
      'label' => t('Human-readable name'),
      'description' => t('The optional human readable name of the server.'),
      'type' => 'text',
    ),
    'verified' => array(
      'label' => t('Last verification time'),
      'description' => t('The date and time of the last verification of the server.'),
      'type' => 'date',
    ),
    'server_status' => array(
      'label' => t('Server status'),
      'description' => t('The status of the server. E.g. enabled, deleted, etc.'),
      'type' => 'integer',
      'options list' => '_hosting_server_status_codes_labels',
    ),
    'ip_addresses' => array(
      'label' => t('IP addresses'),
      'description' => t('The list of IP addresses the server is assigned.'),
      // @TODO: use a type that defines an IP address and add validation.
      'type' => 'list<text>',
    ),
  );

  return $info;
}

/**
 * Get servers providing a service.
 *
 * @param string $service
 *   Service type string, like 'http' or 'db'
 *
 * @param bool $node_access
 *   Apply node access filters, defaults to TRUE.
 *
 * @return array
 *   An array of enabled servers, keys are server entity IDs representing
 *   them, values are the titles of the servers.
 *
 * @see hook_hosting_servers_titles_alter()
 */
function hosting_get_servers($service, $node_access = TRUE) {
  $return = array();
  $server_ids = \Drupal::database()->query('SELECT DISTINCT server_id FROM {hosting_service} WHERE available = :available AND service = :service', [
    ':available' => 1,
    ':service' => $service,
  ])->fetchCol();

  if ($server_ids) {
    $storage = \Drupal::entityTypeManager()->getStorage('hosting_server');
    $servers = $storage->loadMultiple($server_ids);
    foreach ($servers as $server) {
      if (!$node_access || $server->access('view')) {
        $return[$server->id()] = $server->label();
      }
    }
  }

  if ($return) {
    asort($return);
  }
  \Drupal::moduleHandler()->alter('hosting_servers_titles', $return, $service);
  return $return;
}

