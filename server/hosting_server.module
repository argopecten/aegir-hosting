/**
 * Implements hook_preprocess().
 */
function hosting_server_preprocess(&$variables) {
  if (isset($variables['view']) && array_key_exists('services', $variables['view']->field)) {
    if (!empty($variables['header']['services']['content'])) {
      $services = _hosting_server_preprocess_service_titles($variables['header']['services']['content']);
      if (count($services) > 1) {
        $base_header_id = NULL;
        if (isset($variables['header']['services']['attributes']) && $variables['header']['services']['attributes'] instanceof \Drupal\Core\Template\Attribute) {
          $base_header_id = (string) $variables['header']['services']['attributes']->offsetGet('id');
        }
        $variables['header'] = _hosting_server_preprocess_split_header($variables['header'], $services, $base_header_id);
        $variables['rows'] = _hosting_server_preprocess_split_rows($variables['rows'], $services, $base_header_id);
        if (isset($variables['fields'])) {
          $variables['fields'] = _hosting_server_preprocess_split_fields($variables['fields'], $services);
        }
      }
    }
  }
}

/**
 * Split a comma-separated service label into titles.
 */
function _hosting_server_preprocess_service_titles($label) {
  if (is_array($label)) {
    $label = \Drupal::service('renderer')->renderPlain($label);
  }
  $label = trim((string) $label);
  if ($label === '') {
    return [];
  }

  $services = array_map('trim', explode(',', $label));
  return array_values(array_filter($services, 'strlen'));
}

/**
 * Replace the services header column with one column per service.
 */
function _hosting_server_preprocess_split_header(array $header, array $services, $base_header_id) {
  $split_header = [];
  foreach ($header as $key => $item) {
    if ($key !== 'services') {
      $split_header[$key] = $item;
      continue;
    }
    foreach ($services as $index => $title) {
      $new_key = 'services_' . $index;
      $new_item = $item;
      $new_item['content'] = $title;
      if (isset($new_item['attributes']) && $new_item['attributes'] instanceof \Drupal\Core\Template\Attribute) {
        $new_item['attributes'] = clone $new_item['attributes'];
        if (!empty($base_header_id)) {
          $new_item['attributes']->setAttribute('id', $base_header_id . '-' . ($index + 1));
        }
      }
      $split_header[$new_key] = $new_item;
    }
  }
  return $split_header;
}

/**
 * Split the services row column into one column per service.
 */
function _hosting_server_preprocess_split_rows(array $rows, array $services, $base_header_id) {
  foreach ($rows as $row_index => $row) {
    if (empty($row['columns']) || !array_key_exists('services', $row['columns'])) {
      continue;
    }
    $column = $row['columns']['services'];
    $values = _hosting_server_preprocess_service_values($column, count($services));
    $split_columns = [];
    foreach ($row['columns'] as $key => $col) {
      if ($key !== 'services') {
        $split_columns[$key] = $col;
        continue;
      }
      foreach ($services as $index => $title) {
        $new_key = 'services_' . $index;
        $new_col = $column;
        $value = $values[$index] ?? '';
        $new_col['content'] = [
          [
            'field_output' => ['#markup' => $value],
          ],
        ];
        if (isset($new_col['attributes']) && $new_col['attributes'] instanceof \Drupal\Core\Template\Attribute) {
          $new_col['attributes'] = clone $new_col['attributes'];
          if (!empty($base_header_id)) {
            $new_col['attributes']->setAttribute('headers', [$base_header_id . '-' . ($index + 1)]);
          }
          $new_col['attributes']->addClass($value === 'no' || $value === '' ? 'hosting-service-unavailable' : 'hosting-service-available');
        }
        $split_columns[$new_key] = $new_col;
      }
    }
    $row['columns'] = $split_columns;
    $rows[$row_index] = $row;
  }
  return $rows;
}

/**
 * Expand the services field mapping for the table headers.
 */
function _hosting_server_preprocess_split_fields(array $fields, array $services) {
  if (!isset($fields['services'])) {
    return $fields;
  }

  $expanded = [];
  foreach ($fields as $key => $class) {
    if ($key !== 'services') {
      $expanded[$key] = $class;
      continue;
    }
    foreach ($services as $index => $title) {
      $expanded['services_' . $index] = $class;
    }
  }
  return $expanded;
}

/**
 * Extract the service values from the services column.
 */
function _hosting_server_preprocess_service_values(array $column, $expected_count) {
  $raw = '';
  if (!empty($column['content'][0]['field_output'])) {
    $raw = $column['content'][0]['field_output'];
  }
  if (is_array($raw)) {
    $raw = $raw['#markup'] ?? \Drupal::service('renderer')->renderPlain($raw);
  }
  $values = array_map('trim', explode(',', (string) $raw));
  if ($expected_count > count($values)) {
    $values = array_pad($values, $expected_count, '');
  }
  return $values;
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function hosting_server_form_hosting_settings_alter(&$form, $form_state) {
  $form['hosting_default_db_server'] = array(
    '#title' => 'Default database server',
    '#description' => 'When importing sites, and during some other operations, Aegir will use this database, if none was specified.',
    '#type' => 'select',
    '#options' => hosting_get_servers('db'),
    '#default_value' => \Drupal::config('hosting.settings')->get('hosting_default_db_server') ?? 4,
  );
}

/**
 * Pass options for the server verification to the backend.
 *
 * Here we pass the hostname, IP addresses, and setup the services for
 * this server (?).
 */
function hosting_hosting_server_context_options(&$task) {
  $task->context_options['remote_host'] = $task->ref instanceof \Drupal\Core\Entity\EntityInterface ? $task->ref->label() : NULL;
  $ip_list = hosting_server_ip_address_values($task->ref);
  $task->context_options['ip_addresses'] = count($ip_list) ? implode(',', $ip_list) : 'null';

  $services = hosting_server_service_objects($task->ref);
  $task_type = $task->get('task_type')->value ?? NULL;
  $ref_type = hosting_entity_task_scope($task->ref);
  foreach (hosting_server_services() as $type => $info) {
    if (isset($services[$type])) {
      $service = $services[$type];
      if ($service->available) {
        $service->context_options($task_type, $ref_type, $task);
      }
    }
    else {
      // If we're here, there is no enabled service of this type on this server.
      // If such a service had previously been enabled, that fact, along with
      // any subscribed properties would be recorded in the server context.
      // Since we persist values in contexts, we cannot just leave this unset.
      // Similarly, in Provision_Context::__get(), we filter out falsy values,
      // so we cannot set this to NULL. 0 or the like. Therefore, we explicitely
      // set it to value that we check for in
      // Provision_Context_server::spawn_service().
      $task->context_options["{$type}_service_type"] = 'NONE';
    }
  }
}

/**
 * Implements hook_drush_context_import().
 */
function hosting_server_drush_context_import($context, &$node) {
  if ($context->type == 'server') {
    $label = strtolower($context->remote_host);
    if ($node instanceof \Drupal\Core\Entity\ContentEntityInterface) {
      if (!$node->label()) {
        $node->set('label', $label);
      }
      $node->new_ip_addresses = implode("\n", $context->ip_addresses);
    }
    else {
      if (!isset($node->label)) {
        $node->label = $label;
      }
      $node->new_ip_addresses = implode("\n", $context->ip_addresses);
    }
    $services = hosting_server_service_objects($node);
    $values = array();
    foreach (hosting_server_services() as $type => $info) {
      if (isset($context->{$type . '_service_type'})) {
        $service_type = $context->{$type . '_service_type'};
        if (isset($services[$type])) {
          if ($services[$type]->type != $service_type) {
            unset($services[$type]);
          }
        }
        if (!isset($services[$type])) {
          // Only support the base configuration things for now.
          $service_object = hosting_services_add($node, $type, $service_type, $values);
          if ($service_object) {
            $services[$type] = $service_object;
          }
        }

        if (isset($services[$type])) {
          $services[$type]->context_import($context);
        }
      }
    }
    hosting_server_service_cache_set($node, $services);
  }
}

/**
 * Resave the target node to trigger reverifications.
 */
function hosting_server_post_hosting_verify_task($task, $data) {
  if ($task->ref instanceof \Drupal\Core\Entity\ContentEntityInterface && $task->ref->getEntityTypeId() === 'hosting_server') {
    $task->ref->no_verify = TRUE;

    // Set verified flag on server, to let it know it has been checked.
    $task->ref->set('verified', REQUEST_TIME);

    $task->ref->set('status', HOSTING_SERVER_ENABLED);
    $task->ref->save();
  }
}

/**
 * Implements hook_hosting_post_delete().
 */
function hosting_server_post_hosting_delete_task($task, $data) {
  if ($task->ref instanceof \Drupal\Core\Entity\ContentEntityInterface && $task->ref->getEntityTypeId() === 'hosting_server') {
    $task->ref->set('status', HOSTING_SERVER_DELETED);
    $task->ref->no_verify = TRUE;
    hosting_server_service_cache_set($task->ref, array());
    $task->ref->save();
    hosting_context_delete($task->ref->id());
  }
}
