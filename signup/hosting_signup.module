<?php
/**
 * @file
 * Provides a signup form that can be run on remote sites
 */

/**
 * Prefix form element parents for embedded sub-forms.
 */
function hosting_signup_prefix_form_parents(array &$element, array $prefix) {
  foreach (\Drupal\Core\Render\Element::children($element, TRUE) as $key) {
    if (!empty($element[$key]['#hosting_signup_prefix_skip'])) {
      continue;
    }
    if (isset($element[$key]['#parents'])) {
      $current = $element[$key]['#parents'];
      if (array_slice($current, 0, count($prefix)) !== $prefix) {
        $element[$key]['#parents'] = array_merge($prefix, $current);
      }
    }
    if (is_array($element[$key])) {
      hosting_signup_prefix_form_parents($element[$key], $prefix);
    }
  }
}
