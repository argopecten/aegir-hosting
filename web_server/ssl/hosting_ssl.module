}

/**
 * Implements hook_entity_view().
 */
function hosting_ssl_entity_view(array &$build, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display, $view_mode) {
  hosting_ssl_site_view($build, $entity);
}

/**
 * List SSL certificates associated with the given server.
 */
function hosting_ssl_server_cert_list($node) {
  $build = array(
    '#title' => t('Certificates installed on server @server', array('@server' => $node->label())),
  );
  $server_id = hosting_entity_id($node);
  $header = array(
    array(
      'data' => t('Domain'),
      'field' => 'domain',
    ),
    array(
      'data' => t('IP address'),
      'field' => 'ip_address',
    ),
    array(
      'data' => t('Client'),
      'field' => 'client',
    ),
  );
  $query = \Drupal::database()->select('hosting_ip_addresses', 'ips');
  $query = $query->extend('PagerDefault');
  $query = $query->extend('TableSort');
  $query->join('hosting_ssl_cert_ips', 'cert_ip', 'cert_ip.ip_address = ips.id');
  $query->join('hosting_ssl_cert', 'cert', 'cert.cid = cert_ip.cid');
  $query->join('hosting_client', 'client', 'client.id = cert.client');
  $query->element(2);
  $query->addField('ips', 'ip_address');
  $query->addField('cert', 'ssl_key', 'domain');
  $query->addField('cert', 'status');
  $query->addField('client', 'label', 'client');
  $query->condition('ips.server_id', $server_id)
    ->limit(25)
    ->orderByHeader($header);
  $result = $query->execute();

  $rows = array();
  foreach ($result as $cert) {
    $row = array();
    $row[] = $cert->domain;
    $row[] = $cert->ip_address;
    $row[] = \Drupal\Component\Utility\Xss::filter($cert->client);
    $rows[] = $row;
  }
  $build['table'] = array(
    '#theme' => 'table',
    '#header' => $header,
    '#rows' => $rows,
    '#attributes' => array('class' => array('hosting-table')),
  );
  $build['pager'] = array(
    '#type' => 'pager',
    '#tags' => NULL,
    '#element' => 2,
  );
  return $build;
}

/**
 * Callback function to execute on enabling this module's feature.
 *
 * @see: hosting_example_hosting_feature().
 */
function hosting_ssl_feature_enable_callback() {
  \Drupal::messenger()->addMessage(t("Please make sure you have enabled SSL support in your webserver, e.g. by enabling mod_ssl in Apache."));
  \Drupal::messenger()->addMessage(t("To start using SSL please edit the desired server node within Aegir to set in from e.g. 'apache' to 'apache_ssl'."));
}

/**
 * Implements hook_hosting_site_context_options().
 */
function hosting_ssl_hosting_site_context_options(&$task) {
  $node = $task->ref;

  if (isset($node->ssl_enabled)) {
    // we pass null to disable the option.
    $task->context_options['ssl_enabled'] = ($node->ssl_enabled) ? $node->ssl_enabled : 'null';

    if ($node->ssl_enabled) {
      $task->context_options['ssl_key'] = hosting_ssl_get_key($node->ssl_key);
    }
    else {
      $task->context_options['ssl_key'] = 'null';
    }
    $task->context_options['ip_addresses'] = hosting_ssl_get_ip($node->ssl_key);
  }
}
