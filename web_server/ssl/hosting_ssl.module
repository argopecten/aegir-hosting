 * Implements hook_entity_load().
 */
function hosting_ssl_entity_load(array $entities) {
  hosting_ssl_site_load($entities);
}

/**
 * Implements hook_entity_presave().
 */
function hosting_ssl_entity_presave(\Drupal\Core\Entity\EntityInterface $entity) {
