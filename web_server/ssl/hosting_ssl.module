}

/**
 * Implements hook_entity_insert().
 */
function hosting_ssl_entity_insert(\Drupal\Core\Entity\EntityInterface $entity) {
  hosting_ssl_site_insert($entity);
}

/**
 * Implements hook_entity_update().
 */
function hosting_ssl_entity_update(\Drupal\Core\Entity\EntityInterface $entity) {
  hosting_ssl_site_update($entity);
}

/**
 * Implements hook_entity_delete().
 */
function hosting_ssl_entity_delete(\Drupal\Core\Entity\EntityInterface $entity) {
