<?php

/**
 * @file
 * Hosting platform module.
 */

/**
 * Implements hook_hosting_feature().
 */
function hosting_platform_hosting_feature() {
  return [
    'platform' => [
      'title' => t('Platforms'),
      'description' => t('Platform records and tasks.'),
      'module' => 'hosting_platform',
      'required' => FALSE,
      'dependencies' => ['hosting_server', 'hosting_package'],
    ],
  ];
}

/**
 * Implements hook_theme().
 */
function hosting_platform_theme($existing, $type, $theme, $path): array {
  return [
    'hosting_platform' => [
      'render element' => 'elements',
      'template' => 'hosting-platform',
    ],
    'hosting_platform_sidebar' => [
      'variables' => [
        'content' => NULL,
        'attributes' => NULL,
      ],
      'template' => 'hosting-sidebar',
      'path' => \Drupal::service('extension.list.module')->getPath('hosting') . '/templates',
    ],
    'hosting_platform_task_queue' => [
      'variables' => [
        'title' => NULL,
        'list' => NULL,
        'attributes' => NULL,
      ],
      'template' => 'hosting-task-queue',
      'path' => \Drupal::service('extension.list.module')->getPath('hosting') . '/templates',
    ],
    'hosting_platform_navigation' => [
      'variables' => [
        'title' => NULL,
        'list' => NULL,
        'attributes' => NULL,
      ],
      'template' => 'hosting-navigation',
      'path' => \Drupal::service('extension.list.module')->getPath('hosting') . '/templates',
    ],
    'hosting_platform_sites_list' => [
      'variables' => [
        'title' => NULL,
        'list' => NULL,
        'attributes' => NULL,
      ],
      'template' => 'hosting-platform-sites-list',
    ],
  ];
}

/**
 * Prepares variables for hosting platform templates.
 *
 * Default template: hosting-platform.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the platform information and any
 *     fields attached to the entity.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_hosting_platform(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'];
  $variables['platform'] = $variables['elements']['#hosting_platform'];
  $variables['entity'] = $variables['platform'];
  
  // Helpful $content variable for templates.
  foreach (\Drupal\Core\Render\Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
  
  // Add title prefix/suffix.
  $variables['title_prefix'] = $variables['elements']['#title_prefix'] ?? [];
  $variables['title_suffix'] = $variables['elements']['#title_suffix'] ?? [];
  
  // Set label and title attributes.
  $variables['label'] = $variables['platform']->label();
  $variables['title_attributes'] = $variables['elements']['#title_attributes'] ?? new \Drupal\Core\Template\Attribute();
  
  // Pass sidebar if it exists.
  $variables['sidebar'] = $variables['content']['hosting_sidebar'] ?? NULL;
  unset($variables['content']['hosting_sidebar']);

  // Extract info table and task table for template regions.
  $variables['info'] = $variables['content']['info'] ?? NULL;
  unset($variables['content']['info']);
  $variables['tasks_view'] = $variables['content']['tasks_view'] ?? NULL;
  unset($variables['content']['tasks_view']);
}

/**
 * Implements hook_entity_view().
 */
function hosting_platform_entity_view(array &$build, \Drupal\Core\Entity\EntityInterface $entity, $display, $view_mode): void {
  if ($entity->getEntityTypeId() !== 'hosting_platform') {
    return;
  }

  /** @var \Drupal\hosting_platform\Entity\HostingPlatform $entity */
  $date_formatter = \Drupal::service('date.formatter');

  // Build info table matching D7 hosting_platform_view().
  $info_items = [];

  // Platform type.
  $platform_type = $entity->get('platform_type')->value ?? 'manual';
  $type_labels = ['manual' => t('Manual'), 'git' => t('Git')];
  $info_items[] = [
    'label' => t('Platform type'),
    'value' => ['#markup' => (string) ($type_labels[$platform_type] ?? $platform_type)],
    'weight' => -20,
  ];

  // Publish path.
  $publish_path = $entity->get('publish_path')->value ?? '';
  if ($publish_path) {
    $info_items[] = [
      'label' => t('Publish path'),
      'value' => ['#markup' => '<code>' . \Drupal\Component\Utility\Html::escape($publish_path) . '</code>'],
      'weight' => -18,
    ];
  }

  // Git URL.
  $git_url = $entity->get('git_url')->value ?? '';
  if ($git_url) {
    $info_items[] = [
      'label' => t('Git URL'),
      'value' => ['#markup' => '<code>' . \Drupal\Component\Utility\Html::escape($git_url) . '</code>'],
      'weight' => -15,
    ];
  }

  // Web server.
  $web_server_id = $entity->get('web_server')->target_id ?? NULL;
  if ($web_server_id) {
    $web_server = \Drupal::entityTypeManager()->getStorage('hosting_server')->load($web_server_id);
    $info_items[] = [
      'label' => t('Web server'),
      'value' => $web_server ? [
        '#type' => 'link',
        '#title' => $web_server->label(),
        '#url' => $web_server->toUrl(),
      ] : ['#markup' => (string) $web_server_id],
      'weight' => -10,
    ];
  }

  // Verified.
  $verified = (int) $entity->get('verified')->value;
  $info_items[] = [
    'label' => t('Verified'),
    'value' => ['#markup' => $verified ? $date_formatter->formatTimeDiffSince($verified) . ' ' . t('ago') : t('Never')],
    'weight' => -8,
  ];

  // Status.
  $status = (int) $entity->get('status')->value;
  $status_map = [
    \Drupal\hosting_platform\Entity\HostingPlatform::STATUS_QUEUED => ['label' => t('Queued'), 'class' => 'hosting-queue'],
    \Drupal\hosting_platform\Entity\HostingPlatform::STATUS_ENABLED => ['label' => t('Enabled'), 'class' => 'hosting-success'],
    \Drupal\hosting_platform\Entity\HostingPlatform::STATUS_LOCKED => ['label' => t('Locked'), 'class' => 'hosting-warning'],
    \Drupal\hosting_platform\Entity\HostingPlatform::STATUS_DELETED => ['label' => t('Deleted'), 'class' => 'hosting-error'],
  ];
  $status_info = $status_map[$status] ?? ['label' => t('Unknown'), 'class' => ''];
  $info_items[] = [
    'label' => t('Status'),
    'value' => ['#markup' => '<span class="' . $status_info['class'] . '">' . $status_info['label'] . '</span>'],
    'weight' => -5,
  ];

  $build['info'] = [
    '#theme' => 'hosting_info_table',
    '#items' => $info_items,
    '#attributes' => ['id' => 'hosting-platform-info'],
    '#weight' => -5,
  ];

  // Task table.
  $task_resolver = \Drupal::service('hosting.task_availability_resolver');
  $build['tasks_view'] = $task_resolver->buildTaskTable($entity);
  $build['tasks_view']['#weight'] = 9;

  // Attach task table AJAX refresh.
  $build['#attached']['library'][] = 'hosting_task/task-table-refresh';
  $build['#attached']['drupalSettings']['hostingTaskTable']['refreshUrl'] = \Drupal\Core\Url::fromRoute('hosting_task.refresh.task_table', [
    'entity_type_id' => 'hosting_platform',
    'entity_id' => $entity->id(),
  ])->toString();

  // Sites on this platform.
  $site_storage = \Drupal::entityTypeManager()->getStorage('hosting_site');
  $site_query = \Drupal::entityQuery('hosting_site')
    ->condition('platform', $entity->id())
    ->sort('domain', 'ASC')
    ->range(0, 10)
    ->accessCheck(TRUE);
  $site_ids = $site_query->execute();
  $site_items = [];
  $site_tags = [];
  if ($site_ids) {
    $sites = $site_storage->loadMultiple($site_ids);
    foreach ($sites as $site) {
      $site_items[] = [
        '#type' => 'link',
        '#title' => $site->label(),
        '#url' => $site->toUrl(),
      ];
      $site_tags = \Drupal\Core\Cache\Cache::mergeTags($site_tags, $site->getCacheTags());
    }
  }

  // Sidebar: recent tasks + sites list + navigation.
  $context_storage = \Drupal::entityTypeManager()->getStorage('hosting_context');
  $context_records = $context_storage->loadByProperties([
    'entity_type' => 'hosting_platform',
    'entity_id' => $entity->id(),
  ]);
  $context_record = $context_records ? reset($context_records) : NULL;
  $context_name = $context_record ? (string) $context_record->get('context_name')->value : '';

  $task_items = [];
  $task_tags = [];
  if ($context_name !== '') {
    $task_query = \Drupal::entityQuery('hosting_task')
      ->condition('context_name', $context_name)
      ->sort('id', 'DESC')
      ->range(0, 5)
      ->accessCheck(TRUE);
    $task_ids = $task_query->execute();
    if ($task_ids) {
      $task_storage = \Drupal::entityTypeManager()->getStorage('hosting_task');
      $tasks = $task_storage->loadMultiple($task_ids);
      foreach ($tasks as $task) {
        $t_status = (string) $task->get('status')->value;
        $task_items[] = [
          '#type' => 'container',
          '#attributes' => [
            'class' => ['hosting-task-item', 'hosting-task-item--' . \Drupal\Component\Utility\Html::getClass($t_status)],
          ],
          'title' => [
            '#type' => 'link',
            '#title' => $task->label(),
            '#url' => $task->toUrl(),
          ],
          'status' => [
            '#type' => 'html_tag',
            '#tag' => 'span',
            '#value' => $t_status,
            '#attributes' => ['class' => ['hosting-task-status']],
          ],
        ];
        $task_tags = \Drupal\Core\Cache\Cache::mergeTags($task_tags, $task->getCacheTags());
      }
    }
  }

  $build['hosting_sidebar'] = [
    '#theme' => 'hosting_platform_sidebar',
    '#content' => [
      'task_queue' => [
        '#theme' => 'hosting_platform_task_queue',
        '#title' => t('Recent tasks'),
        '#list' => [
          '#theme' => 'item_list',
          '#items' => $task_items,
          '#empty' => t('No tasks available.'),
          '#attributes' => ['class' => ['hosting-task-queue']],
        ],
        '#attributes' => ['class' => ['hosting-panel', 'hosting-panel--task-queue']],
      ],
      'sites_list' => [
        '#theme' => 'hosting_platform_sites_list',
        '#title' => t('Sites on this platform'),
        '#list' => [
          '#theme' => 'item_list',
          '#items' => $site_items,
          '#empty' => t('No sites on this platform.'),
          '#attributes' => ['class' => ['hosting-sites-list']],
        ],
        '#attributes' => ['class' => ['hosting-panel', 'hosting-panel--sites-list']],
      ],
      'navigation' => [
        '#theme' => 'hosting_platform_navigation',
        '#title' => t('Navigation'),
        '#list' => [
          '#theme' => 'item_list',
          '#items' => [
            ['#type' => 'link', '#title' => t('All tasks'), '#url' => \Drupal\Core\Url::fromRoute('entity.hosting_task.collection')],
            ['#type' => 'link', '#title' => t('Edit platform'), '#url' => $entity->toUrl('edit-form')],
            ['#type' => 'link', '#title' => t('All platforms'), '#url' => \Drupal\Core\Url::fromRoute('entity.hosting_platform.collection')],
            ['#type' => 'link', '#title' => t('All sites'), '#url' => \Drupal\Core\Url::fromRoute('entity.hosting_site.collection')],
            ['#type' => 'link', '#title' => t('All servers'), '#url' => \Drupal\Core\Url::fromRoute('entity.hosting_server.collection')],
          ],
          '#attributes' => ['class' => ['hosting-navigation']],
        ],
        '#attributes' => ['class' => ['hosting-panel', 'hosting-panel--navigation']],
      ],
    ],
    '#attributes' => ['class' => ['hosting-sidebar']],
    '#weight' => 60,
  ];

  $build['#attributes']['class'][] = 'hosting-platform-view';

  $all_tags = \Drupal\Core\Cache\Cache::mergeTags($task_tags, $site_tags);
  if ($all_tags) {
    $build['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($build['#cache']['tags'] ?? [], $all_tags);
  }
}

/**
 * Implements hook_theme_suggestions_HOOK().
 */
function hosting_platform_theme_suggestions_hosting_platform(array $variables) {
  $suggestions = [];
  if (!empty($variables['entity'])) {
    $entity = $variables['entity'];
    $suggestions[] = 'hosting_platform__' . $entity->id();
    if (isset($variables['view_mode'])) {
      $suggestions[] = 'hosting_platform__' . $variables['view_mode'];
    }
  }
  return $suggestions;
}

