}

/**
 * Helper function to get platforms that haven't been deleted.
 *
 * @param int $web_server
 *   Node ID of the server hosting this platform.
 *   Default 0 indicates any web_server.
 * @param boolean $enabled_only
 *   Set to TRUE to return only enabled platforms. Defaults to FALSE.
 * @return
 *   The list of platforms.
 * @todo
 *   Convert this to an EntityFieldQuery with conditions & tags (for JOINs).
 *   Tags will be unnecessary in D8 as JOINs are natively supported. See
 *   hosting_get_site_by_url() for an example of how to do this.
 */
function _hosting_get_platforms($web_server = 0, $enabled_only = FALSE) {
  $return = array();

  // Set the query parameters.
  $parameters = array(
    ':hstatus' => HOSTING_PLATFORM_DELETED,
    ':web_server' => $web_server,
  );

  // Add another filter to return only enabled sites is requested.
  $enabled_text = $enabled_only ? "AND status <> :disabled" : '';
  if ($enabled_only) {
    $parameters[':disabled'] = HOSTING_PLATFORM_LOCKED;
  }

  $result = \Drupal::database()->query("SELECT id, label
                      FROM {hosting_platform}
                      WHERE status <> :hstatus
                      AND (web_server = :web_server OR :web_server = 0)
                      $enabled_text
                      ORDER BY label",
                      $parameters
                   );
  while ($platform = $result->fetch()) {
    $return[$platform->id] = $platform->label;
  }
  return $return;
}

/**
 * Helper function to get platforms that haven't been deleted or locked.
 *
 * @deprecated
 *   _hosting_get_platforms() now has an $enabled_only parameter.
 */
function _hosting_get_enabled_platforms() {
  return _hosting_get_platforms(0, TRUE);
}

/**
 * Helper function to get platforms that have been locked.
 */
function _hosting_get_locked_platforms() {
  $return = array();
  $result = \Drupal::database()->query("SELECT id, label
                      FROM {hosting_platform}
                      WHERE status = :hstatus
                      ORDER BY label",
                      array(
                        ':hstatus' => HOSTING_PLATFORM_LOCKED,
                      )
                   );
  while ($platform = $result->fetch()) {
    $return[$platform->id] = $platform->label;
  }
  return $return;
}

/**
 * Helper function to check if a platform is locked.
 */
function _hosting_platform_is_locked($node) {
  if (in_array($node, array_keys(_hosting_get_locked_platforms()))) {
    return TRUE;
  }
  else {
    return FALSE;
  }
}

/**
 * Legacy wrapper to build a hosting_platform form section.
 */
function hosting_platform_form(&$node, &$form_state) {
  if (!$node instanceof \Drupal\Core\Entity\ContentEntityInterface || $node->getEntityTypeId() !== 'hosting_platform') {
    $node = \Drupal::entityTypeManager()->getStorage('hosting_platform')->create();
  }
  $form['#entity'] = $node;
  $form['#node'] = $node;
  if (is_object($form_state) && method_exists($form_state, 'set')) {
    $form_state->set('node', $node);
  }
  else {
    $form_state['node'] = $node;
  }

  $form_display = \Drupal::service('entity_display.repository')->getFormDisplay('hosting_platform', 'default');
  $form_display->buildForm($node, $form, $form_state);
  hosting_platform_apply_form_overrides($form, $form_state, $node);

  return $form;
}

/**
 * Fetch a form widget element for a field.
 */
function &hosting_platform_form_get_widget_element(array &$form, $field_name, array $value_keys) {
  $null = NULL;
  if (!isset($form[$field_name]['widget'][0])) {
    return $null;
  }
  foreach ($value_keys as $key) {
    if (isset($form[$field_name]['widget'][0][$key])) {
      return $form[$field_name]['widget'][0][$key];
    }
  }
  return $null;
}

/**
 * Apply dynamic overrides to the platform form.
 */
function hosting_platform_apply_form_overrides(array &$form, &$form_state, $node) {
  if (!$node instanceof \Drupal\Core\Entity\ContentEntityInterface || $node->getEntityTypeId() !== 'hosting_platform') {
    return;
  }

  if (isset($form['actions']['delete']) && hosting_entity_status($node, 'platform') !== HOSTING_PLATFORM_DELETED) {
    $form['actions']['delete']['#type'] = 'hidden';
  }

  $platform_id = hosting_entity_id($node);
  $verified = $node->hasField('verified') ? (int) $node->get('verified')->value : (isset($node->verified) ? (int) $node->verified : 0);
  $editable = (!$platform_id || !$verified);

  // Get deployment method - for existing platforms, always treat as manual
  $deployment_method = 'manual';
  if (!$platform_id && isset($form['deployment_method'])) {
    // Only show deployment method selector for new platforms
    $form['deployment_method']['widget']['#weight'] = -10;
  }
  elseif ($platform_id) {
    // Hide deployment method for existing platforms
    if (isset($form['deployment_method'])) {
      $form['deployment_method']['#access'] = FALSE;
    }
    if (isset($form['repository_url'])) {
      $form['repository_url']['#access'] = FALSE;
    }
  }

  $base_path = \Drupal::config('hosting_platform.settings')->get('hosting_platform_base_path') ?? '/var/aegir/platforms/';
  $field_prefix = $base_path;
  $default_path = '';
  $publish_value = $node->hasField('publish_path') ? $node->get('publish_path')->value : (isset($node->publish_path) ? $node->publish_path : '');
  if ($publish_value) {
    if (strpos($publish_value, $base_path) === 0) {
      $default_path = substr($publish_value, strlen($base_path));
    }
    else {
      $default_path = $publish_value;
      $field_prefix = '';
    }
  }

  $publish_element = &hosting_platform_form_get_widget_element($form, 'publish_path', array('value'));
  if ($publish_element !== NULL) {
    $publish_element['#type'] = 'textfield';
    $publish_element['#size'] = 40;
    $publish_element['#maxlength'] = 255;
    $publish_element['#default_value'] = $default_path;
    $publish_element['#field_prefix'] = $field_prefix;
    if ($editable) {
      $publish_element['#element_validate'][] = 'hosting_platform_form_publish_path_validate';
    }
    else {
      $publish_element['#disabled'] = TRUE;
    }
    $form['publish_path']['#weight'] = -5;
  }

  $servers = hosting_get_servers('http');
  $web_server_element = &hosting_platform_form_get_widget_element($form, 'web_server', array('target_id'));
  if ($web_server_element !== NULL) {
    if (count($servers) > 1) {
      $default_server = $node->hasField('web_server') ? $node->get('web_server')->target_id : (isset($node->web_server) ? $node->web_server : NULL);
      if (!$default_server || !isset($servers[$default_server])) {
        $default_server = HOSTING_DEFAULT_WEB_SERVER;
        if (!isset($servers[$default_server])) {
          $default_server = key($servers);
        }
      }
      $web_server_element['#options'] = $servers;
      $web_server_element['#default_value'] = $default_server;
      $web_server_element['#type'] = 'radios';
    }
    else {
      reset($servers);
      $default_server = key($servers);
      $web_server_element['#type'] = 'hidden';
      $web_server_element['#value'] = $default_server;
      $web_server_element['#default_value'] = $default_server;
    }
  }

  foreach (array('verified', 'platform_status') as $extra_attribute) {
    if (!isset($form[$extra_attribute])) {
      $form[$extra_attribute] = array(
        '#type' => 'value',
        '#value' => isset($node->$extra_attribute) ? $node->$extra_attribute : NULL,
      );
    }
  }
}

/**
 * Resolve an error name for a platform field widget.
 */
function hosting_platform_form_error_name(array $form, $field_name, array $value_keys) {
  if (isset($form[$field_name]['widget'][0])) {
    foreach ($value_keys as $key) {
      if (isset($form[$field_name]['widget'][0][$key]['#parents'])) {
        return implode('][', $form[$field_name]['widget'][0][$key]['#parents']);
      }
    }
  }
  return $field_name;
}

/**
 * Hide the delete button on platform nodes.
 */
function hosting_platform_form_alter(&$form, &$form_state, $form_id) {
  switch ($form_id) {
    case 'hosting_platform_form':
    case 'hosting_platform_add_form':
    case 'hosting_platform_edit_form':
      // Remove delete button from platform edit form,
      // unless the platform's already been deleted via the Delete task.
      $node = $form['#entity'] ?? $form['#node'] ?? NULL;
      if (isset($form['actions']['delete']) && $node && hosting_entity_status($node, 'platform') !== HOSTING_PLATFORM_DELETED) {
        $form['actions']['delete']['#type'] = 'hidden';
      }
      break;
    case 'hosting_settings':
      $config = \Drupal::config('hosting_platform.settings');
      $form['hosting_platform_base_path'] = array(
        '#type' => 'textfield',
        '#title' => t('Platform base path'),
        '#description' => t('The base path for your platforms, i.e. /var/aegir/platforms/'),
        '#default_value' => $config->get('hosting_platform_base_path') ?? '/var/aegir/platforms/',
      );
      break;
  }
}

/**
 * Implements hook_insert().
 */
function hosting_platform_insert($node) {
  $platform_id = hosting_entity_id($node);
  if (!isset($node->no_verify)) {
    hosting_add_task($platform_id, 'verify');
  }
  \Drupal::database()->update('hosting_platform')
    ->fields(array(
      'publish_path' => hosting_path_normalize($node->publish_path),
      'verified' => isset($node->verified) ? $node->verified : 0,
      'web_server' => $node->web_server,
      'status' => isset($node->platform_status) ? $node->platform_status : (isset($node->status) ? $node->status : 0),
    ))
    ->condition('id', $platform_id)
    ->execute();
  if (!isset($node->old_vid)) {
    hosting_context_register(hosting_entity_id($node), 'platform_' . preg_replace("/[!\W]/", "", hosting_entity_label($node)));
  }
}

/**
 * Implements hook_update().
 *
 * As an existing node is being updated in the database, we need to do our own
 * database updates.
 */
function hosting_platform_update($node) {
  // If this is a new node or we're adding a new revision.
  if (!empty($node->revision)) {
    hosting_platform_insert($node);
  }
  else {
    if ($node->platform_status == HOSTING_PLATFORM_DELETED) {
      $node->no_verify = TRUE;
    }
    \Drupal::database()->update('hosting_platform')
      ->fields(array(
        'publish_path' => hosting_path_normalize($node->publish_path),
        'web_server' => $node->web_server,
        'verified' => $node->verified,
        'status' => $node->platform_status,
      ))
      ->condition('id', hosting_entity_id($node))
      ->execute();
  }
  if (!isset($node->no_verify)) {
    hosting_add_task(hosting_entity_id($node), 'verify');
  }
}

/**
 * Implements hook_delete().
 */
function hosting_platform_delete($node) {
  if (!$node instanceof \Drupal\Core\Entity\EntityInterface || $node->getEntityTypeId() !== 'hosting_platform') {
    return;
  }
  $platform_id = $node->id();
  \Drupal::database()->delete('hosting_package_instance')
    ->condition('rid', $platform_id)
    ->execute();
  hosting_context_delete($platform_id);
  hosting_task_delete_related_tasks($platform_id);
  $site_ids = \Drupal::database()->query("SELECT id FROM {hosting_site} WHERE platform = :platform", array(':platform' => $platform_id))->fetchCol();
  if ($site_ids) {
    $storage = \Drupal::entityTypeManager()->getStorage('hosting_site');
    $storage->delete($storage->loadMultiple($site_ids));
  }
}

/**
 * Element validator for publish_path. Only run when field is editable.
 */
function hosting_platform_form_publish_path_validate($element, \Drupal\Core\Form\FormStateInterface $form_state, &$form) {
  $platform_base_path = \Drupal::config('hosting_platform.settings')->get('hosting_platform_base_path') ?? '/var/aegir/platforms/';
  
  // If platform path doesn't already begin with the basepath and does not begin with a "/", append default base path.
  if (strpos($element['#value'], $platform_base_path) !== 0 && strpos($element['#value'], '/') !== 0) {
    $full_path = hosting_path_normalize($platform_base_path . '/' . $element['#value']);
    $form_state->setValueForElement($element, $full_path);
  }
}

/**
 * Implements hook_validate().
 */
function hosting_platform_validate($node, &$form, $form_state = NULL) {
  $set_error = function ($name, $message) use ($form_state) {
    if ($form_state instanceof \Drupal\Core\Form\FormStateInterface) {
      $form_state->setErrorByName($name, $message);
    }
    else {
      \Drupal::messenger()->addError($message);
    }
  };
  if ($node->op != t('Delete')) {

    // Make sure the platform name is unique, to avoid context clashes.
    $sql = "SELECT label as name
              FROM {hosting_platform}
             WHERE label = :title
               AND status >= :status";
    $args = array(
      ':title' => hosting_entity_label($node),
      ':status' => HOSTING_PLATFORM_QUEUED,
    );
    $platform_id = hosting_entity_id($node);
    if (!is_null($platform_id)) {
      $sql .= " AND id <> :id";
      $args[':id'] = $platform_id;
    }
    $result = \Drupal::database()->query($sql, $args)->fetch();
    if ($result) {
      $set_error(hosting_platform_form_error_name($form, 'label', array('value')),
        t('Platform name %name is already defined. Platform names must be unique across all servers.',
        array('%name' => $result->name))
      );
    }

    // Make sure the path is unique. Remote servers can't have the same path to
    // a platform that is in use by another server.
    $exists = hosting_platform_path_exists($node->publish_path, hosting_entity_id($node));
    if ($exists) {
      // Ensure that the visitor has access to view the other platform.
      $other_platform = \Drupal::entityTypeManager()->getStorage('hosting_platform')->load($exists->id);
      if ($other_platform && $other_platform->access('view')) {
        $set_error(hosting_platform_form_error_name($form, 'publish_path', array('value')), t('Publish path is already in use by platform: <a href="@link" target="_blank">%name</a>. Platform paths must be unique across all servers.',
          array(
            '%name' => $other_platform->label(),
            '@link' => $other_platform->toUrl('canonical')->toString(),
          )));
      }
      else {
        $set_error(hosting_platform_form_error_name($form, 'publish_path', array('value')), t('Publish path is already in use by another platform. Platform paths must be unique across all servers.'));
      }
    }

    if (is_null($node->web_server)) {
      $set_error(hosting_platform_form_error_name($form, 'web_server', array('target_id')), t('Platform needs to be associated with a webserver. Make sure you have a verified webserver on this Aegir install!'));
    }
  }
}

/**
 * Determine whether a given path has already been used with another platform.
 *
 * @param string $path
 *   The path to check.
 * @param int $exclude_nid
 *   Optionally exclude this platform from the check.
 *
 * @return mixed
 *   Either a result object or FALSE.
 *   The result object will contain the id and name of the platform that uses
 *   the path.
 */
function hosting_platform_path_exists($path, $exclude_nid = NULL) {
  $query = \Drupal::database()->select('hosting_platform', 'h')
    ->condition('h.publish_path', hosting_path_normalize($path))
    ->condition('h.status', HOSTING_PLATFORM_LOCKED, '>=');
  $query->addField('h', 'label', 'name');
  $query->addField('h', 'id');
  if (!is_null($exclude_nid)) {
    $query->condition('h.id', $exclude_nid, '<>');
  }
  return $query->execute()->fetch();
}

/**
 * Implements hook_load().
 */
function hosting_platform_load($nodes) {
  foreach ($nodes as $entity_id => &$node) {
    $platform_id = hosting_entity_id($node);
    $additions = \Drupal::database()->query('SELECT publish_path, verified, web_server, status AS platform_status FROM {hosting_platform} WHERE id = :id', array(':id' => $platform_id))->fetch();
    // Avoid PHP 5.4 warning when platform doesn't exist yet.
    // See: https://drupal.org/node/1940378
    $additions = $additions ? $additions : new stdClass();
    $iid = \Drupal::database()->query("SELECT iid
                     FROM {hosting_package_instance} i
                     LEFT JOIN {hosting_package} p
                     ON p.id=i.package_id
                     WHERE p.package_type = :package_type
                     AND i.rid = :rid",
                     array(
                       ':package_type' => 'platform',
                       ':rid' => $platform_id,
                     )
                   )->fetchField();

    $additions->release = hosting_package_instance_load($iid);
    $additions->profiles = hosting_get_profiles($platform_id, 'short_name');

    foreach ($additions as $property => &$value) {
      $node->$property = is_numeric($value) ? (int) $value : $value;
    }
  }
}

/**
 * Return client IDs with access to a platform.
 *
 * @param object $platform
 *   The platform entity or legacy object.
 *
 * @return int[]
 *   Client entity IDs with access to this platform.
 */
function hosting_platform_client_ids($platform) {
  if ($platform instanceof \Drupal\Core\Entity\EntityInterface && $platform->getEntityTypeId() === 'hosting_platform' && $platform->hasField('clients')) {
    $values = $platform->get('clients')->getValue();
    if (!empty($values)) {
      return array_values(array_map(static function ($item) {
        return (int) $item['target_id'];
      }, $values));
    }
    return array();
  }

  $platform_id = hosting_entity_id($platform);
  if (!$platform_id) {
    return array();
  }

  $result = \Drupal::database()->query("SELECT cid FROM {hosting_platform_client_access} WHERE pid = :pid", array(':pid' => $platform_id));
  $client_ids = array();
  foreach ($result as $record) {
    $client_ids[] = (int) $record->cid;
  }

  return $client_ids;
}

/**
 * Menu wildcard loader callback.
 *
 * Loads a hosting_platform entity.
 * @see hosting_task_menu()
 *
 * @param int $arg
 *   Platform entity ID
 *
 * @return bool|object
 *   A platforn node object or FALSE.
 */
function hosting_platform_wildcard_load($arg) {
  if (!is_numeric($arg)) {
    return FALSE;
  }
  return \Drupal::entityTypeManager()->getStorage('hosting_platform')->load($arg) ?: FALSE;
}

/**
 * Implements hook_view().
 */
function hosting_platform_view($node, $view_mode, $langcode = NULL) {
  hosting_set_breadcrumb($node);

  $node->content['info'] = array(
    '#prefix' => '<div id="hosting-platform-info" class="hosting-info-list">',
    '#suffix' => '</div>',
  );

  $node->content['info']['verified'] = array(
    '#type' => 'item',
    '#title' => t('Verified'),
    '#markup' => hosting_format_interval($node->verified),
    '#weight' => -10,
  );

  $node->content['info']['publish_path'] = array(
    '#type' => 'item',
    '#title' => t('Publish path'),
    '#markup' => \Drupal\Component\Utility\Xss::filter($node->publish_path),
    '#weight' => -8,
  );

  $node->content['info']['web_server'] = array(
    '#type' => 'item',
    '#title' => t('Web server'),
    '#markup' => _hosting_node_link($node->web_server),
    '#weight' => -7,
  );
  $node->content['info']['status'] = array(
    '#type' => 'item',
    '#title' => t('Status'),
    '#markup' => _hosting_platform_status($node->platform_status),
  );

  if ($node->release) {
    $release = sprintf("%s %s", $node->release->title, $node->release->version);
    $node->content['info']['release'] = array(
      '#type' => 'item',
      '#title' => t('Release'),
      '#markup' => _hosting_node_link(hosting_entity_id($node->release), $release),
      '#weight' => -6,
    );
  }

  // Task list.
  if ($view_mode == 'full' && hosting_entity_id($node)) {
    $tasks_view = hosting_task_table($node);
    $tasks_view['#prefix'] = '<div id="hosting-task-list">';
    $tasks_view['#suffix'] = '</div>';
    $tasks_view['#weight'] = 9;
    $node->content['tasks_view'] = $tasks_view;
    $node->content['#attached']['library'][] = 'hosting_task/task';
  }

  return $node;
}

