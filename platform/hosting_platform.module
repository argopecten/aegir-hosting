/**
 * Define the classes that correspond to the platform status.
 */
function _hosting_platform_list_class($status) {
  static $labels;
  $labels = _hosting_platform_status_codes();
  if (is_object($status)) {
    $value = $status->platform_status ?? $status->status ?? HOSTING_PLATFORM_QUEUED;
    return $labels[$value]['class'];
  }
  return $labels[$status]['class'];
}

/**
 * Implements hook_hosting_task_guarded_nodes().
 */
function hosting_platform_hosting_task_guarded_nodes() {
  return array(
    hosting_get_hostmaster_platform_id()
  );
}

/**
 * Implements hook_hosting_TASK_OBJECT_context_options().
 */
function hosting_hosting_platform_context_options(&$task) {
  $task->context_options['server'] = '@server_master';
  $web_server_id = $task->ref instanceof \Drupal\Core\Entity\ContentEntityInterface ? $task->ref->get('web_server')->target_id : $task->ref->web_server;
  $task->context_options['web_server'] = hosting_context_name($web_server_id);
  // Trim the path so we dont pass extra spaces.
  $publish_path = $task->ref instanceof \Drupal\Core\Entity\ContentEntityInterface ? $task->ref->get('publish_path')->value : $task->ref->publish_path;
  $task->context_options['root'] = trim($publish_path ?? '', " ");
  $php_path = $task->ref instanceof \Drupal\Core\Entity\ContentEntityInterface ? $task->ref->get('php_path')->value : ($task->ref->php_path ?? NULL);
  $task->context_options['php_path'] = $php_path ? trim($php_path, " ") : NULL;
}

/**
 * Implements hook_drush_context_import().
 */
function hosting_platform_drush_context_import($context, &$node) {
  if ($context->type == 'platform') {
    $label = str_replace('platform_', '', trim($context->name, '@'));
    if ($node instanceof \Drupal\Core\Entity\ContentEntityInterface) {
      if (!$node->label()) {
        $node->set('label', $label);
      }
      $node->set('web_server', hosting_context_entity_id($context->web_server));
      $node->set('publish_path', $context->root);
      if (isset($context->php_path)) {
        $node->set('php_path', $context->php_path);
      }
    }
    else {
      if (!isset($node->label)) {
        $node->label = $label;
      }
      $node->web_server = hosting_context_entity_id($context->web_server);
      $node->publish_path = $context->root;
      if (isset($context->php_path)) {
        $node->php_path = $context->php_path;
      }
    }
  }
}

/**
 * Implements hook_post_hosting_verify_task().
 *
 * Sets the platform verified timestamp, to discren when it was verified.
 * Imports all the profiles and modules into package and package release nodes.
 */
function hosting_platform_post_hosting_verify_task($task, $data) {
  $node = $task->ref;
  if ($node instanceof \Drupal\Core\Entity\ContentEntityInterface && $node->getEntityTypeId() === 'hosting_platform') {
    $context = $data['context'];
    $packages = $context['packages'];

    // Lock platforms by default.
    if ((int) $node->get('verified')->value === 0 && (\Drupal::config('hosting.settings')->get('hosting_lock_platforms_by_default') ?? FALSE)) {
      $node->set('status', HOSTING_PLATFORM_LOCKED);
    }

    // Set verified flag on platform, to let it know it has been checked.
    $node->set('verified', REQUEST_TIME);

    /**
     * If we are verifying a Locked platform (i.e if the publish_path has changed),
     * don't reset the status to Enabled. We don't need to check whether a platform
     * is deleted here for the same reason, because we don't allow a deleted platform
     * to be reverified.
     */
    if (hosting_entity_status($node, 'platform') != HOSTING_PLATFORM_LOCKED) {
      $node->set('status', HOSTING_PLATFORM_ENABLED);
    }
    $node->no_verify = TRUE;
    // Save the platform being verified.
    $node->save();

    hosting_package_sync($packages['base']);
    hosting_package_sync($packages['sites-all']);
    hosting_package_instance_sync($node->id(), 'platform', $packages['base'], $packages['sites-all']);

    $platform_release = hosting_package_instance_load(array(
      'i.rid' => $node->id(),
      'p.package_type' => 'platform',
    ));
    if (!empty($platform_release->version) && !hosting_platform_version_supported($platform_release->version)) {
      $major = hosting_platform_major_version($platform_release->version);
      hosting_log(t('Platform @name uses Drupal @version, which is below the minimum supported major version (@min).', [
        '@name' => $node->label(),
        '@version' => $platform_release->version,
        '@min' => HOSTING_PLATFORM_MINIMUM_DRUPAL_MAJOR,
      ]), 'error', [], 'hosting_platform');
      $node->set('status', HOSTING_PLATFORM_LOCKED);
      $node->set('verified', 0);
      $node->no_verify = TRUE;
      $node->save();
      return;
    }

    foreach ($context['profiles'] as $profile) {
      hosting_package_sync($packages['profiles'][$profile]);
      $instance = hosting_package_instance_load(
        array('p.short_name' => $profile, 'i.rid' => $node->id(), 'p.package_type' => 'profile'));
      hosting_package_instance_sync($instance->iid, $instance->package_type, $packages['base'], $packages['profiles'][$profile], $packages['sites-all']);

      // @todo : package instances of modules to profiles. <-- huh?
    }

    // If configured to do so, import all sites found on this platform.
    if (\Drupal::config('hosting.settings')->get('hosting_platform_automatic_site_import') ?? TRUE) {
      foreach ($context['sites'] as $url) {
        if (hosting_domain_allowed($url)) {
          // Import any sites that have not been created yet.
          $site = \Drupal::entityTypeManager()->getStorage('hosting_site')->create(array(
            'label' => $url,
            'status' => HOSTING_SITE_QUEUED,
            'platform' => $node->id(),
            'client' => HOSTING_DEFAULT_CLIENT,
            'db_server' => HOSTING_DEFAULT_DB_SERVER,
          ));
          $site->import = TRUE;
          $site->save();
          hosting_log(t('Imported existing site @domain', ['@domain' => _hosting_node_link($site->id())]), 'notice', [], 'hosting_platform');
          hosting_package_instance_sync($site->id(), 'site', $packages['base']);
        }
      }
    }
  }

  // When a server is verified, queue up a verify task for every platform.
  if ($task->ref instanceof \Drupal\Core\Entity\ContentEntityInterface && $task->ref->getEntityTypeId() === 'hosting_server') {
    $platform_ids = \Drupal::entityTypeManager()->getStorage('hosting_platform')->getQuery()
      ->condition('status', HOSTING_PLATFORM_DELETED, '<>')
      ->condition('web_server', $task->ref->id())
      ->execute();
    foreach ($platform_ids as $platform_id) {
      hosting_add_task($platform_id, 'verify');
    }
  }
}

/**
 * Implements hook_hosting_post_delete().
 */
function hosting_platform_post_hosting_delete_task($task, $data) {
  if ($task->ref instanceof \Drupal\Core\Entity\ContentEntityInterface && $task->ref->getEntityTypeId() === 'hosting_platform') {
    $task->ref->set('status', HOSTING_PLATFORM_DELETED);
    $task->ref->no_verify = TRUE;
    $task->ref->save();
    hosting_context_delete($task->ref->id());
  }
  \Drupal::database()->delete('hosting_platform_client_access')
    ->condition('pid', hosting_entity_id($task->ref))
    ->execute();
  // Clean up package instances.
  hosting_package_instance_sync($task->ref->id(), 'platform');
}

/**
 * Implements hook_post_hosting_lock_task().
 */
function hosting_platform_post_hosting_lock_task($task, $data) {
  if ($task->ref instanceof \Drupal\Core\Entity\ContentEntityInterface && $task->ref->getEntityTypeId() === 'hosting_platform') {
    $task->ref->set('status', HOSTING_PLATFORM_LOCKED);
    $task->ref->no_verify = TRUE;
    $task->ref->save();
  }
}

/**
 * Implements hook_post_hosting_unlock_task().
 */
function hosting_platform_post_hosting_unlock_task($task, $data) {
  if ($task->ref instanceof \Drupal\Core\Entity\ContentEntityInterface && $task->ref->getEntityTypeId() === 'hosting_platform') {
    $task->ref->set('status', HOSTING_PLATFORM_ENABLED);
    $task->ref->no_verify = TRUE;
    $task->ref->save();
  }
}
