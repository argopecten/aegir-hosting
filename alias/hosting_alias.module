<?php
/**
 * @file
 * Allow sites to have domain aliases that they can be accessed with.
 */

/**
 * An alias of this type is a custom, user generated one.
 */
define('HOSTING_ALIAS_CUSTOM', 0);

/**
 * An alias of this type is an automatically generated one.
 *
 * @see hosting_alias_automatic_aliases()
 */
define('HOSTING_ALIAS_AUTOMATIC', 1);

/**
 * Implements hook_help().
 */
function hosting_alias_help($path, $arg) {
  switch ($path) {
    case 'admin/hosting/aliases':
      $output = t('Site aliases allow you to let sites be available through multiple domain addresses.<br />The most common use of this functionality is to provide automatic aliasing for www.mysite.com and mysite.com variants of the domain name.<br />');
      $output .= t('This module will also allow you to provide a "temporary url" that sites will always be accessible from, in case of DNS problems.<br />');
      $output .= t('Settings made here do not take effect automatically for existing sites.<br />');
      return $output;
  }

}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function hosting_alias_form_hosting_site_form_alter(&$form, &$form_state, $form_id) {
  return hosting_alias_site_form_alter($form, $form_state);
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function hosting_alias_form_hosting_site_add_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  return hosting_alias_site_form_alter($form, $form_state);
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function hosting_alias_form_hosting_site_edit_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  return hosting_alias_site_form_alter($form, $form_state);
}

/**
 * Apply alias widgets to site forms.
 */
function hosting_alias_site_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  if (\Drupal::currentUser()->hasPermission('create site aliases')) {
    $form['#attached']['library'][] = 'hosting_alias/alias_form';
    $form['#validate'][] = 'hosting_alias_site_form_validate';
    hosting_alias_form_data($form, $form_state);
  }
}

/**
 * Validation handler for site form.
 *
 * Makes sure aliases are not more than HOSTING_MAX_ALIAS_LENGTH characters.
 */
function hosting_alias_site_form_validate($form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $aliases = array_filter((array) $form_state->getValue('aliases'));
  $form_state->setValue('aliases', $aliases);
  foreach ($aliases as $key => $alias) {
    $entity = $form['#entity'] ?? $form['#node'] ?? ($form_state->get('node') ?? NULL);
    hosting_alias_validate_alias($entity, $alias, $key, $form_state);
  }
}

/**
 * Alter the node form for a site to add the aliases and redirection items.
 *
 * @param array $form
 *   The form to alter, should come from hook_form_alter().
 * @param array $form_state
 *   A keyed array containing the current state of the form.
 */
function hosting_alias_form_data(&$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $entity = $form['#entity'] ?? $form['#node'] ?? NULL;

  // List the automatic aliasses first.
  $automatic_aliases = hosting_alias_get_aliases($entity, HOSTING_ALIAS_AUTOMATIC);
  if (count($automatic_aliases)) {
    foreach ($automatic_aliases as $link) {
      $links[] = \Drupal\Core\Link::fromTextAndUrl($link, \Drupal\Core\Url::fromUri('http://' . $link))->toString();
    }
    $form['aliases_automatic'] = array(
      '#type' => 'item',
      '#title' => t('Automatic domain aliases'),
      '#markup' => implode(', ', $links),
      '#weight' => 10,
    );
  }

  // Add a wrapper for the aliases and more button.
  $form['aliases_wrapper'] = array(
    '#tree' => FALSE,
    '#title' => t('Domain Aliases'),
    '#type' => 'fieldset',
    '#prefix' => '<div class="clear-block" id="hosting-aliases-wrapper">',
    '#suffix' => '</div>',
  );
  $form['aliases_wrapper']['aliases'] = array(
    '#prefix' => '<div id="hosting-aliases"><label>' . t('Domain Aliases') . '</label>',
    '#suffix' => '</div>',
    '#tree' => TRUE,
   // '#theme' => 'hosting_alias_form',
  );

  // Get the list of existing aliases, either from form_state or the node.
  $input = $form_state->getUserInput();
  if (isset($input['aliases'])) {
    $aliases = array_filter($input['aliases']);
  }
  elseif ($entity && isset($entity->aliases)) {
    $aliases = array_filter($entity->aliases);
  }
  else {
    $aliases = array();
  }

  // Add alias textfields.
  for ($delta = 0; $delta <= count($aliases); $delta++) {
    $form['aliases_wrapper']['aliases'][$delta] = array(
      '#type' => 'textfield',
      '#default_value' => isset($aliases[$delta]) ? $aliases[$delta] : '',
    );
  }

  // "Add Alias" button.
  $form['aliases_wrapper']['add_alias'] = array(
    '#type' => 'submit',
    '#value' => t('Add an alias'),
    '#description' => t("Click here to add another alias."),
    '#weight' => 1,
    '#submit' => array('hosting_alias_add_alias_submit'),
    '#ajax' => array(
      'callback' => 'hosting_alias_add_alias_callback',
      'wrapper' => 'hosting-aliases-wrapper',
      'method' => 'replace',
      'effect' => 'fade',
    ),
  );

  // Redirection Domain.
  $options = array();
  $options[0] = t('No redirection');
  $site_label = hosting_entity_label($form['#node']);
  if (!empty($site_label)) {
    $options[$site_label] = $site_label;
  }

  $base_options = $options;
  if (!empty($aliases)) {
    $options += array_combine($aliases, $aliases);
  }
  if (!empty($automatic_aliases)) {
    $automatic_options = array_combine($automatic_aliases, $automatic_aliases);
    $options += $automatic_options;
    $base_options += $automatic_options;
  }

  $form['#attached']['drupalSettings']['hosting_alias']['redirectionBaseOptions'] = $base_options;

  $default = isset($form['#node']->redirection) ? $form['#node']->redirection : '';

  $form['aliases_wrapper']['redirection'] = array(
    '#type' => 'select',
    '#title' => t('Redirect all domain aliases to'),
    '#options' => $options,
    '#default_value' => $default,
    '#weight' => -1,
  );
  return $form;
}

/**
 * Callback to handle "Add Alias" button.
 */
function hosting_alias_add_alias_submit($form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $form_state->setRebuild(TRUE);
}

/**
 * Ajax callback for returning multiple alias fields.
 */
function hosting_alias_add_alias_callback($form, \Drupal\Core\Form\FormStateInterface $form_state) {
  return $form['aliases_wrapper'];
}


/**
 * Retrieve a list of aliases for a site.
 *
 * @param Object $node
 *   The site to get the aliases for.
 * @param int $type
 *   Restrict the type of aliases returned, defaults to returning all aliases.
 *   Should be one of:
 *   - HOSTING_ALIAS_CUSTOM
 *   - HOSTING_ALIAS_AUTOMATIC
 *
 * @return array
 *   An array of aliases for the given site.
 */
function hosting_alias_get_aliases($node, $type = NULL) {
  $site_id = hosting_entity_id($node);
  if (!$site_id) {
    return array();
  }
  $alias = array();
  $query = \Drupal::database()->select('hosting_site_alias')
    ->addTag('hosting_alias_get_aliases')
    ->fields('hosting_site_alias', array('alias'))
    ->condition('site_id', $site_id)
    ->orderBy('alias', 'ASC');

  if (!is_null($type)) {
    $query->condition('automatic', $type);
  }

  $result = $query->execute();

  foreach ($result as $obj) {
    $alias[] = $obj->alias;
  }

  $alias = array_unique($alias);

  if (count($alias)) {
    return $alias;
  }
  return array();
}

/**
 * Save stored aliases for a new site.
 *
 * @param Object $node
 *   The node of the site containing the aliases to save.
 */
function hosting_alias_insert($node) {
  $node->aliases = isset($node->aliases) ? $node->aliases : array();
  $aliases = (is_array($node->aliases)) ? $node->aliases : explode("\n", str_replace(",", "\n", $node->aliases));
  $site_id = hosting_entity_id($node);
  $site_label = hosting_entity_label($node) ?? '';
  $automatic = hosting_alias_automatic_aliases(hosting_site_clean_domain($site_label));

  if (!$site_id) {
    return;
  }
  if (empty($aliases) && empty($automatic)) return;

  if (count($aliases)) {
    $aliases = array_unique($aliases);
    foreach ($aliases as $alias) {
      $alias = hosting_site_clean_domain($alias);

      // Only flag custom aliases that aren't automatically generated
      if (in_array($alias, $automatic)) continue;

      $id = \Drupal::database()->insert('hosting_site_alias')
        ->fields(array(
          'site_id' => $site_id,
          'alias' => $alias,
          'automatic' => HOSTING_ALIAS_CUSTOM,
          'redirection' => isset($node->redirection) ? $node->redirection : 0,
        ))
        ->execute();
    }
  }

  if (count($automatic)) {
    foreach ($automatic as $alias) {
      $alias = hosting_site_clean_domain($alias);

      // Only insert valid FQDNs.
      if (!_hosting_valid_fqdn_wildcard($alias)) continue;

      $id = \Drupal::database()->insert('hosting_site_alias')
        ->fields(array(
          'site_id' => $site_id,
          'alias' => $alias,
          'automatic' => HOSTING_ALIAS_AUTOMATIC,
          'redirection' => isset($node->redirection) ? $node->redirection : 0,
        ))
        ->execute();
    }
  }
}

/**
 * Update stored aliases for an existing site.
 *
 * @param Object $node
 *   The node of the site containing the aliases to save.
 */
function hosting_alias_update($node) {
  hosting_alias_delete($node);
  hosting_alias_insert($node);
}

/**
 * Remove the stored aliases for and existing site.
 *
 * @param Object $node
 *   The site node.
 */
function hosting_alias_delete($node) {
  \Drupal::database()->delete('hosting_site_alias')
    ->condition('site_id', hosting_entity_id($node))
    ->execute();
}

/**
 * Implements hook_hosting_site_insert().
 */
function hosting_alias_hosting_site_insert(\Drupal\Core\Entity\EntityInterface $entity) {
  hosting_alias_insert($entity);
}

/**
 * Implements hook_hosting_site_update().
 */
function hosting_alias_hosting_site_update(\Drupal\Core\Entity\EntityInterface $entity) {
  hosting_alias_update($entity);
}

/**
 * Implements hook_hosting_site_delete().
 */
function hosting_alias_hosting_site_delete(\Drupal\Core\Entity\EntityInterface $entity) {
  hosting_alias_delete($entity);
}

/**
 * Ensure that an alias is valid, and not already in use.
 *
 * @param object $site
 *   A Hosting site node.
 * @param string $alias
 *   An alias to have point to the site.
 * @param string $key
 *   The array index of this alias, to set any error on the proper sub-field.
 */
function hosting_alias_validate_alias($site, $alias, $key, $form_state = NULL) {
  $set_error = function ($name, $message) use ($form_state) {
    if ($form_state instanceof \Drupal\Core\Form\FormStateInterface) {
      $form_state->setErrorByName($name, $message);
    }
    else {
      \Drupal::messenger()->addError($message);
    }
  };
  $alias = hosting_site_clean_domain($alias);
  $site_id = hosting_entity_id($site);
  $params = $site_id ? array('site_id' => $site_id) : array();
  $length = strlen($alias);

  $site_label = hosting_entity_label($site) ?? '';
  if (!hosting_domain_allowed($alias, $params) || $alias == $site_label) {
    $set_error("aliases][$key", t('The domain name @alias is already in use', array('@alias' => $alias)));
  }
  if (!_hosting_valid_fqdn_wildcard($alias)) {
    $set_error("aliases][$key", t('The domain name @alias is not a valid url', array('@alias' => $alias)));
  }
  if ($length > HOSTING_MAX_ALIAS_LENGTH) {
    $long = $length - HOSTING_MAX_ALIAS_LENGTH;
    $set_error("aliases][$key", t('The domain name @alias is @long character(s) too long. Please shorten.', array('@alias' => $alias, '@long' => $long)));
  }
}

/**
 * Implements hook_hosting_site_load().
 */
function hosting_alias_hosting_site_load(array $entities) {
  foreach ($entities as $entity) {
    if (!$entity instanceof \Drupal\Core\Entity\EntityInterface || $entity->getEntityTypeId() !== 'hosting_site') {
      continue;
    }
    $site_id = $entity->id();
    $entity->redirection = \Drupal::database()->query("SELECT redirection FROM {hosting_site_alias} WHERE site_id = :site_id", array(':site_id' => $site_id))->fetchField();
    $entity->aliases = hosting_alias_get_aliases($entity, HOSTING_ALIAS_CUSTOM);
    $entity->aliases_automatic = hosting_alias_get_aliases($entity, HOSTING_ALIAS_AUTOMATIC);
  }
}

/**
 * Implements hook_hosting_site_view().
 */
function hosting_alias_hosting_site_view(array &$build, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display, $view_mode) {
  if ($entity->getEntityTypeId() !== 'hosting_site') {
    return;
  }

  $aliases = isset($entity->aliases) ? $entity->aliases : hosting_alias_get_aliases($entity, HOSTING_ALIAS_CUSTOM);
  if (count($aliases)) {
    $links = array();
    foreach ($aliases as $link) {
      $links[] = \Drupal\Core\Link::fromTextAndUrl($link, \Drupal\Core\Url::fromUri('http://' . $link))->toString();
    }
    $build['info']['aliases'] = array(
      '#type' => 'item',
      '#title' => t('Domain aliases'),
      '#markup' => implode(', ', $links),
      '#weight' => 10,
    );
    $redirection = \Drupal::database()->query("SELECT redirection FROM {hosting_site_alias} WHERE site_id = :site_id", array(':site_id' => $entity->id()))->fetchAssoc();
    $build['info']['redirection'] = array(
      '#type' => 'item',
      '#title' => t('Redirection'),
      '#markup' => !empty($redirection['redirection']) ? t('Yes') : t('No'),
      '#weight' => 12,
    );
  }

  $aliases_automatic = isset($entity->aliases_automatic) ? $entity->aliases_automatic : hosting_alias_get_aliases($entity, HOSTING_ALIAS_AUTOMATIC);
  if (count($aliases_automatic)) {
    $links = array();
    foreach ($aliases_automatic as $link) {
      $links[] = \Drupal\Core\Link::fromTextAndUrl($link, \Drupal\Core\Url::fromUri('http://' . $link))->toString();
    }
    $build['info']['aliases_automatic'] = array(
      '#type' => 'item',
      '#title' => t('Auto aliases'),
      '#markup' => implode(', ', $links),
      '#weight' => 11,
    );
  }
}

/**
 * Implements hook_permission().
 */
function hosting_alias_permission() {
  return array(
    'create site aliases' => array(
      'title' => t('create site aliases'),
    ),
    'administer hosting aliases' => array(
      'title' => t('administer hosting aliases'),
    ),
  );
}

/**
 * Configuration form for site aliases.
 *
 * @see hosting_alias_menu()
 */
function hosting_alias_settings($form, &$form_state) {
  return \Drupal::formBuilder()->getForm(\Drupal\hosting_alias\Form\HostingAliasSettingsForm::class);
}


/**
 * Validation handler for hosting_alias_settings form.
 */
function hosting_alias_settings_validate($form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $value = '';
  $value = trim((string) $form_state->getValue('hosting_alias_subdomain'));
  if ($value !== '' && !\Drupal\Component\Utility\UrlHelper::isValid($value, TRUE) && !\Drupal\Component\Utility\UrlHelper::isValid('http://' . $value, TRUE)) {
    $form_state->setErrorByName('hosting_alias_subdomain', t('The provided domain is invalid.'));
  }
}


/**
 * Generate a default set of aliases for the site based on the global options.
 */
function hosting_alias_automatic_aliases($url) {
  $aliases = module_invoke_all('hosting_automatic_aliases', $url);
  $context = ['url' => $url];
  \Drupal::moduleHandler()->alter('hosting_automatic_aliases', $aliases, $context);
  return $aliases;
}

/**
 * Implements hook_hosting_automatic_aliases().
 *
 * Generate automatic subdomain aliases.
 *
 * @see hosting_alias_hosting_automatic_aliases_alter().
 */
function hosting_alias_hosting_automatic_aliases($url) {
  $aliases = [];
  $config = \Drupal::config('hosting_alias.settings');
  $sub = $config->get('hosting_alias_subdomain');
  if ($sub) {
    $find = [];
    $replace = [];
    if (!preg_match("/\." . preg_quote($sub, '/') . "$/", $url)) {
      if ($config->get('hosting_alias_subdomain_replace_dash')) {
        $find[] = '-';
        $replace[] = $config->get('hosting_alias_subdomain_dash_substitute');
      }
      $find[] = '.';
      $replace[] = '-';
      $aliases[] = str_replace($find, $replace, $url) . "." . trim($sub, ".");
    }
  }
  return $aliases;
}

/**
 * Implements hook_hosting_automatic_aliases_alter().
 *
 * Generate automatic 'www' or bare domain aliases.
 *
 * @see hosting_alias_hosting_automatic_aliases().
 */
function hosting_alias_hosting_automatic_aliases_alter(&$aliases, $context) {
  $url = $context['url'];
  $config = \Drupal::config('hosting_alias.settings');
  if (!preg_match('/^www\./', $url) && $config->get('hosting_alias_automatic_www')) {
    $auto_alias = "www." . $url;
    // Lookup DNS, only add if we get an IP back.
    if (gethostbyname($auto_alias) != $auto_alias) {
      $aliases[] = $auto_alias;
    }
  }
  elseif (preg_match('/^www\./', $url) && $config->get('hosting_alias_automatic_no_www')) {
    $auto_alias = str_replace("www.", "", $url);
    // Lookup DNS, only add if we get an IP back.
    if (gethostbyname($auto_alias) != $auto_alias) {
      $aliases[] = $auto_alias;
    }
  }
}

/**
 * Implements hook_allow_domain().
 *
 * This function will check the existing aliases and the automatically
 * generated aliases to ensure that this url has not been used before
 */
function hosting_alias_allow_domain($url, $params = array()) {
  $query = \Drupal::database()->select('hosting_site_alias', 'a')
    ->fields('a', array('site_id'))
    ->condition('a.alias', $url);

  $query->join('hosting_site', 'h', 'h.id = a.site_id');
  $query->condition('h.status', HOSTING_SITE_DELETED, '<>');

  // For existing sites, don't match the site's current aliases.
  $site_id = NULL;
  if (isset($params['site_id'])) {
    $site_id = $params['site_id'];
  }
  elseif (isset($params['id'])) {
    $site_id = $params['id'];
  }
  if ($site_id) {
    $query->condition('a.site_id', $site_id, '<>');
  }

  return !$query->countQuery()->execute()->fetchField();
}

/**
 * Implements hook_views_data().
 */
function hosting_alias_views_data() {
  $data['hosting_site_alias']['table'] = [
    'group' => t('Hosting Site Aliases'),
    'title' => t('Site Aliases'),
    'join' => [
      'hosting_site' => [
        'left_field' => 'id',
        'field' => 'site_id',
      ],
    ],
  ];
  $data['hosting_site_alias']['redirection'] = [
    'title' => t('Redirection Target'),
    'help' => t('The alias redirection target for this site.'),
    'field' => [
      'id' => 'standard',
      'click sortable' => TRUE,
    ],
  ];

  return $data;
}

/**
 * Implements hook_drush_context_import().
 *
 * If we're importing a site, then import the aliases and redirection values.
 */
function hosting_alias_drush_context_import($context, &$node) {
  if ($context->type == 'site') {
    $node->aliases = $context->aliases;
    $node->redirection = $context->redirection;
  }
}
