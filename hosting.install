<?php
/**
 * @file
 *   Define database schemas and update functions for the hosting module.
 */

// HOSTING_MAX_ALIAS_LENGTH is defined here:
require_once(dirname(__FILE__) . '/hosting.module');

/**
 * Implements hook_uninstall().
 */
function hosting_uninstall() {
  $state = \Drupal::state();
  $state->delete('hosting_dispatch_last_run');
  $state->delete('hosting_update_6008_run');
  $state->delete('hosting_dispatch_enabled');
  $state->delete('hosting_cron_backup');
  $state->delete('hosting_task_update_6000_run');
  $state->delete('hosting_package_update_6002_run');
  $state->delete('hosting_package_update_6004_run');
  $state->delete('hosting_platform_update_6004_run');
  $state->delete('hosting_queued_process_started');
  $state->delete('hosting_queue_tasks_enabled');
  $state->delete('hosting_queue_tasks_items');
  $state->delete('aegir_hostmaster_site_id');
  $state->delete('user_admin_role');
  $state->delete('hosting_post_install_complete');

  $config_factory = \Drupal::configFactory();
  $config_factory->getEditable('hosting.settings')->delete();
  $config_factory->getEditable('hosting.features')->delete();
  $config_factory->getEditable('hosting.queues')->delete();
}

/**
 * Implements hook_schema().
 */
function hosting_schema() {
  $schema['hosting_context'] = array(
    'fields' => array(
      'entity_id' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'name' => array(
        'type' => 'varchar',
        'length' => HOSTING_MAX_ALIAS_LENGTH,
        'not null' => TRUE,
      ),
    ),
    'primary key' => array('entity_id'),
    'unique keys' => array(
      'name' => array('name'),
    ),
  );
  return $schema;
}

/**
 * Implements hook_install().
 */
function hosting_install() {
  hosting_create_roles();

  \Drupal::configFactory()->getEditable('system.logging')
    ->set('error_level', ERROR_REPORTING_HIDE)
    ->save();

  hosting_install_hostmaster_site();
  hosting_post_install_if_ready();
}

/**
 * Create or register the hostmaster site and persist its ID in state.
 */
function hosting_install_hostmaster_site() {
  $state = \Drupal::state();
  if ($state->get('aegir_hostmaster_site_id')) {
    return;
  }

  $entity_type_manager = \Drupal::entityTypeManager();
  if (!$entity_type_manager->hasDefinition('hosting_site')) {
    return;
  }

  $context_hostmaster_id = hosting_context_entity_id('hostmaster');
  $hostmaster_id = $context_hostmaster_id;
  $storage = $entity_type_manager->getStorage('hosting_site');
  if (!$hostmaster_id) {
    $ids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('hosting_name', 'hostmaster')
      ->range(0, 1)
      ->execute();
    if ($ids) {
      $hostmaster_id = (int) reset($ids);
    }
  }
  if (!$hostmaster_id) {
    $ids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('label', 'hostmaster')
      ->range(0, 1)
      ->execute();
    if ($ids) {
      $hostmaster_id = (int) reset($ids);
    }
  }

  if (!$hostmaster_id) {
    $label = hosting_install_hostmaster_label();
    $values = array(
      'label' => $label,
      'hosting_name' => 'hostmaster',
      'status' => 1,
      'profile' => 'hostmaster',
    );

    $config = \Drupal::config('hosting.settings');
    $client_id = (int) $config->get('hosting_admin_client');
    if ($client_id && $entity_type_manager->hasDefinition('hosting_client') && $entity_type_manager->getStorage('hosting_client')->load($client_id)) {
      $values['client'] = $client_id;
    }

    $platform_id = (int) $config->get('hosting_own_platform');
    if ($platform_id && $entity_type_manager->hasDefinition('hosting_platform') && $entity_type_manager->getStorage('hosting_platform')->load($platform_id)) {
      $values['platform'] = $platform_id;
    }

    $db_server_id = (int) $config->get('hosting_own_db_server');
    if ($db_server_id && $entity_type_manager->hasDefinition('hosting_server') && $entity_type_manager->getStorage('hosting_server')->load($db_server_id)) {
      $values['db_server'] = $db_server_id;
    }

    $language = \Drupal::languageManager()->getDefaultLanguage()->getId();
    if ($language) {
      $values['language'] = $language;
    }

    $entity = $storage->create($values);
    $entity->save();
    $hostmaster_id = (int) $entity->id();
    hosting_context_register($hostmaster_id, 'hostmaster');
  }
  elseif (!$context_hostmaster_id) {
    hosting_context_register($hostmaster_id, 'hostmaster');
  }

  if ($hostmaster_id) {
    $state->set('aegir_hostmaster_site_id', $hostmaster_id);
  }
}

/**
 * Determine a default label for the hostmaster site.
 */
function hosting_install_hostmaster_label() {
  $host = \Drupal::request()->getHost();
  if (!empty($host)) {
    return substr($host, 0, 255);
  }

  $site_name = \Drupal::config('system.site')->get('name');
  if (!empty($site_name)) {
    return substr($site_name, 0, 255);
  }

  return 'hostmaster';
}
