<?php
/**
 * @file
 * Install, update and uninstall functions for the hosting_site_data module.
 */


/**
 * Implements hook_schema().
 */
function hosting_site_data_schema() {
  $schema['hosting_site_data'] = array(
    'fields' => array(
      'site_id' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'site_data' => array(
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
      ),
    ),
    'indexes' => array(
      'site_id' => array('site_id'),
    ),
  );

  return $schema;
}
