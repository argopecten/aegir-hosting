{#
/**
 * @file
 * Default theme implementation for a hosting task.
 *
 * Available variables:
 * - task: The hosting_task entity.
 * - label, task_type, status, command, args, options.
 * - started, completed, duration: Formatted timestamps.
 * - view_mode: The view mode.
 * - content: Additional content from entity_view (info table, task log).
 *
 * @ingroup themeable
 */
#}
<article{{ attributes.addClass('hosting-task', 'hosting-task--' ~ status, 'hosting-task--type-' ~ task_type|clean_class) }}>
  <header class="hosting-task__header">
    <h1 class="hosting-task__title">{{ label }}</h1>
    <div class="hosting-task__meta">
      <span class="hosting-task__type">{{ task_type }}</span>
      <span class="hosting-task__status hosting-task__status--{{ status }}">{{ status }}</span>
    </div>
  </header>

  <div class="hosting-task__content">
    {{ content }}
  </div>
</article>
