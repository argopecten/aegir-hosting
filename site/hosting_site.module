/**
 * Access callback for Site add by platform.
 */
function hosting_site_add_by_platform_access($node) {
  if ($node instanceof \Drupal\hosting_platform\Entity\HostingPlatform) {
    return ($node->status == HOSTING_PLATFORM_ENABLED) && \Drupal::entityTypeManager()->getAccessControlHandler('hosting_site')->createAccess(NULL, \Drupal::currentUser())->isAllowed();
  }
  return FALSE;
}

/**
 * Page callback for Site add by platform.
 */
function hosting_site_add_by_platform($node) {
  $platform_id = is_object($node) && method_exists($node, 'id') ? $node->id() : NULL;
  $url = \Drupal\Core\Url::fromRoute('entity.hosting_site.add_form', [], [
    'query' => ['platform' => $platform_id],
  ]);
  return new \Symfony\Component\HttpFoundation\RedirectResponse($url->toString());
}

/**
 * Returns a count of sites.
 *
 * This is used by cron and statistics to batch the number of sites that are
 * processed with each call. It is also used to generate the 'site count' per
 * platform at /hosting/platforms
 *
 * By default it only counts enabled sites.
 *
 * Optionally can include an array of site statuses by which to consider in the
 * count.
 *
 * @param $platform
 *   (optional) A platform id to only count sites on that specific platform.
 * @param $statuses
 *   (optional) An array of site statuses (defined by their constants) by which
 *   to include such sites in the site count.
 *
 * @return
 *   The number of sites matching the specified criteria.
 */
function hosting_site_count($platform = NULL, $statuses = NULL) {
  if (is_null($statuses)) {
    $statuses = array(HOSTING_SITE_ENABLED);
  }

  $query = \Drupal::database()->select('hosting_site')
    ->addTag('hosting_site_count')
    ->fields('hosting_site', array('id'));

  if (count($statuses)) {
    $query->condition('status', $statuses);
  }

  if (!is_null($platform)) {
    $query->condition('platform', $platform);
  }

  return $query->countQuery()->execute()->fetchField();
}

/**
 * Retrieve sites on a specific platform, with a specific status
 */
function hosting_get_sites_by_status($platform, $status) {
  $sites = [];
  $result = \Drupal::database()->query(
    "SELECT id FROM {hosting_site} WHERE platform = :platform AND status = :status",
    array(':platform' => $platform, ':status' => $status)
  );
  foreach ($result as $row) {
    $sites[$row->id] = \Drupal::entityTypeManager()->getStorage('hosting_site')->load($row->id);
  }

  return $sites;
}

/**
 * Retrieves a site entity based on the URL.
 *
 * @param string $url
 *   The URL of the site.
 * @param boolean $loaded_object
 *   Determines if a loaded site should be returned, or just the entity ID.
 *   Defaults to TRUE.
 *
 * @return
 *   If $loaded_object is TRUE, a fully loaded site entity.
 *   If $loaded_object is FALSE, the entity ID of the site.
 *   In either case, if the site can't be found, FALSE is returned.
 */
function hosting_get_site_by_url($url, $loaded_object = TRUE) {
  $site_id = FALSE;

  // If the Aliases feature is enabled, try and get the site by its alias too.
  if (hosting_feature('alias')) {
    $site_id = \Drupal::database()->query("SELECT h.id
                           FROM {hosting_site} h
                      LEFT JOIN {hosting_site_alias} ha
                             ON h.id = ha.site_id
                          WHERE (h.label = :label OR ha.alias = :alias)
                            AND h.status <> :status",
                        array(
                          ':label' => $url,
                          ':alias' => $url,
                          ':status' => HOSTING_SITE_DELETED,
                        ))->fetchField();
  }
  else {
    $ids = \Drupal::entityQuery('hosting_site')
      ->accessCheck(FALSE)
      ->condition('label', $url)
      ->condition('status', HOSTING_SITE_DELETED, '<>')
      ->range(0, 1)
      ->execute();
    if ($ids) {
      $site_id = (int) reset($ids);
    }
  }

  if ($site_id) {
    return $loaded_object ? \Drupal::entityTypeManager()->getStorage('hosting_site')->load($site_id) : $site_id;
  }
  return FALSE;
}

/**
 * Define the status types of a site
 */
function _hosting_site_status($node) {
  if (is_numeric($node)) {
    $status = $node;
  }
  elseif (isset($node->site_status)) {
    $status = $node->site_status;
  }
  elseif (isset($node->status)) {
    $status = $node->status;
  }
  else {
    $status = HOSTING_SITE_QUEUED;
  }
  $labels = hosting_site_status_codes('label');
  return $labels[$status];
}

/**
 * Site status codes to human readable label mappings.
 *
 * @see hosting_site_status_codes
 */
function hosting_site_status_codes_labels() {
  return hosting_site_status_codes('label');
}

/**
 * Define the status type labels and classes.
 *
 * @param $type
 *   The type of status to return ('label' or 'class').
 *
 * @return array
 */
function hosting_site_status_codes($type = NULL) {
  static $codes = array(
    HOSTING_SITE_QUEUED => array(
      'label' => 'Queued',
      'class' => 'hosting-queue',
    ),
    HOSTING_SITE_ENABLED => array(
      'label' => 'Enabled',
      'class' => 'hosting-success',
    ),
    HOSTING_SITE_DELETED => array(
      'label' => 'Deleted',
      'class' => 'hosting-error',
    ),
    HOSTING_SITE_DISABLED => array(
      'label' => 'Disabled',
      'class' => 'hosting-disable',
    ),
  );
  if (!is_null($type)) {
    // Return just the $type
    $return = array();
    foreach ($codes as $code => $types) {
      $return[$code] = $types[$type];
    }
    return $return;
  }
  else {
    // Return everything
    return $codes;
  }
}

/**
 * Implements hook_allow_domain().
 *
 * Disallow domains already used as any site's title/url, unless the site has
 * been deleted.
 *
 * @see hosting_domain_allowed()
 */
function hosting_site_allow_domain($url, $params = array()) {
  $query = "SELECT COUNT(s.id) FROM {hosting_site} s
    WHERE s.label = :title AND s.status <> :status";
  $args[':title'] = $url;
  $args[':status'] = HOSTING_SITE_DELETED;

  if (isset($params['id'])) {
    $query .= " AND s.id <> :id";
    $args[':id'] = $params['id'];
  }
  $result = !\Drupal::database()->query($query, $args)->fetchField();
  return $result;
}

/**
 * @todo Please document this function.
 * @see http://drupal.org/node/1354
 */
function hosting_site_task_status($site_id) {
  return hosting_task_status_output('rid', $site_id, 'install');
}

/**
 * Define the classes that correspond to the site status.
 * @see _hosting_site_status()
 */
function _hosting_site_list_class($node, $verified = NULL) {
  if (is_numeric($node)) {
    $status = $node;
  }
  elseif (isset($node->site_status)) {
    $status = $node->site_status;
  }
  elseif (isset($node->status)) {
    $status = $node->status;
  }
  else {
    $status = HOSTING_SITE_QUEUED;
  }
  $classes = hosting_site_status_codes('class');
  if (($status == HOSTING_SITE_ENABLED) && ($verified <= 1)) {
    return 'hosting-warning';
  }

  return $classes[$status];
}

