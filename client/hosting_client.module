/**
 * Apply client selection logic to site forms.
 */
function hosting_client_site_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  global $user;
  $node = $form['#entity'] ?? $form['#node'] ?? NULL;
  if (!$node) {
    return;
  }

  $client_ids = hosting_get_client_from_user($user->uid);
  if (empty($client_ids) && !\Drupal::currentUser()->hasPermission('administer clients') && (\Drupal::config('hosting_client.settings')->get('hosting_client_require_client_to_create_site') ?? FALSE)) {
    $error_name = 'client';
    if (isset($form['client']['widget'][0]['target_id']['#parents'])) {
      $error_name = implode('][', $form['client']['widget'][0]['target_id']['#parents']);
    }
    $form_state->setErrorByName($error_name, t('Your user is not associated with any clients so you are not allowed to create new sites'));
    $form['#access'] = 0;
    return $form;
  }

  $editable = (!hosting_entity_id($node) || \Drupal::currentUser()->hasPermission('administer sites')) && hosting_feature('client');
  $add_client_text = '';
  if (\Drupal::currentUser()->hasPermission('administer clients') || \Drupal::currentUser()->hasPermission('create client')) {
    $add_client_text = t('Click !here to add a new client.', array(
      '!here' => \Drupal\Core\Link::fromTextAndUrl(t('here'), \Drupal\Core\Url::fromRoute('entity.hosting_client.add_form', array(), array('attributes' => array('target' => '_blank'))))->toString(),
    ));
  }

  if (!isset($form['client']['widget'][0]['target_id'])) {
    return $form;
  }

  $client_element = &$form['client']['widget'][0]['target_id'];
  $client_element['#required'] = TRUE;
  $description = $client_element['#description'] ?? '';
  $client_element['#description'] = trim($description . ' ' . $add_client_text);
  $client_element['#disabled'] = !$editable;

  $options = hosting_client_site_options($node);
  if ($options) {
    $client_element['#options'] = $options;
  }

  $default_client = _hosting_client_site_default($node);
  if ($default_client !== NULL && (!$options || isset($options[$default_client]))) {
    $client_element['#default_value'] = $default_client;
  }
}

/**
 * Implements hook_insert().
 */
function hosting_client_insert($node) {
  if (!$node instanceof \Drupal\Core\Entity\ContentEntityInterface || $node->getEntityTypeId() !== 'hosting_client') {
    return;
  }
  $client_id = $node->id();
  $uname = $node->get('uname')->value;
  $uname = $uname ? hosting_client_sanitize($uname) : hosting_client_sanitize($node->label());
  $node->set('uname', $uname);
  \Drupal::database()->update('hosting_client')
    ->fields(array(
      'uname' => $uname,
    ))
    ->condition('id', $client_id)
    ->execute();

  $email = $node->hasField('email') ? $node->get('email')->value : NULL;
  if ((\Drupal::config('hosting_client.settings')->get('hosting_client_register_user') ?? FALSE)
     && $email
     && user_load_multiple(array(), array('mail' => $email)) == FALSE) {
    $user = hosting_client_register_user($node);
    $node->set('uid', $user->uid);
    \Drupal::database()->update('hosting_client')
      ->fields(array(
        'uid' => $user->uid,
      ))
      ->condition('id', $client_id)
      ->execute();
  }
  if (isset($node->new_user)) {
    $user = user_load_multiple(array(), array('name' => $node->new_user));
    $user = array_shift($user);
    if ($user) {
      $id = \Drupal::database()->insert('hosting_client_user')
        ->fields(array(
          'client' => $client_id,
          'user' => $user->uid,
          'contact_type' => '',
        ))
        ->execute();
    }
  }
}

/**
 * Shortcut to get the rid of the 'aegir client' role.
 *
 * This hardcodes the 'aegir client' role name, so if it is changed,
 * this will fail.
 *
 * @todo the rid or role name should be a variable
 * @deprecated remove this function once the above setting is implemented
 */
function _hosting_client_get_role() {
  return \Drupal::database()->query("SELECT rid FROM {role} WHERE name = :name", array(':name' => 'aegir client'))->fetchField();
}

/**
 * Register a new user account for the client.
 *
 * This is a helper function for client forms that will create a user
 * alongside a new client if the hosting_client_register_user setting
 * is true.
 *
 * @see hosting_client_insert()
 */
function hosting_client_register_user($node) {
  $pass = user_password();
  $user = new stdClass();
  $edit['name'] = $node->get('uname')->value;
  $edit['hosting_client'] = hosting_entity_id($node);
  $edit['mail'] = $node->get('email')->value;
  $edit['pass'] = $pass;
  $edit['status'] = 1;
  $edit['roles'][_hosting_client_get_role()] = TRUE;
  $user = user_save($user, $edit);

  if ($user->uid && (\Drupal::config('hosting_client.settings')->get('hosting_client_send_welcome') ?? FALSE)) {
    $email = $node->get('email')->value;
    $label = $node->label();
    $to = $label ? sprintf("%s <%s>", $label, $email) : $email;

    $params = array(
      '!username' => $user->name,
      '!site' => \Drupal::config('system.site')->get('name') ?? 'Drupal',
      '!password' => $pass,
      '!uri' => $GLOBALS['base_url'],
      '!uri_brief' => substr($base_url, strlen('http://')),
      '!date' => format_date(REQUEST_TIME),
      '!login_uri' => \Drupal\Core\Url::fromUserInput('/user', array('absolute' => TRUE))->toString(),
      '!edit_uri' => \Drupal\Core\Url::fromUserInput('/user/' . $user->uid . '/edit', array('absolute' => TRUE))->toString(),
      '!login_url' => user_pass_reset_url($user),
    );
    // No e-mail verification is required.
    // Create new user account, and login user immediately.
    $language = user_preferred_language($user);
    $langcode = $language instanceof \Drupal\Core\Language\LanguageInterface ? $language->getId() : $language;
    \Drupal::service('plugin.manager.mail')->mail('hosting_client', 'hosting-client-register-welcome', $to, $langcode, $params);
  }
  return $user;
}

/**
 * Implements hook_mail().
 */
function hosting_client_mail($key, &$message, $params) {
  switch ($key) {
    case 'hosting-client-register-welcome':
      $message['subject'] = _hosting_client_mail_text('welcome_subject', $params);
      $message['body'][] = _hosting_client_mail_text('welcome_body', $params);
      break;
  }
}

/**
 * Implements hook_update().
 *
 * As an existing node is being updated in the database, we need to do our own
 * database updates.
 */
function hosting_client_update($node) {
  // If this is a new node or we're adding a new revision.
  if (!$node instanceof \Drupal\Core\Entity\ContentEntityInterface || $node->getEntityTypeId() !== 'hosting_client') {
    return;
  }
  if ($node->revision) {
    hosting_client_insert($node);
  }
  else {
    $client_id = $node->id();
    $uname = $node->get('uname')->value;
    $uname = $uname ? hosting_client_sanitize($uname) : hosting_client_sanitize($node->label());
    $node->set('uname', $uname);
    \Drupal::database()->update('hosting_client')
      ->fields(array(
        'uname' => $uname,
      ))
      ->condition('id', $client_id)
      ->execute();
  }
  if ($node->users) {
    foreach ($node->users as $user) {
      \Drupal::database()->delete('hosting_client_user')
        ->condition('user', $user)
        ->condition('client', hosting_entity_id($node))
        ->execute();
    }
  }
  if ($node->new_user) {
    $user = user_load_multiple(array(), array('name' => $node->new_user));
    $user = array_shift($user);
    $id = \Drupal::database()->insert('hosting_client_user')
      ->fields(array(
        'client' => hosting_entity_id($node),
        'user' => $user->uid,
        'contact_type' => '',
      ))
      ->execute();
  }
}

/**
 * Implements hook_delete().
 */
function hosting_client_delete($node) {
  if (!$node instanceof \Drupal\Core\Entity\ContentEntityInterface || $node->getEntityTypeId() !== 'hosting_client') {
    return;
  }
  \Drupal::database()->delete('hosting_client_user')
    ->condition('client', $node->id())
    ->execute();
}

/**
 * Implements hook_load().
 */
function hosting_client_load($nodes) {
  // Legacy property hydration removed; use entity fields directly.
}

/**
 * Return a list of users for a given client.
 *
 * @param int|object $node
 *   Client entity id or object.
 *
 * @return array
 *   Array of user names indexed by uid.
 */
function hosting_client_users($node) {
  $client_id = hosting_entity_id($node);
  if (!$client_id) {
    return array();
  }
  return \Drupal::database()->query("SELECT u.uid, u.name, h.client FROM {hosting_client_user} h INNER JOIN {users} u ON u.uid = h.user WHERE h.client = :client", array(':client' => $client_id))->fetchAllKeyed();
}

/**
 * Implements hook_view().
 */
function hosting_client_view(array &$build, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display, $view_mode) {
  if ($entity->getEntityTypeId() !== 'hosting_client') {
    return;
  }
  $build['info'] = array(
    '#type' => 'container',
    '#attributes' => array('id' => 'hosting-client-info'),
    '#weight' => 0,
  );
  $build['info']['title'] = array(
    '#type' => 'item',
    '#title' => t('Client name'),
    '#markup' => filter_xss($entity->label()),
  );
  $build['info']['uname'] = array(
    '#type' => 'item',
    '#title' => t('Internal name'),
    '#weight' => 1,
    '#markup' => filter_xss($entity->get('uname')->value),
  );

  if ($view_mode === 'full') {
    $rows = array();
    $users = hosting_client_users($entity);
    foreach ($users as $uid => $uname) {
      if (\Drupal::currentUser()->hasPermission('access user profiles') || ($uid == $GLOBALS['user']->uid)) {
        $rows[] = array(\Drupal\Core\Link::fromTextAndUrl($uname, \Drupal\Core\Url::fromUserInput('/user/' . $uid))->toString());
      }
      else {
        $rows[] = array($uname);
      }
    }

    $header = array(t('Allowed users'));
    $build['users_view'] = array(
      '#type' => 'item',
      '#markup' => \Drupal::service('theme.manager')->render('table', array('header' => $header, 'rows' => $rows)),
      '#class' => 'client',
      '#prefix' => '<div id="hosting-site-list">',
      '#suffix' => '</div>',
      '#weight' => 11,
    );
  }
}

/**
 * Implements hook_hosting_site_site_list_filters().
 */
function hosting_client_hosting_site_site_list_filters() {
  return array('client');
}

/**
 * Helper function to generate new client node during import.
 *
 * @param string $name
 *   Client name.
 *
 * @return object
 *   The node object of the generated client.
 */
function hosting_import_client($name) {
  $client = hosting_get_client_by_uname($name);

  if (!$client) {
    $client = \Drupal::entityTypeManager()->getStorage('hosting_client')->create(array(
      'label' => trim($name),
      'uname' => trim($name),
      'uid' => 1,
      'status' => 1,
    ));
    $client->save();
  }

  return $client;
}

/**
 * Access callback for the client platform access tab.
 */
function _hosting_client_platform_access($platform) {
  if (!$platform instanceof \Drupal\Core\Entity\EntityInterface || $platform->getEntityTypeId() !== 'hosting_platform') {
    return FALSE;
  }
  return hosting_entity_status($platform, 'platform') !== HOSTING_PLATFORM_DELETED &&
    $platform->access('update') &&
    \Drupal::currentUser()->hasPermission('administer clients');
}

/**
 * Page callback for the client platform access form.
 */
function hosting_client_platform_access_form($form, $form_state, $platform) {
  $form = array();
  $clients = hosting_platform_client_ids($platform);
  if (count($clients)) {
    foreach ($clients as $client) {
      $client_node = hosting_get_client($client);
      $form['names'][$client] = array(
        '#type' => 'markup',
        '#value' => $client_node instanceof \Drupal\Core\Entity\EntityInterface
          ? \Drupal\Core\Link::fromTextAndUrl($client_node->label(), $client_node->toUrl('canonical'))->toString()
          : (string) $client,
      );
      // Remove the label for the checkbox.
      $clients[$client] = '';
    }
  }
  else {
    // No access control on this platform.
    $form['names']['_all'] = array(
      '#type' => 'markup',
      '#value' => 'All clients have access to this platform.',
    );
  }
  $form['clients'] = array(
    '#type' => 'checkboxes',
    '#options' => $clients,
  );
  $form['header'] = array(
    '#type' => 'value',
    '#value' => array(
      array('data' => t('Allowed clients')),
      array('data' => t('Remove')),
    ),
  );
  $form['new_client'] = array(
    '#type' => 'textfield',
    '#title' => t('Grant a client access to this platform'),
    '#weight' => 2,
    '#autocomplete_path' => 'hosting_client/autocomplete/client',
    '#description' => t('This field allows you to grant a client access to this platform.
                         Remove all clients from this list to grant all clients access to this platform'),
  );
  $form['#theme'] = 'hosting_client_platform_access_form';
  $form['apply'] = array(
    '#type' => 'submit',
    '#value' => t('Apply'),
    '#access' => \Drupal::currentUser()->hasPermission('administer clients'),
    '#submit' => array('hosting_client_platform_access_form_submit'),
    '#weight' => 10,
  );

  return $form;
}

/**
 * Callback to theme the client platform access form.
 */
function theme_hosting_client_platform_access_form($variables) {
  $form = $variables['form'];
  foreach (element_children($form['names'], FALSE) as $client) {
    $row = array();

    $row['data'][] = $form['names'][$client]['#value'];
    if ($client != '_all' && \Drupal::currentUser()->hasPermission('administer clients')) {
      $row['data'][] = \Drupal::service('renderer')->render($form['clients'][$client]);
    }
    else {
      // Nothing to remove if there aren't any clients...
      unset($form['header']['#value'][1]);
    }
    $rows[] = $row;
  }
  $output = \Drupal::service('theme.manager')->render('table', array('header' => $form['header']['#value'], 'rows' => $rows));
  $output .= \Drupal::service('renderer')->render($form);
  return $output;
}

/**
 * Submit handler for the client platform access form.
 */
function hosting_client_platform_access_form_submit($form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $clients = (array) $form_state->getValue('clients');
  $new_client = $form_state->getValue('new_client');
  $build_info = $form_state->getBuildInfo();
  $platform = $build_info['args'][0] ?? NULL;

  // Remove the selected client(s).
  foreach ($clients as $cid => $remove) {
    if ($remove) {
      \Drupal::database()->delete('hosting_platform_client_access')
        ->condition('pid', hosting_entity_id($platform))
        ->condition('cid', $cid)
        ->execute();
    }
  }

  // Add the new client.
  if ($new_client) {
    $client = hosting_get_client($new_client);
    if ($client) {
      \Drupal::database()->insert('hosting_platform_client_access')
        ->fields(array(
          'pid' => hosting_entity_id($platform),
          'cid' => hosting_entity_id($client),
        ))
        ->execute();
    }
    else {
      $add_client = '';
      if (\Drupal::currentUser()->hasPermission('create client') || \Drupal::currentUser()->hasPermission('administer clients')) {
        $add_client = ' ' . t('or') . '' . \Drupal\Core\Link::fromTextAndUrl(t('add a new client'), \Drupal\Core\Url::fromRoute('entity.hosting_client.add_form'))->toString();
      }
      $form_state->setErrorByName('new_client', t('The client name (%client) was not recognized. Please try again', array('%client' => $new_client)) . $add_client . '.');
    }
  }
}


/**
 * Get the default value of the client field for a site node.
 *
 * @param object $node
 *   The site to the the clients for.
 *
 * @return int|null
 *   The client ID.
 */
function _hosting_client_site_default($node) {
  // Find the right client.
  global $user;
  $current_client_id = 0;
  $node_client_id = NULL;
  if ($node instanceof \Drupal\Core\Entity\ContentEntityInterface && $node->hasField('client')) {
    $node_client_id = $node->get('client')->target_id;
  }

  if ($user->uid) {
    $client_ids = hosting_get_client_from_user($user->uid);
    $clients = array();
    foreach ($client_ids as $client_id => $client_permissions) {
      $client_id = $client_id ? $client_id : HOSTING_DEFAULT_CLIENT;
      $client = \Drupal::entityTypeManager()->getStorage('hosting_client')->load($client_id);
      if (($node_client_id && $node_client_id == $client_id) || !$current_client_id) {
        $current_client_id = $client_id;
      }
    }
  }

  if (!$current_client_id) {
    $current_client_id = HOSTING_DEFAULT_CLIENT;
  }

  // Allow admins to override.
  if ($node_client_id && \Drupal::currentUser()->hasPermission('administer clients')) {
    $current_client_id = $node_client_id;
  }

  $client = \Drupal::entityTypeManager()->getStorage('hosting_client')->load($current_client_id);
  if (!$client) {
    return NULL;
  }

  return (int) $client->id();
}

/**
 * Build client options for site forms.
 *
 * @param object $node
 *   Site entity or legacy object.
 *
 * @return array
 *   Client options keyed by client ID.
 */
function hosting_client_site_options($node) {
  $options = array();
  $storage = \Drupal::entityTypeManager()->getStorage('hosting_client');

  if (\Drupal::currentUser()->hasPermission('administer clients') || \Drupal::currentUser()->hasPermission('administer sites')) {
    $ids = \Drupal::entityQuery('hosting_client')
      ->accessCheck(FALSE)
      ->execute();
  }
  else {
    $ids = array_keys(hosting_get_client_from_user(\Drupal::currentUser()->id()));
  }

  if ($ids) {
    $clients = $storage->loadMultiple($ids);
    foreach ($clients as $client_id => $client) {
      $options[$client_id] = $client->label();
    }
  }

  if (!isset($options[HOSTING_DEFAULT_CLIENT])) {
    $default_client = $storage->load(HOSTING_DEFAULT_CLIENT);
    if ($default_client) {
      $options[HOSTING_DEFAULT_CLIENT] = $default_client->label();
    }
  }

  return $options;
}

/**
 * Build a site add form scoped to a client.
 */
function hosting_client_site_form($form, $client) {
  if (!$client instanceof \Drupal\Core\Entity\EntityInterface || $client->getEntityTypeId() !== 'hosting_client') {
    return array('#markup' => t('Client not found.'));
  }

  $site = \Drupal::entityTypeManager()->getStorage('hosting_site')->create(array(
    'client' => $client->id(),
  ));

  return \Drupal::service('entity.form_builder')->getForm($site, 'add');
}

/**
 * Access callback for the site creation tab on a client.
 */
function hosting_client_menu_access($perm, $client) {
  if (!$client instanceof \Drupal\Core\Entity\EntityInterface || $client->getEntityTypeId() !== 'hosting_client') {
    return FALSE;
  }

  return $client->access('view') && \Drupal::currentUser()->hasPermission($perm);
}

/**
 * Menu access callback for the client settings.
 *
 * @see hosting_client_menu()
 */
function _hosting_client_configure_access() {
  return \Drupal::currentUser()->hasPermission('administer clients') && hosting_feature('client');
}

/**
 * Expand the client registration email message based on the variables.
 *
 * This will check for a custom message set in the
 * hosting_client_mail_welcome_subject and
 * hosting_client_mail_welcome_body variables.
 */
function _hosting_client_mail_text($messageid, $variables = array()) {
  // Check if an admin setting overrides the default string.
  if ($admin_setting = (\Drupal::config('hosting_client.settings')->get('hosting_client_mail.' . $messageid) ?? FALSE)) {
    return strtr($admin_setting, $variables);
  }

  switch ($messageid) {
    case 'welcome_subject':
      return t('Account details for !username at !site', $variables);

    case 'welcome_body':
      return t("!username,\n\nThank you for registering at !site. You may now log in to !login_uri using the following username and password:\n\nusername: !username\npassword: !password\n\nYou may also log in by clicking on this link or copying and pasting it in your browser:\n\n!login_url\n\nThis is a one-time login, so it can be used only once.\n\nAfter logging in, you will be redirected to !edit_uri so you can change your password.\n\n\n--  !site team", $variables);

  }
}

/**
 * Menu callback for the module's settings.
 *
 * @see hosting_client_menu()
 */
function hosting_client_configure($form, &$form_state) {
  return \Drupal::formBuilder()->getForm(\Drupal\hosting_client\Form\HostingClientSettingsForm::class);
}


/**
 * Get 25 clients in a paged query.
 *
 * DEPRECATED, moved to the hosting_client_list view.
 */
function _hosting_get_clients() {
  $return = array();
  $query = \Drupal::database()->select('hosting_client', 'c')->extend('PagerDefault');
  $result = $query
    ->fields('c', array('id', 'label'))
    ->limit(25)
    ->execute();
  foreach ($result as $client) {
    $return[$client->id] = $client->label;
  }
  return $return;
}

/**
 * Retrieve autocomplete suggestions.
 */
function hosting_client_autocomplete($type, $keyword) {
  $matches = array();

  if ($type == 'client') {
    $query = \Drupal::database()->select('hosting_client', 'c');
    $query->addField('c', 'label');
    $query = $query
      ->condition('label', '%' . \Drupal::database()->escapeLike($keyword) . '%', 'LIKE');
    $result = $query->execute();
    foreach ($result as $client) {
      $matches[$client->label] = $client->label;
    }
  }

  return new \Symfony\Component\HttpFoundation\JsonResponse($matches);
}

/**
 * Get accessible platforms that haven't been deleted or locked.
 *
 * We can get called a few times during a page request, so we implement static
 * caching for speed, and because the platforms that are available are unlikely
 * to change during a single page request.
 *
 * @param int $uid
 *   The user ID to retrieve the allowed platforms for. If none is specified the
 *   currently logged in user will be used.
 * @param bool $reset
 *   Whether to reset the internal static cache or not.
 *
 * @todo this is not the right way. we need to implement node-level
 * access permissions here, the same way we do for sites. see
 * http://drupal.org/node/725952
 */
function _hosting_get_allowed_platforms($uid = NULL, $reset = FALSE) {
  static $platforms = array();

  if ($reset) {
    $platforms = array();
  }

  if (is_null($uid)) {
    global $user;
    $uid = $user->uid;
  }

  if (!isset($platforms[$uid])) {
    $platforms[$uid] = array();

    $result = \Drupal::database()->query("SELECT h.id, h.label
                        FROM {hosting_platform} h
                        LEFT JOIN {hosting_platform_client_access} p
                        ON h.id = p.pid
                        LEFT JOIN {hosting_client_user} c
                        ON c.client = p.cid
                        WHERE h.status > :hstatus
                        AND (c.user = :cuser OR p.pid IS NULL)",
                        array(
                          ':hstatus' => HOSTING_PLATFORM_LOCKED,
                          ':cuser' => $uid,
                        )
                      );
    foreach ($result as $platform) {
      $platforms[$uid][$platform->id] = $platform->label;
    }
  }
  return $platforms[$uid];
}

/**
 * Return a machine-usable name for a client.
 *
 * This aims to be usable for unix group/user names and shells.
 *
 * It adds a prefix configured in the frontend settings (defaulting to
 * 'cl-'), and strips the total length of the string (including the
 * prefix) to HOSTING_CLIENT_MAX_GROUP_LENGTH.
 *
 * This can also be used to validate user-provided client unames, as
 * it strips and readds the prefix and performs the same validation
 * and corrections on the field.
 *
 * This is inspired from the context sanitization stuff.
 *
 * @see HOSTING_CLIENT_MAX_GROUP_LENGTH
 */
function hosting_client_sanitize($title) {
  $prefix = \Drupal::config('hosting_client.settings')->get('hosting_client_prefix') ?? '';

  // Remove anything but "word characters", dots and dashes.
  $title = preg_replace("/^$prefix/", "", $title);

  // Remove the prefix in case we are validating an existing uname.
  $title = preg_replace("/[!\W\.\-]/", "", $title);

  return substr(strtolower($prefix . $title), 0, HOSTING_CLIENT_MAX_GROUP_LENGTH);
}

/**
 * Implements hook_views_data().
 */
function hosting_client_views_data() {
  $data['hosting_client'] = [
    'table' => [
      'group' => t('Hosting Client'),
      'title' => t('Client'),
      'entity type' => 'hosting_client',
    ],
    'uname' => [
      'title' => t('Internal name'),
      'help' => t('The internal name for this client.'),
      'field' => [
        'id' => 'standard',
        'click sortable' => TRUE,
      ],
    ],
  ];

  return $data;
}
