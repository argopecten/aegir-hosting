/**
 * Implements hook_hosting_platform_delete().
 */
function hosting_client_hosting_platform_delete(\Drupal\Core\Entity\EntityInterface $entity) {
  if ($entity->getEntityTypeId() !== 'hosting_platform') {
    return;
  }
  \Drupal::database()->delete('hosting_platform_client_access')
    ->condition('pid', $entity->id())
    ->execute();
}

/**
 * Get a client by name or id.
 *
 * @param int|object $client
 *   Either the id or the client title
 *
 * @return bool|object
 *   The client node object of FALSE.
 */
function hosting_get_client($client) {
  if (is_numeric($client)) {
    // @todo: confirm that we validate against numeric client names.
    return \Drupal::entityTypeManager()->getStorage('hosting_client')->load($client);
  }
  else {
    $ids = \Drupal::entityQuery('hosting_client')
      ->accessCheck(FALSE)
      ->condition('label', $client)
      ->range(0, 1)
      ->execute();
    if (!$ids) {
      return FALSE;
    }
    return \Drupal::entityTypeManager()->getStorage('hosting_client')->load(reset($ids));
  }
}

/**
 * Get a client by internal name.
 *
 * @see hosting_get_client()
 *
 * @param string $uname
 *   The internal name of this client.
 *
 * @return object|bool
 *   The client node object of FALSE.
 */
function hosting_get_client_by_uname($uname) {
  $ids = \Drupal::entityQuery('hosting_client')
    ->accessCheck(FALSE)
    ->condition('uname', $uname)
    ->range(0, 1)
    ->execute();
  if (!$ids) {
    return FALSE;
  }
  return \Drupal::entityTypeManager()->getStorage('hosting_client')->load(reset($ids));
}

/**
 * Implements hook_form().
 */
function hosting_client_form(&$node, &$form_state) {
  if (!$node instanceof \Drupal\Core\Entity\ContentEntityInterface || $node->getEntityTypeId() !== 'hosting_client') {
    $node = \Drupal::entityTypeManager()->getStorage('hosting_client')->create(['status' => 1]);
  }
  $node_id = $node->id();
  $form['#entity'] = $node;
  $config = \Drupal::config('hosting_client.settings');
  $form_display = \Drupal::service('entity_display.repository')->getFormDisplay('hosting_client', 'default');
  $form_display->buildForm($node, $form, $form_state);

  if (!$node_id && ($config->get('hosting_client_register_user') ?? FALSE)) {
    $form['email_confirm'] = array(
      '#type' => 'textfield',
      '#title' => t('Confirm Email address'),
      '#required' => FALSE,
      '#size' => 40,
      '#maxlength' => 100,
    );
    if (isset($form['email']['#weight'])) {
      $form['email_confirm']['#weight'] = $form['email']['#weight'] + 1;
    }
  }
  else {
    unset($form['email']);
  }

  if ($node_id) {
    $users = hosting_client_users($node);
    $user_list = array();
    foreach ($users as $uid => $uname) {
      $form['user_edit']['name'][$uid] = array(
        '#type' => 'markup',
        '#value' => \Drupal\Core\Link::fromTextAndUrl($uname, \Drupal\Core\Url::fromUserInput('/user/' . $uid))->toString(),
      );
      $user_list[$uid] = '';
    }
    if (\Drupal::currentUser()->hasPermission('edit client users')) {
      $form['user_edit']['users'] = array(
        '#type' => 'checkboxes',
        '#options' => $user_list,
      );
    }
    $form['user_edit']['header'] = array(
      '#type' => 'value',
      '#value' => array(array('data' => t('Allowed users')), array('data' => t('Remove'))),
    );
    if (\Drupal::currentUser()->hasPermission('edit client users')) {
      $form['user_edit']['new_user'] = array(
        '#type' => 'textfield',
        '#title' => t('Associate a user to this Client'),
        '#weight' => 2,
        '#autocomplete_path' => 'user/autocomplete',
        '#description' => t('This field allows you to associate an existing system user to this Client.
                             It does not create a new system user, but allows an existing user
                             to manage sites belonging to the Client.'),
      );
    }
    $form['user_edit']['#theme'] = 'hosting_client_form';
  }
  else {
    global $user;
    $form['new_user'] = array(
      '#type' => 'value',
      '#value' => isset($user->name) ? $user->name : '',
    );
  }
  return $form;
  // @ignore security_fapi_markup
}

/**
 * @todo Please document this function.
 * @see http://drupal.org/node/1354
 */
function theme_hosting_client_form($variables) {
  $form = $variables['form'];
  foreach (element_children($form['name'], FALSE) as $user) {
    $row = array();
    // @todo: Figure out why drupal_render isn't working here.
    //$row['data'][] = \Drupal::service('renderer')->render($form['name'][$user]);
    $row['data'][] = $form['name'][$user]['#value'];
    if (\Drupal::currentUser()->hasPermission('edit client users')) {
      $row['data'][] = \Drupal::service('renderer')->render($form['users'][$user]);
    }
    $rows[] = $row;
  }
  $output = \Drupal::service('theme.manager')->render('table', array('header' => $form['header']['#value'], 'rows' => $rows));
  $output .= \Drupal::service('renderer')->render($form);
  return $output;
}

/**
 * Implements hook_validate().
 */
function hosting_client_form_error_name(array $form, $field_name, array $value_keys = array('value')) {
  if (isset($form[$field_name]['widget'][0])) {
    foreach ($value_keys as $key) {
      if (isset($form[$field_name]['widget'][0][$key]['#parents'])) {
        return implode('][', $form[$field_name]['widget'][0][$key]['#parents']);
      }
    }
  }
  if (isset($form[$field_name]['#parents'])) {
    return implode('][', $form[$field_name]['#parents']);
  }
  if (isset($form['client'][$field_name]['#parents'])) {
    return implode('][', $form['client'][$field_name]['#parents']);
  }
  return $field_name;
}

/**
 * Read a client form value from form state, supporting nested forms.
 */
function hosting_client_form_get_field_value(array $form, $form_state, $field_name, array $value_keys = array('value')) {
  if (isset($form[$field_name]['widget'][0])) {
    foreach ($value_keys as $key) {
      if (isset($form[$field_name]['widget'][0][$key]['#parents'])) {
        $parents = $form[$field_name]['widget'][0][$key]['#parents'];
        if (is_object($form_state) && method_exists($form_state, 'getValue')) {
          $value = $form_state->getValue($parents);
        }
        elseif (isset($form_state['values'])) {
          $value = \Drupal\Component\Utility\NestedArray::getValue($form_state['values'], $parents);
        }
        else {
          $value = NULL;
        }
        if ($value !== NULL && $value !== '') {
          return $value;
        }
      }
    }
  }

  if (is_object($form_state) && method_exists($form_state, 'getValue')) {
    $value = $form_state->getValue($field_name);
    if ($value === NULL) {
      $value = $form_state->getValue(array('client', $field_name));
    }
  }
  else {
    $value = $form_state['values'][$field_name] ?? ($form_state['values']['client'][$field_name] ?? NULL);
  }

  if (is_array($value)) {
    foreach ($value_keys as $key) {
      if (isset($value[0][$key])) {
        return $value[0][$key];
      }
    }
  }

  return $value;
}

function hosting_client_validate($node, $form, &$form_state) {
  if (!$node instanceof \Drupal\Core\Entity\ContentEntityInterface || $node->getEntityTypeId() !== 'hosting_client') {
    return;
  }
  $set_error = function ($name, $message) use (&$form_state) {
    if ($form_state instanceof \Drupal\Core\Form\FormStateInterface) {
      $form_state->setErrorByName($name, $message);
    }
    else {
      \Drupal::messenger()->addError($message);
    }
  };
  // We don't allow duplicate client names.
  if ($form_state instanceof \Drupal\Core\Form\FormStateInterface) {
    $build_info = $form_state->getBuildInfo();
    $form_id = $build_info['form_id'] ?? ($form['#form_id'] ?? '');
  }
  else {
    $form_id = $form_state['build_info']['form_id'] ?? ($form['#form_id'] ?? '');
  }
  $title = 'label';
  $client_id = $node->id();
  $label = $node->label();
  $existing_id = \Drupal::database()->query("SELECT id FROM {hosting_client} WHERE label = :label", array(':label' => $label))->fetchField();
  if ($existing_id && $client_id != $existing_id) {
    $set_error(hosting_client_form_error_name($form, 'label', array('value')), t("Client name already in use, try %suggestion.", array(
      '%suggestion' => hosting_client_validate_suggest($label),
    )));
  }

  // We don't allow duplicate internal client names.
  $uname = $node->get('uname')->value;
  $uname = $uname ? hosting_client_sanitize($uname) : hosting_client_sanitize($label);
  $node->set('uname', $uname);
  // @todo convert this statement to DBTNG syntax.
  $existing_id = \Drupal::database()->query("SELECT id FROM {hosting_client} WHERE uname = :uname", array(':uname' => $uname))->fetchField();
  if ($existing_id && $client_id != $existing_id) {
    $set_error(hosting_client_form_error_name($form, 'uname', array('value')), t("Client internal name already in use, try %suggestion.", array(
      '%suggestion' => hosting_client_validate_suggest($uname, TRUE),
    )));
  }

  $email = $node->hasField('email') ? $node->get('email')->value : NULL;
  if ($client_id && !empty($email)) {
    $user = user_load_by_mail($email);
    if ($user) {
      $set_error(hosting_client_form_error_name($form, 'email', array('value')), t("Email address already exists."));
    }
    $email_confirm = hosting_client_form_get_field_value($form, $form_state, 'email_confirm');
    if ($email_confirm !== NULL && $email != $email_confirm) {
      $set_error(hosting_client_form_error_name($form, 'email_confirm'), t("Email addresses do not match"));
    }
    if (!valid_email_address($email)) {
      $set_error(hosting_client_form_error_name($form, 'email', array('value')), t("Email address invalid."));
    }
  }
}

/**
 * Helper for hosting_client_validate to suggest a new client name.
 *
 * @see hosting_client_validate()
 *
 * @param string $name
 *   The client name being validated.
 * @param bool $internal
 *   Whether this is an internal client name.
 *
 * @return string
 *   Suggested client name.
 */
function hosting_client_validate_suggest($name, $internal = FALSE) {
  $suggestion = FALSE;
  $field = $internal ? 'uname' : 'label';
  $name = $internal ? hosting_client_sanitize($name) : $name;

  for ($i = 0; $i < 20; $i++) {
    $query = \Drupal::database()->select('hosting_client', 'hc')
      ->fields('hc', array('id'))
      ->condition($field, '%' . \Drupal::database()->escapeLike($name . $i) . '%', 'LIKE')
      ->range(0, 1);
    $existing_id = $query->execute()->fetchField();
    if (!$existing_id) {
      return $name . $i;
    }
  }
}

