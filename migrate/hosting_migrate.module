<?php
/**
 * @file
 * Migrate sites between platforms (Drupal 8+ only).
 */

include_once 'hosting_migrate.batch.inc';

/**
 * Implements hook_hosting_tasks().
 */
function hosting_migrate_hosting_tasks() {
  $tasks = array();

  $tasks['site']['migrate'] = array(
    'title' => t('Migrate Site'),
    'description' => t('Move the site to a new platform.'),
    'dialog' => TRUE,
  );

  $tasks['platform']['migrate'] = array(
    'title' => t('Migrate Sites'),
    'description' => t('Migrate sites to a new platform.'),
    'page arguments' => array('hosting_migrate_platform', 1),
    'dialog' => TRUE,
  );
  return $tasks;
}

/**
 * Implements hook_validate().
 *
 * A site may be migrated if it's URL, Platform or DB server has changed.
 * Only one of these needs to change for a valid migration to be possible.
 */
function hosting_task_migrate_form_validate($form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $migrate_possible = FALSE;

  $site = $form['parameters']['#node'];

  $url = hosting_site_get_domain($form_state->getValue(['parameters', 'new_uri']));
  if ($url != hosting_site_get_domain(hosting_entity_label($site))) {
    $migrate_possible = TRUE;
    if (!_hosting_valid_fqdn($url)) {
      $form_state->setErrorByName('title', t("You have not specified a valid url for this site."));
    }
    if (!hosting_domain_allowed($url)) {
      $form_state->setErrorByName('title', t("The domain name you have specified is not unique or not allowed."));
    }
  }

  if (!$form_state->getValue(['parameters', 'target_platform'])) {
    $form_state->setErrorByName('parameters][target_platform', t("You have no target platform specified."));
  }

  $site_platform_id = $site instanceof \Drupal\Core\Entity\ContentEntityInterface ? $site->get('platform')->target_id : (isset($site->platform) ? $site->platform : NULL);
  if ($form_state->getValue(['parameters', 'target_platform']) != $site_platform_id) {
    $migrate_possible = TRUE;
  }


  $site_db_server_id = $site instanceof \Drupal\Core\Entity\ContentEntityInterface ? $site->get('db_server')->target_id : (isset($site->db_server) ? $site->db_server : NULL);
  if ($form_state->getValue(['parameters', 'new_db_server']) != $site_db_server_id) {
    $migrate_possible = TRUE;
  }



  if (!$migrate_possible) {
    $form_state->setErrorByName('parameters][target_platform', t("To migrate a site you need to modify at least one of the following fields: Domain name, Platform or Database server"));
  }
}

/**
 * Implements hook_theme().
 */
function hosting_migrate_theme($existing, $type, $theme, $path) {
  return array(
    'hosting_migrate_comparison' => array(
      'variables' => array('packages' => NULL),
    ),
  );
}

/**
 * Implements hook_form().
 */
function hosting_task_migrate_form($node) {
  $node->check_profile_migrations =  TRUE;
  $valid_options = hosting_site_available_options($node);

  $form['new_uri'] = array(
    '#title' => t('Domain name'),
    '#description' => t("Changing the domain name when migrating effectively 'renames' the site."),
    '#type' => 'textfield',
    '#required' => TRUE,
    '#weight' => '-1',
    '#default_value' => hosting_site_canonical_url($node),
  );

  $db_servers = hosting_get_servers('db');
  if (sizeof($db_servers) > 1) {
    $form['new_db_server'] = array(
      '#type' => 'radios',
      '#title' => t('Database server'),
      '#required' => TRUE,
      '#description' => t('The database server the site will use to host its content.'),
      '#options' => $db_servers,
      '#default_value' => $node instanceof \Drupal\Core\Entity\ContentEntityInterface ? $node->get('db_server')->target_id : $node->db_server,
    );
  }
  else {
    $form['new_db_server'] = array(
      '#type' => 'hidden',
      '#value' => $node instanceof \Drupal\Core\Entity\ContentEntityInterface ? $node->get('db_server')->target_id : $node->db_server,
    );
  }

  $form['#attached']['library'][] = 'hosting_migrate/admin';
  $packages = array();

  $profile_value = $node instanceof \Drupal\Core\Entity\ContentEntityInterface && $node->hasField('profile') ? $node->get('profile')->value : NULL;
  $site_profile = is_numeric($profile_value) ? \Drupal::entityTypeManager()->getStorage('hosting_package')->load($profile_value) : NULL;
  $profile_name = $site_profile ? $site_profile->get('short_name')->value : $profile_value;

  $profile_platform_instances = hosting_package_instances_load(
    array('p.short_name' => $profile_name, 'h.status' => HOSTING_PLATFORM_ENABLED));

  $site_platform_id = $node instanceof \Drupal\Core\Entity\ContentEntityInterface ? $node->get('platform')->target_id : NULL;
  $site_platform = $site_platform_id ? \Drupal::entityTypeManager()->getStorage('hosting_platform')->load($site_platform_id) : NULL;
  $has_platform_available = FALSE;

  // Don't show the current platform if it's locked
  if (!_hosting_platform_is_locked($site_platform_id)) {
    $form[$site_platform_id]['target_platform'] = array(
      '#type' => 'radio',
      '#title' => $site_platform ? \Drupal\Component\Utility\Html::escape($site_platform->label()) : '',
      "#return_value" => $site_platform_id,
      "#default_value" => $site_platform_id,
      '#description' => t("Current platform"),
      '#parents' => array('parameters', 'target_platform'),
    );
    $has_platform_available = TRUE;
  }
  foreach ($profile_platform_instances as $profile_instance) {
    if (($profile_instance->rid != $site_platform_id) && (in_array($profile_instance->rid, $valid_options['platform']))) {
      $status = hosting_package_comparison($node->id(), $profile_instance->iid);

      $description = t("Upgrades: !upgrades, Warnings: !missing, Errors: !errors | <a href='!url' class='hosting-package-comparison-link'>Compare platforms</a>",
        array(
        '!upgrades' => $status['upgrade'],
        '!missing' => $status['missing'] + $status['downgrade'],
        '!errors' => $status['error'],
        '!url' => \Drupal\Core\Url::fromUserInput('/hosting/migrate/compare/' . $node->id() . '/' . $profile_instance->iid)->toString(),
      )
        );
      $platform = \Drupal::entityTypeManager()->getStorage('hosting_platform')->load($profile_instance->rid);

      $form[$platform->id()]['target_platform'] = array(
        '#type' => 'radio',
        '#title' => \Drupal\Component\Utility\Html::escape($platform->label()),
        '#parents' => array('parameters', 'target_platform'),
        "#return_value" => $platform->id(),
        '#description' => $description,
      );
      if ($status['error']) {
        $form[$platform->id()]['target_platform']['#disabled'] = TRUE;
      }
      $has_platform_available = TRUE;
    }
  }
  if (!$has_platform_available) {
    \Drupal::messenger()->addError(t("You have no platform available as target. Are they locked?"));
  }
  $form['#node'] = $node;
  return $form;
}

/**
 * Compare package schema versions between the current and target platform in temp tables
 */
function hosting_migrate_comparison($current, $target) {

  $current_tbl = _hosting_package_temporary_table($current);
  $target_tbl = _hosting_package_temporary_table($target);

  $packages = array();

  $result = \Drupal::database()->query("SELECT c.id, c.short_name,
    c.version as current_version, t.version as target_version,
    c.version_code as current_version_code, t.version_code as target_version_code,
    c.schema_version as current_schema, t.schema_version as target_schema, c.status AS enabled
    FROM $current_tbl c LEFT JOIN $target_tbl t ON c.id = t.id ORDER BY c.status DESC, short_name");

  while ($obj = $result->fetch()) {
    if (isset($obj->current_schema) && ((int) $obj->target_schema > 0) && ((int) $obj->current_schema > (int) $obj->target_schema)) {
      $obj->status = 'downgrade';
    }
    elseif ( ($obj->current_version_code > $obj->target_version_code)
       || is_null($obj->target_version_code)) {
      $obj->status = 'missing';
    }
    elseif (($obj->current_version_code < $obj->target_version_code) || ($obj->current_schema < $obj->target_schema)) {
      $obj->status = 'upgrade';
    }
    else {
      $obj->status = 'same';
    }
    $packages[$obj->id] = $obj;
  }

  return \Drupal::service('theme.manager')->render("hosting_migrate_comparison", array('packages' => $packages));
}

function _hosting_migrate_version_display($version, $schema = NULL, $status = NULL) {
  $status = (!is_null($status)) ? $status : 'same';
  if (is_null($version)) {
    $display = 'missing';
  }
  else {
    $display = ($version == 0) ? t('Unknown') : $version;
  }
  if ($schema) {
    $display .= " (" . $schema . ")";
  }

  return array('class' => array('hosting-package-' . $status), 'data' => $display);
}

/**
 * Render a list of compared packages for migration.
 */
function theme_hosting_migrate_comparison($variables) {
  $packages = $variables['packages'];
  $rows = array();

  $headers = array(t("Package"), t("Current"), t("Target"));
  foreach ($packages as $key => $instance) {
    $row = array();
    $row[] = array(
      'data' => $instance->short_name,
      'class' => array('hosting-status'),
    );
    $target_schema = ((int) $instance->target_schema == 0) ? $instance->current_schema : $instance->target_schema;
    $row[] = _hosting_migrate_version_display($instance->current_version, $instance->current_schema);
    $row[] = _hosting_migrate_version_display($instance->target_version, $target_schema, $instance->status);
    $rows[] = array(
      'data' => $row,
      'class' => ($instance->enabled) ? array('hosting-success') : array('hosting-info'),
    );
  }
  $options['attributes']['class'] = 'hosting-migrate-comparison-return';
  $current_platform = \Drupal::routeMatch()->getRawParameter('current');
  $link = \Drupal\Core\Link::fromTextAndUrl(t('Go back'), \Drupal\Core\Url::fromUserInput('/hosting_confirm/platform/' . $current_platform . '/platform_migrate', $options))->toString();
  return "<div id='hosting-package-comparison'>" . $link . \Drupal::service('theme.manager')->render('table', array('header' => $headers, 'rows' => $rows)) . $link . "</div>";
}

function _hosting_migrate_get_target_profile_name($task) {
  $profile_value = $task->ref instanceof \Drupal\Core\Entity\ContentEntityInterface && $task->ref->hasField('profile') ? $task->ref->get('profile')->value : NULL;
  $profile = is_numeric($profile_value) ? \Drupal::entityTypeManager()->getStorage('hosting_package')->load($profile_value) : NULL;
  $profile_name = $profile ? $profile->get('short_name')->value : $profile_value;

  // get the profile instance we are migrating to.
  $profile_instance = hosting_package_instance_load(array(
    'i.rid' => $task->task_args['target_platform'],
    'p.short_name' => $profile_name,
  ));

  return $profile_instance;
}

/**
 * Implements hook_post_hosting_migrate_task().
 */
function hosting_migrate_post_hosting_migrate_task($task, $data) {
  if (hosting_entity_task_scope($task->ref) == 'site') {
    $target = $task->task_args['target_platform'];
    $site = $task->ref;

    if (hosting_site_get_domain($site->label()) != hosting_site_get_domain($task->task_args['new_uri'])) {
      $site->set('label', hosting_site_clean_domain($task->task_args['new_uri']));
      hosting_context_register($site->id(), hosting_site_get_domain($site->label()));
    }

    $db_server_id = $site instanceof \Drupal\Core\Entity\ContentEntityInterface && $site->hasField('db_server') ? $site->get('db_server')->target_id : NULL;
    if ($db_server_id != $task->task_args['new_db_server']) {
      $site->set('db_server', $task->task_args['new_db_server']);
    }
    if ($site instanceof \Drupal\Core\Entity\ContentEntityInterface && $site->hasField('db_name')) {
      $site->set('db_name', $data['context']['db_name']);
    }

    $profile = hosting_package_instance_load(array(
      'i.rid' => $target,
      'p.short_name' => $data['context']['profile'],
    ));
    if ($profile) {
      if ($site instanceof \Drupal\Core\Entity\ContentEntityInterface && $site->hasField('profile')) {
        $site->set('profile', $profile->short_name);
      }
    }

    if ($site instanceof \Drupal\Core\Entity\ContentEntityInterface && $site->hasField('verified')) {
      $site->set('verified', REQUEST_TIME);
    }
    $site->no_verify = TRUE;
    if ($site instanceof \Drupal\Core\Entity\ContentEntityInterface && $site->hasField('platform')) {
      $site->set('platform', $target);
    }
    $site->save();

    $task->ref = $site;

    //do the package synching
    $context = $data['context'];
    $packages = $context['packages'];
    hosting_package_sync($packages);
    hosting_package_instance_sync($task->ref->id(), hosting_entity_task_scope($task->ref), $packages);

    // Record the backup created during migrate.
    $task->task_args['description'] = t('Pre-migration backup');
    hosting_site_post_hosting_backup_task($task, $data);
  }
}
