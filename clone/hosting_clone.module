<?php
/**
 * @file
 * Allow sites to be cloned.
 */

/**
 * Implements hook_hosting_tasks().
 */
function hosting_clone_hosting_tasks() {
  $options = array();

  $options['site']['clone'] = array(
    'title' => t('Clone'),
    'description' => t('Make a copy of a site.'),
    'weight' => 5,
    'dialog' => TRUE,
  );
  return $options;
}

/**
 * Implements hook_hosting_task_TASK_TYPE_form_validate().
 */
function hosting_task_clone_form_validate($form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $site = $form['parameters']['#node'];

  $url = hosting_site_get_domain($form_state->getValue(['parameters', 'new_uri'])); // domain names are case-insensitive
  if ($url == hosting_site_get_domain(hosting_entity_label($site))) {
    $form_state->setErrorByName('new_uri', t("To clone a site you need to specify a new Domain name to clone it to."));
  }
  else {
    hosting_task_migrate_form_validate($form, $form_state);
  }
}

/**
 * Implements hook_theme().
 */
function hosting_clone_theme($existing, $type, $theme, $path) {
  return array('hosting_task_clone_form' => array('render element' => 'form'));
}

/**
 * Implements hook_hosting_task_TASK_TYPE_form().
 */
function hosting_task_clone_form($node) {
  $form = hosting_task_migrate_form($node);
  $form['new_uri']['#description'] = t('The new domain name of the clone site.');
  return $form;
}

/**
 * Render the clone task form.
 */
function theme_hosting_task_clone_form($variables) {
  $form = $variables['form'];
  return theme_hosting_task_migrate_form($form);
}

/**
 * Implements hook_post_hosting_clone_task().
 */
function hosting_clone_post_hosting_clone_task($task, $data) {
  if (hosting_entity_task_scope($task->ref) == 'site') {
    $target = $task->task_args['target_platform'];
    $clone = \Drupal::entityTypeManager()->getStorage('hosting_site')->create(array(
      'label' => hosting_site_clean_domain($task->task_args['new_uri']),
      'platform' => $target,
      'status' => hosting_entity_status($task->ref, 'site'),
      'verified' => 0,
    ));
    hosting_clone_set_field($clone, 'hosting_name', hosting_site_get_domain($clone->label()));
    hosting_clone_set_field($clone, 'import', 1);
    hosting_clone_set_field($clone, 'aliases', isset($task->task_args['aliases']) ? $task->task_args['aliases'] : array());
    hosting_clone_set_field($clone, 'redirection', isset($task->task_args['redirection']) ? $task->task_args['redirection'] : FALSE);

    $client_id = $task->ref instanceof \Drupal\Core\Entity\ContentEntityInterface && $task->ref->hasField('client') ? $task->ref->get('client')->target_id : NULL;
    hosting_clone_set_field($clone, 'client', $client_id);
    $db_server_id = $task->ref instanceof \Drupal\Core\Entity\ContentEntityInterface && $task->ref->hasField('db_server') ? $task->ref->get('db_server')->target_id : NULL;
    if ($db_server_id != $task->task_args['new_db_server']) {
      $db_server_id = $task->task_args['new_db_server'];
    }
    hosting_clone_set_field($clone, 'db_server', $db_server_id);
    $language = $task->ref instanceof \Drupal\Core\Entity\ContentEntityInterface && $task->ref->hasField('language') ? $task->ref->get('language')->value : NULL;
    hosting_clone_set_field($clone, 'language', $language);

    $profile = hosting_package_instance_load(array(
      'i.rid' => $target,
      'p.short_name' => $data['context']['profile'],
    ));
    if ($profile) {
      hosting_clone_set_field($clone, 'profile', $profile->short_name);
    }

    $clone->save();

    // Record the backup created during clone.
    $task->task_args['description'] = t('Pre-clone backup');
    hosting_site_post_hosting_backup_task($task, $data);
  }
}

/**
 * Set a field or property on a cloned site entity.
 */
function hosting_clone_set_field($entity, $field, $value) {
  if ($entity instanceof \Drupal\Core\Entity\ContentEntityInterface && $entity->hasField($field)) {
    $entity->set($field, $value);
  }
  else {
    $entity->{$field} = $value;
  }
}
