{#
/**
 * @file
 * Default theme implementation to display a hosting site.
 *
 * Available variables:
 * - content: Remaining content items after extraction.
 * - attributes: HTML attributes for the container element.
 * - label: The title of the entity.
 * - title_prefix/title_suffix: Additional module output around title.
 * - title_attributes: HTML attributes for the title element.
 * - entity: The full entity object.
 * - view_mode: The view mode; e.g., 'full', 'teaser', etc.
 * - sidebar: Sidebar content for the site.
 * - info: Hosting info table render array.
 * - tasks_view: Task action table render array.
 *
 * @ingroup themeable
 */
#}
<article{{ attributes.addClass('hosting-site') }}>
  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}

  {% if info %}
    <div class="hosting-site-info">
      {{ info }}
    </div>
  {% endif %}

  {% if tasks_view %}
    <div class="hosting-site-tasks">
      {{ tasks_view }}
    </div>
  {% endif %}

  <div class="hosting-site-content">
    {{ content }}
  </div>
  {% if sidebar %}
    <aside class="hosting-site-sidebar">
      {{ sidebar }}
    </aside>
  {% endif %}
</article>
