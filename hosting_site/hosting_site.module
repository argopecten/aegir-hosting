<?php

/**
 * @file
 * Hosting site module.
 */

/**
 * Implements hook_hosting_feature().
 */
function hosting_site_hosting_feature() {
  return [
    'site' => [
      'title' => t('Sites'),
      'description' => t('Site records and lifecycle tasks.'),
      'module' => 'hosting_site',
      'required' => FALSE,
      'dependencies' => ['hosting_platform', 'hosting_server', 'hosting_package'],
    ],
  ];
}

/**
 * Implements hook_theme().
 */
function hosting_site_theme($existing, $type, $theme, $path): array {
  return [
    'hosting_site' => [
      'render element' => 'elements',
      'template' => 'hosting-site',
    ],
    'hosting_site_sidebar' => [
      'variables' => [
        'content' => NULL,
        'attributes' => NULL,
      ],
      'template' => 'hosting-sidebar',
      'path' => \Drupal::service('extension.list.module')->getPath('hosting') . '/templates',
    ],
    'hosting_site_task_queue' => [
      'variables' => [
        'title' => NULL,
        'list' => NULL,
        'attributes' => NULL,
      ],
      'template' => 'hosting-task-queue',
      'path' => \Drupal::service('extension.list.module')->getPath('hosting') . '/templates',
    ],
    'hosting_site_navigation' => [
      'variables' => [
        'title' => NULL,
        'list' => NULL,
        'attributes' => NULL,
      ],
      'template' => 'hosting-navigation',
      'path' => \Drupal::service('extension.list.module')->getPath('hosting') . '/templates',
    ],
  ];
}

/**
 * Prepares variables for hosting site templates.
 *
 * Default template: hosting-site.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the site information and any
 *     fields attached to the entity.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_hosting_site(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'];
  $variables['site'] = $variables['elements']['#hosting_site'];
  $variables['entity'] = $variables['site'];
  
  // Helpful $content variable for templates.
  foreach (\Drupal\Core\Render\Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
  
  // Add title prefix/suffix.
  $variables['title_prefix'] = $variables['elements']['#title_prefix'] ?? [];
  $variables['title_suffix'] = $variables['elements']['#title_suffix'] ?? [];
  
  // Set label and title attributes.
  $variables['label'] = $variables['site']->label();
  $variables['title_attributes'] = $variables['elements']['#title_attributes'] ?? new \Drupal\Core\Template\Attribute();
  
  // Pass sidebar if it exists.
  $variables['sidebar'] = $variables['content']['hosting_sidebar'] ?? NULL;
  unset($variables['content']['hosting_sidebar']);

  // Extract info table and task table for template regions.
  $variables['info'] = $variables['content']['info'] ?? NULL;
  unset($variables['content']['info']);
  $variables['tasks_view'] = $variables['content']['tasks_view'] ?? NULL;
  unset($variables['content']['tasks_view']);

  // Build "Go to site" URL from the domain field.
  $site = $variables['site'];
  $domain = $site->get('domain')->value ?? NULL;
  if ($domain) {
    $variables['site_url'] = 'https://' . $domain;
  }
  else {
    $variables['site_url'] = NULL;
  }
}

/**
 * Implements hook_entity_view().
 */
function hosting_site_entity_view(array &$build, \Drupal\Core\Entity\EntityInterface $entity, $display, $view_mode): void {
  if ($entity->getEntityTypeId() !== 'hosting_site') {
    return;
  }

  /** @var \Drupal\hosting_site\Entity\HostingSite $entity */
  $date_formatter = \Drupal::service('date.formatter');

  // Build info table matching D7 hosting_site_view().
  $info_items = [];

  // Go to site link.
  $domain = $entity->get('domain')->value ?? NULL;
  if ($domain) {
    $info_items[] = [
      'label' => t('Site'),
      'value' => [
        '#type' => 'link',
        '#title' => t('Go to @domain', ['@domain' => $domain]),
        '#url' => \Drupal\Core\Url::fromUri('https://' . $domain),
        '#attributes' => [
          'class' => ['hosting-goto-site-link'],
          'target' => '_blank',
          'rel' => 'noopener',
        ],
      ],
      'weight' => -20,
    ];
  }

  // Client.
  $client_id = $entity->get('client')->target_id ?? NULL;
  if ($client_id) {
    $client = \Drupal::entityTypeManager()->getStorage('hosting_client')->load($client_id);
    $info_items[] = [
      'label' => t('Client'),
      'value' => $client ? [
        '#type' => 'link',
        '#title' => $client->label(),
        '#url' => $client->toUrl(),
      ] : ['#markup' => (string) $client_id],
      'weight' => -15,
    ];
  }

  // Verified.
  $verified = (int) $entity->get('verified')->value;
  $info_items[] = [
    'label' => t('Verified'),
    'value' => ['#markup' => $verified ? $date_formatter->formatTimeDiffSince($verified) . ' ' . t('ago') : t('Never')],
    'weight' => -10,
  ];

  // Platform.
  $platform_id = $entity->get('platform')->target_id ?? NULL;
  if ($platform_id) {
    $platform = \Drupal::entityTypeManager()->getStorage('hosting_platform')->load($platform_id);
    $info_items[] = [
      'label' => t('Platform'),
      'value' => $platform ? [
        '#type' => 'link',
        '#title' => $platform->label(),
        '#url' => $platform->toUrl(),
      ] : ['#markup' => (string) $platform_id],
      'weight' => -8,
    ];
  }

  // Profile.
  $profile_id = $entity->get('profile')->target_id ?? NULL;
  if ($profile_id) {
    $profile = \Drupal::entityTypeManager()->getStorage('hosting_package')->load($profile_id);
    $info_items[] = [
      'label' => t('Install profile'),
      'value' => $profile ? ['#markup' => $profile->label()] : ['#markup' => (string) $profile_id],
      'weight' => -6,
    ];
  }

  // Language.
  $language = $entity->get('language')->value ?? 'en';
  $info_items[] = [
    'label' => t('Language'),
    'value' => ['#markup' => $language],
    'weight' => -5,
  ];

  // Status.
  $status = (int) $entity->get('status')->value;
  $status_map = [
    \Drupal\hosting_site\Entity\HostingSite::STATUS_QUEUED => ['label' => t('Queued'), 'class' => 'hosting-queue'],
    \Drupal\hosting_site\Entity\HostingSite::STATUS_ENABLED => ['label' => t('Enabled'), 'class' => 'hosting-success'],
    \Drupal\hosting_site\Entity\HostingSite::STATUS_DISABLED => ['label' => t('Disabled'), 'class' => 'hosting-disable'],
    \Drupal\hosting_site\Entity\HostingSite::STATUS_DELETED => ['label' => t('Deleted'), 'class' => 'hosting-error'],
  ];
  $status_info = $status_map[$status] ?? ['label' => t('Unknown'), 'class' => ''];
  $info_items[] = [
    'label' => t('Status'),
    'value' => ['#markup' => '<span class="' . $status_info['class'] . '">' . $status_info['label'] . '</span>'],
    'weight' => -4,
  ];

  // DB server.
  $db_server_id = $entity->get('db_server')->target_id ?? NULL;
  if ($db_server_id) {
    $db_server = \Drupal::entityTypeManager()->getStorage('hosting_server')->load($db_server_id);
    $info_items[] = [
      'label' => t('Database server'),
      'value' => $db_server ? [
        '#type' => 'link',
        '#title' => $db_server->label(),
        '#url' => $db_server->toUrl(),
      ] : ['#markup' => (string) $db_server_id],
      'weight' => -2,
    ];
  }

  $build['info'] = [
    '#theme' => 'hosting_info_table',
    '#items' => $info_items,
    '#attributes' => ['id' => 'hosting-site-info'],
    '#weight' => -5,
  ];

  // Task table (replaces D7 hosting_task_table()).
  $task_resolver = \Drupal::service('hosting.task_availability_resolver');
  $build['tasks_view'] = $task_resolver->buildTaskTable($entity);
  $build['tasks_view']['#weight'] = 9;

  // Attach task table AJAX refresh.
  $build['#attached']['library'][] = 'hosting_task/task-table-refresh';
  $build['#attached']['drupalSettings']['hostingTaskTable']['refreshUrl'] = \Drupal\Core\Url::fromRoute('hosting_task.refresh.task_table', [
    'entity_type_id' => 'hosting_site',
    'entity_id' => $entity->id(),
  ])->toString();

  // Sidebar: recent tasks + navigation.
  $context_storage = \Drupal::entityTypeManager()->getStorage('hosting_context');
  $context_records = $context_storage->loadByProperties([
    'entity_type' => 'hosting_site',
    'entity_id' => $entity->id(),
  ]);
  $context_record = $context_records ? reset($context_records) : NULL;
  $context_name = $context_record ? (string) $context_record->get('context_name')->value : '';

  $task_items = [];
  $task_tags = [];
  if ($context_name !== '') {
    $task_query = \Drupal::entityQuery('hosting_task')
      ->condition('context_name', $context_name)
      ->sort('id', 'DESC')
      ->range(0, 5)
      ->accessCheck(TRUE);
    $task_ids = $task_query->execute();
    if ($task_ids) {
      $task_storage = \Drupal::entityTypeManager()->getStorage('hosting_task');
      $tasks = $task_storage->loadMultiple($task_ids);
      foreach ($tasks as $task) {
        $t_status = (string) $task->get('status')->value;
        $task_items[] = [
          '#type' => 'container',
          '#attributes' => [
            'class' => ['hosting-task-item', 'hosting-task-item--' . \Drupal\Component\Utility\Html::getClass($t_status)],
          ],
          'title' => [
            '#type' => 'link',
            '#title' => $task->label(),
            '#url' => $task->toUrl(),
          ],
          'status' => [
            '#type' => 'html_tag',
            '#tag' => 'span',
            '#value' => $t_status,
            '#attributes' => ['class' => ['hosting-task-status']],
          ],
        ];
        $task_tags = \Drupal\Core\Cache\Cache::mergeTags($task_tags, $task->getCacheTags());
      }
    }
  }

  $build['hosting_sidebar'] = [
    '#theme' => 'hosting_site_sidebar',
    '#content' => [
      'task_queue' => [
        '#theme' => 'hosting_site_task_queue',
        '#title' => t('Recent tasks'),
        '#list' => [
          '#theme' => 'item_list',
          '#items' => $task_items,
          '#empty' => t('No tasks available.'),
          '#attributes' => ['class' => ['hosting-task-queue']],
        ],
        '#attributes' => ['class' => ['hosting-panel', 'hosting-panel--task-queue']],
      ],
      'navigation' => [
        '#theme' => 'hosting_site_navigation',
        '#title' => t('Navigation'),
        '#list' => [
          '#theme' => 'item_list',
          '#items' => [
            ['#type' => 'link', '#title' => t('All tasks'), '#url' => \Drupal\Core\Url::fromRoute('entity.hosting_task.collection')],
            ['#type' => 'link', '#title' => t('Edit site'), '#url' => $entity->toUrl('edit-form')],
            ['#type' => 'link', '#title' => t('All sites'), '#url' => \Drupal\Core\Url::fromRoute('entity.hosting_site.collection')],
            ['#type' => 'link', '#title' => t('All platforms'), '#url' => \Drupal\Core\Url::fromRoute('entity.hosting_platform.collection')],
            ['#type' => 'link', '#title' => t('All servers'), '#url' => \Drupal\Core\Url::fromRoute('entity.hosting_server.collection')],
          ],
          '#attributes' => ['class' => ['hosting-navigation']],
        ],
        '#attributes' => ['class' => ['hosting-panel', 'hosting-panel--navigation']],
      ],
    ],
    '#attributes' => ['class' => ['hosting-sidebar']],
    '#weight' => 60,
  ];

  $build['#attributes']['class'][] = 'hosting-site-view';

  if ($task_tags) {
    $build['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($build['#cache']['tags'] ?? [], $task_tags);
  }
}

/**
 * Implements hook_theme_suggestions_HOOK().
 */
function hosting_site_theme_suggestions_hosting_site(array $variables) {
  $suggestions = [];
  if (!empty($variables['entity'])) {
    $entity = $variables['entity'];
    $suggestions[] = 'hosting_site__' . $entity->id();
    if (isset($variables['view_mode'])) {
      $suggestions[] = 'hosting_site__' . $variables['view_mode'];
    }
  }
  return $suggestions;
}

