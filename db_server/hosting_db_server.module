<?php
/**
 * @file
 * Allow Hostmaster to configure database servers.
 */

/**
 * Implements hook_hosting_service().
 */
function hosting_db_server_hosting_service() {
  return array(
    'mysql' => 'db',
  );
}

/**
 * Implements hook_hosting_service_type().
 */
function hosting_db_server_hosting_service_type() {
  return array(
    'db' => array(
      'title' => t('Database'),
    ),
  );
}

/**
 * Find the database server.
 */
function hosting_get_db_server($hostname) {
  if (_hosting_valid_ip($hostname)) {
    $ip = $hostname;
    $hostname = gethostbyaddr($hostname);
  }
  else {
    $ip = gethostbyname($hostname);
  }
  $ids = \Drupal::entityTypeManager()->getStorage('hosting_server')->getQuery()
    ->condition('label', array($ip, $hostname), 'IN')
    ->range(0, 1)
    ->execute();
  if ($ids) {
    $id = reset($ids);
    return \Drupal::entityTypeManager()->getStorage('hosting_server')->load($id);
  }

  return FALSE;
}


/**
 * Get the databases hosted on a server.
 *
 * @param int $db_server_id
 *   The entity ID of the db server.
 */
function hosting_get_sites_on_db_server($db_server_id) {
  $return = array();
  $result = \Drupal::database()->query("SELECT id, db_name FROM {hosting_site} WHERE db_server = :id", array(':id' => $db_server_id));
  while ($site = $result->fetch()) {
    $return[$site->id] = $site->db_name;
  }

  return $return;
}

/**
 * Implements hook_entity_presave().
 */
function hosting_db_server_entity_presave(\Drupal\Core\Entity\EntityInterface $entity) {
  if ($entity->getEntityTypeId() !== 'hosting_server') {
    return;
  }
  $entity_id = $entity->id();
  if (!$entity_id) {
    return;
  }

  $db_passwd = $entity->hasField('db_passwd') ? $entity->get('db_passwd')->value : ($entity->db_passwd ?? NULL);
  if (empty($db_passwd)) {
    $old = \Drupal::entityTypeManager()->getStorage('hosting_server')->load($entity_id);
    if ($old && (isset($old->db_passwd) || ($old instanceof \Drupal\Core\Entity\ContentEntityInterface && $old->hasField('db_passwd')))) {
      $old_value = $old instanceof \Drupal\Core\Entity\ContentEntityInterface && $old->hasField('db_passwd')
        ? $old->get('db_passwd')->value
        : ($old->db_passwd ?? NULL);
      if ($old_value !== NULL) {
        if ($entity instanceof \Drupal\Core\Entity\ContentEntityInterface && $entity->hasField('db_passwd')) {
          $entity->set('db_passwd', $old_value);
        }
        else {
          $entity->db_passwd = $old_value;
        }
      }
    }
  }
}
