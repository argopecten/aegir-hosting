}

/**
 * Check site URL is allowed.
 *
 * This function hooks into hook_allow_domain to let contrib modules
 * weigh in on whether the site should be created.
 *
 * All the hooks must return true for the domain to be allowed.
 *
 * @see hook_allow_domain()
 */
function hosting_domain_allowed($url, $params = array()) {
  $results = \Drupal::moduleHandler()->invokeAll('allow_domain', [$url, $params]);
  $return = !in_array(FALSE, $results);
  return $return;
}

/**
 * Set up the hosting-dispatch command in the aegir user's crontab.
 *
 * Replace the crontab entry if it exists, else create it from scratch.
 */
function _hosting_setup_cron($add = TRUE) {
  $existing = FALSE;
  $cron = '';
  $cron_lines = array();

  // Load any existing crontab.
  exec('crontab -l 2> /dev/null', $cron_lines);
  \Drupal::state()->set('hosting_cron_backup', $cron_lines);
  if (count($cron_lines)) {
    hosting_log(t('Replacing existing crontab'), 'notice');
    $cron_lines = hosting_queues_cron_removal($cron_lines);
    $cron = implode("\n", $cron_lines);
  }
  else {
    hosting_log(t('No existing crontab was found'), 'message');
  }

  if ($add) {
    // Append the fresh Aegir specific lines.
    $cron .= "\n" . hosting_queues_cron_cmd();
    hosting_log(t('Adding hosting-dispatch cron entry to run every minute'), 'ok');
  }

  // Write a new crontab.
  $fp = popen('crontab -', 'w');
  $success = TRUE;
  if ($fp) {
    if (fwrite($fp, $cron) && fwrite($fp, "\n")) {
      $success = TRUE;
    }
    else {
      $success = FALSE;
    }
    // 'pclose' returns shell exit codes (ie. 0 is success).
    if (pclose($fp)) {
      $success = FALSE;
    }
  }
  else {
    $success = FALSE;
  }

  if ($success) {
    hosting_log(t('Installed a new crontab entry.'), 'success');
  }
  else {
    throw new \Drush\Exceptions\UserAbortException((string) t('Failed to install cron job.'));
  }
}

/**
 * List queues or tasks in a queue if a key is provided.
 *
 * @see hosting_TASK_SINGULAR_list()
 */
function hosting_queues($key = '') {
  $queues = hosting_get_queues();
  $output = '';
  if ($queues[$key]) {
    if ($queues[$key]['name']) {
      $output .= "<h1>" . $queues[$key]['name'] . "</h1>";
    }

    // Invoke hosting_TASK_SINGULAR_list().
    $func = 'hosting_' . $queues[$key]['singular'] . '_list';
    if (function_exists($func)) {
      $output .= $func();
    }
  }
  else {
    foreach ($queues as $key => $queue) {
      $item[] = \Drupal\Core\Link::fromTextAndUrl($queue['name'], \Drupal\Core\Url::fromUserInput('/hosting/queues/' . $key))->toString();
    }
    $output .= \Drupal::service('theme.manager')->render('item_list', array('items' => $item, 'title' => t('Queues')));
  }

  return $output;
}

/**
 * Generate context sensitive breadcrumbs.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   A hosting entity to use for context of the breadcrumbs.
 */
function hosting_set_breadcrumb($entity) {
  $breadcrumbs[] = \Drupal\Core\Link::fromTextAndUrl(t('Home'), \Drupal\Core\Url::fromRoute('<front>'))->toString();
  $scope = hosting_entity_task_scope($entity);
  switch ($scope) {
    case 'task':
      $rid = NULL;
      if ($entity instanceof \Drupal\Core\Entity\ContentEntityInterface && $entity->hasField('rid') && !$entity->get('rid')->isEmpty()) {
        $rid = $entity->get('rid')->value;
      }
      if ($rid) {
        $breadcrumbs[] = _hosting_node_link($rid);
      }
      break;

    case 'platform':
      $web_server = NULL;
      if ($entity instanceof \Drupal\Core\Entity\ContentEntityInterface && $entity->hasField('web_server') && !$entity->get('web_server')->isEmpty()) {
        $web_server = $entity->get('web_server')->target_id;
      }
      if ($web_server) {
        $breadcrumbs[] = _hosting_node_link($web_server);
      }
      break;

    case 'site':
      $platform = NULL;
      if ($entity instanceof \Drupal\Core\Entity\ContentEntityInterface && $entity->hasField('platform') && !$entity->get('platform')->isEmpty()) {
        $platform = $entity->get('platform')->target_id;
      }
      if ($platform) {
        $breadcrumbs[] = _hosting_node_link($platform);
      }
      break;

    case 'server':
      $breadcrumbs[] = \Drupal\Core\Link::fromTextAndUrl(t('Servers'), \Drupal\Core\Url::fromUserInput('/hosting/servers'))->toString();
      break;
  }
  $breadcrumbs[] = _hosting_node_link($entity);
}

/**
 * Form to configure the frequency of queue execution.
 */
function hosting_queues_configure($form, &$form_state) {
  $form['#attached']['library'][] = 'hosting/admin';
  $units = array(
    strtotime("1 second", 0) => t("Seconds"),
    strtotime("1 minute", 0) => t("Minutes"),
    strtotime("1 hour", 0) => t("Hours"),
    strtotime("1 day", 0) => t("Days"),
    strtotime("1 week", 0) => t("Weeks"),
  );

  $queues = hosting_get_queues();
  $state = \Drupal::state();
  $form['#tree'] = TRUE;

  foreach ($queues as $queue => $info) {
    $form[$queue]["enabled"] = array(
      '#type' => 'checkbox',
      '#default_value' => $info['enabled'],
      '#title' => $info['name'],
      '#description' => $info['description'],
    );

    $form[$queue]["last_run"] = array(
      '#markup' => hosting_format_interval($state->get('hosting_queue_' . $queue . '_last_run', FALSE)),
    );
    $form[$queue]['frequency']['#prefix'] = "<div class='hosting-queue-frequency'>";
    $form[$queue]['frequency']['#suffix'] = "</div>";

    if ($info['type'] == HOSTING_QUEUE_TYPE_BATCH) {
      $form[$queue]['frequency']['items'] = array(
        '#markup' => t('%count %items every', array(
          "%count" => $info['total_items'],
          "%items" => \Drupal::translation()->formatPlural($info['total_items'], $info['singular'], $info['plural']),
        )),
        '#prefix' => "<div class='hosting-queue-frequency-items'>",
        '#suffix' => "</div>",
      );
    }
    elseif ($info['type'] == HOSTING_QUEUE_TYPE_SPREAD) {
      $form[$queue]['frequency']['items'] = array(
        '#markup' => t('%count %items every', array(
          "%count" => $info['total_items'],
          "%items" => \Drupal::translation()->formatPlural($info['total_items'], $info['singular'], $info['plural']),
        )),
        '#prefix' => "<div class='hosting-queue-frequency-items'>",
        '#suffix' => "</div>",
      );
    }
    else {
      $form[$queue]['frequency']['items'] = array(
        '#type' => 'textfield',
        '#size' => 3,
        '#maxlength' => 3,
        '#default_value' => $info['items'],
        // @ignore i18n_11
        '#suffix' => ' ' . t('%items every', array('%items' => $info['plural'])) . ' ',
        '#attributes' => array(
          'class' => array('hosting-select-frequency-items'),
        ),
      );
    }
    foreach (array_reverse(array_keys($units)) as $length) {
      $unit = $units[$length];

      if (!($info['frequency'] % $length)) {
        $frequency_ticks = $info['frequency'] / $length;
        $frequency_length = $length;
        break;
      }
    }
    $form[$queue]['frequency']["ticks"] = array(
      '#type' => 'textfield',
      '#default_value' => $frequency_ticks,
      '#maxlength' => 5,
      '#size' => 5,
      '#attributes' => array(
        'class' => array('hosting-select-frequency-ticks'),
      ),
    );
    $form[$queue]['frequency']["unit"] = array(
      '#type' => 'select',
      '#options' => $units,
      '#default_value' => $frequency_length,
      '#attributes' => array(
        'class' => array('hosting-select-frequency-unit'),
      ),
    );
  }
  $form['help'] = array(
    '#type' => 'item',
    '#description' => t("Increasing the queue frequency to every 1 second will not cause them to be dispatched every second, as the dispatcher can only run once per minute via cron. However, with such a short frequency, executing the hosting-dispatch command manually from the CLI will allow you to 'force' the queues to be dispatched between cron runs. This may be useful for development purposes."),
  );
  $form['submit'] = array(
    '#type' => 'submit',
    '#value' => t('Save changes'),
  );
  return $form;
}

/**
 * Theme function to render the queue configuration form.
 *
 * @see hosting_queues_configure()
 */
function theme_hosting_queues_configure($variables) {
  $form = $variables['form'];
  $queues = hosting_get_queues();

  $rows = array();
  $header = array(
    t('Queue'),
    array(
      'data' => t('Frequency'),
      'class' => array('hosting-queue-frequency-head'),
    ),
    t('Last run'),
  );
  foreach ($queues as $key => $info) {
    $row = array();
    $row[] = \Drupal::service('renderer')->render($form[$key]['enabled']);
    $row[] = \Drupal::service('renderer')->render($form[$key]['frequency']);
    $row[] = \Drupal::service('renderer')->render($form[$key]['last_run']);
    $rows[] = $row;
  }
  $output = \Drupal::service('theme.manager')->render('table', array('header' => $header, 'rows' => $rows));
  $output .= \Drupal::service('renderer')->render($form['help']);
  $output .= \Drupal::service('renderer')->render($form['submit']);
  $output .= \Drupal::service('renderer')->render($form);
  return $output;
}

/**
 * Validation callback for the the queue execution frequency form.
 *
 * @see hosting_queues_configure()
 */
function hosting_queues_configure_validate($form, \Drupal\Core\Form\FormStateInterface $form_state) {
  foreach (hosting_get_queues() as $queue => $info) {
    $queue_values = $form_state->getValue($queue);
    if (!$queue_values) {
      continue;
    }
    $frequency = $queue_values['frequency'] ?? [];
    $ticks = $frequency['ticks'] ?? NULL;
    if ($ticks !== NULL && $ticks !== '' && !is_numeric($ticks)) {
      $form_state->setErrorByName($queue, t('Please enter a valid frequency.'));
    }
    $items = $frequency['items'] ?? NULL;
    if ($items !== NULL && $items !== '' && !is_numeric($items)) {
      $form_state->setErrorByName($queue, t('Please enter a valid amount of items.'));
    }
  }
}

/**
 * Submit callback for the the queue execution frequency form.
 *
 * @see hosting_queues_configure()
 */
function hosting_queues_configure_submit($form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $config = \Drupal::configFactory()->getEditable('hosting.queues');
  foreach (hosting_get_queues() as $queue => $info) {
    $queue_values = $form_state->getValue($queue);
    if ($queue_values) {
      $queue_config = $config->get('queues.' . $queue) ?: [];
      $queue_config['enabled'] = (bool) ($queue_values['enabled'] ?? FALSE);
      $queue_config['frequency'] = (int) (($queue_values['frequency']['ticks'] ?? 0) * ($queue_values['frequency']['unit'] ?? 0));
      if ($info['type'] == HOSTING_QUEUE_TYPE_SERIAL) {
        $queue_config['items'] = (int) ($queue_values['frequency']['items'] ?? 0);
      }
      $config->set('queues.' . $queue, $queue_config);
    }
  }
  $config->save();
  \Drupal::messenger()->addMessage(t('The queue settings have been updated.'));
}

/**
 * Implements hook_form_alter().
 */
function hosting_form_alter(&$form, &$form_state, $form_id) {
  // Do not allow package or task entities to be edited through the interface.
  if (in_array($form_id, array(
    'hosting_package_form',
    'hosting_package_add_form',
    'hosting_package_edit_form',
    'hosting_task_form',
    'hosting_task_add_form',
    'hosting_task_edit_form',
  ), TRUE)) {
    throw new \Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException();
  }

  // Alter the 'Add User' form to remind users that this is not the New Client
  // form.
  if ($form_id == 'user_register') {
      $form['user_registration_help'] = array(
        '#type' => 'item',
        '#description' => t('<strong>Adding a system user account does not make the user a Client that can add sites.</strong><br />
                     To add a Client, enable the Client feature and then add a new Client.<br />
                     If you wish, you may then assign this system user to the Client as an \'Allowed user\' to inherit the permissions to add sites.'),
        '#weight' => '-10',
      );
  }

  // Remove additional UI added by core modules, it conflicts with the our UI.
  $entity_forms = array(
    'hosting_site_form',
    'hosting_site_add_form',
    'hosting_site_edit_form',
    'hosting_platform_form',
    'hosting_platform_add_form',
    'hosting_platform_edit_form',
    'hosting_server_form',
    'hosting_server_add_form',
    'hosting_server_edit_form',
    'hosting_client_form',
    'hosting_client_add_form',
    'hosting_client_edit_form',
  );
  if (in_array($form_id, $entity_forms, TRUE)) {
    if (isset($form['options'])) {
      $form['options']['#access'] = FALSE;
    }
    if (isset($form['revision_information'])) {
      $form['revision_information']['#access'] = FALSE;
    }
    if (isset($form['author'])) {
      $form['author']['#access'] = FALSE;
    }
    if (isset($form['actions']['preview'])) {
      $form['actions']['preview']['#access'] = FALSE;
    }

    $form['#submit'][] = 'hosting_form_submit_messages';
  }
}

/**
 * Submit handler for hosting entity forms: display helpful messages.
 */
function hosting_form_submit_messages($form, $form_state) {
  $entity = NULL;
  $values = array();

  if (is_array($form_state)) {
    $values = isset($form_state['values']) && is_array($form_state['values']) ? $form_state['values'] : array();
    if (isset($form_state['entity'])) {
      $entity = $form_state['entity'];
    }
  }
  elseif ($form_state instanceof \Drupal\Core\Form\FormStateInterface) {
    $values = $form_state->getValues();
    $form_object = $form_state->getFormObject();
    if ($form_object && method_exists($form_object, 'getEntity')) {
      $entity = $form_object->getEntity();
    }
  }

  if (!$entity) {
    return;
  }

  $entity_type_id = hosting_entity_type_id($entity);
  $scope = $entity_type_id ? hosting_entity_type_to_task_scope($entity_type_id) : NULL;
  if (!in_array($scope, array('site', 'platform', 'server'), TRUE)) {
    return;
  }

  $title = isset($values['title']) ? $values['title'] : hosting_entity_label($entity);
  $t = array(
    '@type' => $scope,
    '%title' => $title ?: '',
    '%task' => t('Verify'),
  );

  $is_new = ($entity instanceof \Drupal\Core\Entity\EntityInterface) ? $entity->isNew() : empty(hosting_entity_id($entity));
  if ($is_new) {
    $t['!message'] = t('It will be available once the task is completed.');

    if ($scope == 'site') {
      $t['%task'] = t('Install');
    }
  }
  else {
    $t['!message'] = t('Changes will be applied once the task is completed.');
  }

  \Drupal::messenger()->addMessage(t('%task task has been queued for @type %title. !message', $t));

  $queues = hosting_get_queues();
  if ($queues['tasks']['enabled']) {
    $until = _hosting_queue_next_run('tasks') - REQUEST_TIME;
    \Drupal::messenger()->addMessage(t('Task is scheduled to start in approximately %until.', array('%until' => \Drupal::service('date.formatter')->formatInterval($until))));
  }
}


/**
 * Get the entity associated with a given provision context.
 *
 * @param string $name
 *   The name of the context to load.
 *
 * @return bool|object
 *   Either the entity object associated with the context, or FALSE if no
 */
function hosting_context_load($name) {
  $name = ltrim($name, '@');
  // TODO: introduce static caching ?

  $result = \Drupal::database()->query("SELECT entity_id FROM {hosting_context} WHERE name = :name", array(':name' => $name));

  if ($obj = $result->fetch()) {
    $entity_type_id = hosting_entity_type_from_context_name($name);
    if ($entity_type_id && \Drupal::entityTypeManager()->hasDefinition($entity_type_id)) {
      $entity = \Drupal::entityTypeManager()->getStorage($entity_type_id)->load($obj->entity_id);
    }
    if (!$entity) {
      $entity = hosting_entity_load_any($obj->entity_id);
    }
    if ($entity) {
      if ($entity->hasField('hosting_name')) {
        $entity->set('hosting_name', $name);
      }
      else {
        $entity->hosting_name = $name;
      }
      return $entity;
    }
  }
  return FALSE;
}

/**
 * Add an entity to the context lookup db.
 *
 * @param int $entity_id
 *   The entity ID to associate to the given provision context name.
 * @param string $name
 *   The name of the provision context.
 */
function hosting_context_register($entity_id, $name) {
  $name = ltrim($name, '@');
  $entity_type_id = hosting_entity_type_from_context_name($name);
  $entity = NULL;
  if ($entity_type_id && \Drupal::entityTypeManager()->hasDefinition($entity_type_id)) {
    $entity = \Drupal::entityTypeManager()->getStorage($entity_type_id)->load($entity_id);
    if ($entity && $entity->hasField('hosting_name')) {
      $entity->set('hosting_name', $name);
      $entity->save();
    }
  }

  // Check first to see if this ID exists in the system. If so, update its
  // name.
  if ($result = \Drupal::database()->query("SELECT entity_id FROM {hosting_context} WHERE entity_id = :entity_id", array(':entity_id' => $entity_id))->fetch()) {
    \Drupal::database()->update('hosting_context')
      ->fields(array(
        'name' => $name,
      ))
      ->condition('entity_id', $entity_id)
      ->execute();
  }
  else {
    // It's a new item.
    $id = \Drupal::database()->insert('hosting_context')
      ->fields(array(
        'entity_id' => $entity_id,
        'name' => $name,
      ))
      ->execute();
  }

  $alias_storage = \Drupal::entityTypeManager()->getStorage('path_alias');
  $alias_path = '/hosting/c/' . $name;
  $existing_aliases = $alias_storage->loadByProperties(['alias' => $alias_path]);
  if (!empty($existing_aliases)) {
    $alias_storage->delete($existing_aliases);
  }

  if (!$entity) {
    return;
  }
  $source_path = $entity->toUrl('canonical')->toString();
  $alias_storage->create([
    'path' => $source_path,
    'alias' => $alias_path,
    'langcode' => \Drupal\Core\Language\LanguageInterface::LANGCODE_NOT_SPECIFIED,
  ])->save();
}

/**
 * Delete an alias from the context lookup table.
 *
 * @param int $entity_id
 *   The entity ID to remove the association from.
 */
function hosting_context_delete($entity_id) {
  $alias_storage = \Drupal::entityTypeManager()->getStorage('path_alias');
  $name = \Drupal::database()->query("SELECT name FROM {hosting_context} WHERE entity_id = :entity_id", array(':entity_id' => $entity_id))->fetchField();
  if ($name) {
    $alias_path = '/hosting/c/' . $name;
    $aliases = $alias_storage->loadByProperties(['alias' => $alias_path]);
    if (!empty($aliases)) {
      $alias_storage->delete($aliases);
    }

    $entity_type_id = hosting_entity_type_from_context_name($name);
    if ($entity_type_id) {
      $entity = \Drupal::entityTypeManager()->getStorage($entity_type_id)->load($entity_id);
      if ($entity) {
        $source_path = $entity->toUrl('canonical')->toString();
        $aliases = $alias_storage->loadByProperties(['path' => $source_path]);
        if (!empty($aliases)) {
          $alias_storage->delete($aliases);
        }
      }
    }
  }

  \Drupal::database()->delete('hosting_context')
    ->condition('entity_id', $entity_id)
    ->execute();
}


/**
 * Return the hosting context name for an entity.
 *
 * @param int $entity_id
 *   The entity ID to get the provision context name for.
 *
 * @return string|bool
 *   The provision context name associated with the specified entity, will be
 *   prefixed with '@' or FALSE if the entity does not exist.
 */
function hosting_context_name($entity_id) {
  $name = \Drupal::database()->query("SELECT name FROM {hosting_context} WHERE entity_id = :entity_id", array(':entity_id' => $entity_id))->fetchField();
  if (!$name) {
    \Drupal::messenger()->addMessage(t('Error: cannot load hosting id %id to find its context', array('%id' => $entity_id)), 'error');
    return FALSE;
  }
  return '@' . $name;
}


/**
 * Lookup the entity ID for a hosting context name.
 *
 * @param object|string $alias
 *   The name of the provision context to import.
 *
 * @return int
 *   The entity ID associated with the alias.
 */
function hosting_context_entity_id($alias) {
  $name = (is_object($alias)) ? $alias->name : $alias;
  $name = ltrim($name, '@');

  $result = \Drupal::database()->query("SELECT entity_id FROM {hosting_context} WHERE name = :name", array(':name' => $name));

  if ($obj = $result->fetch()) {
    return $obj->entity_id;
  }
  else {
    return hosting_drush_import($alias);
  }
}

/**
 * Import a backend context into the frontend.
 *
 * @param object|string $alias
 *   The name of the provision context to import.
 *
 * @return int|null
 *   The entity ID associated with the imported context, if successful.
 */
function hosting_drush_import($alias) {
  $name = is_object($alias) ? $alias->name : $alias;
  static $known_contexts = [];

  if (isset($known_contexts[$name])) {
    return $known_contexts[$name];
  }

  if (!function_exists('d')) {
    hosting_log(t('Provision context loader is unavailable for @name.', ['@name' => $name]), 'error', [], 'hosting');
    return NULL;
  }

  $context = d($name);
  if (!$context || empty($context->type)) {
    hosting_log(t('Unable to load context @name for import.', ['@name' => $name]), 'error', [], 'hosting');
    return NULL;
  }

  $entity_type_id = hosting_entity_type_from_task_scope($context->type);
  if (!$entity_type_id || !\Drupal::entityTypeManager()->hasDefinition($entity_type_id)) {
    hosting_log(t('Unknown context type @type for @name.', ['@type' => $context->type, '@name' => $name]), 'error', [], 'hosting');
    return NULL;
  }

  $node = hosting_context_load($name);
  if ($node instanceof \Drupal\Core\Entity\ContentEntityInterface) {
    if ($node->hasField('no_verify')) {
      $node->set('no_verify', TRUE);
    }
    $known_contexts[$name] = $node->id();
  }
  else {
    $node = \Drupal::entityTypeManager()->getStorage($entity_type_id)->create(['status' => 1]);
    $hosting_name = trim($context->name, '@');
    if ($node->hasField('hosting_name')) {
      $node->set('hosting_name', $hosting_name);
    }
    else {
      $node->hosting_name = $hosting_name;
    }
  }

  \Drupal::moduleHandler()->invokeAll('drush_context_import', [$context, $node]);

  if ($node->hasField('label') && !$node->label()) {
    $node->set('label', trim($context->name, '@'));
  }

  $node->save();
  hosting_context_register($node->id(), $node->hasField('hosting_name') ? $node->get('hosting_name')->value : trim($context->name, '@'));
  $known_contexts[$name] = $node->id();

  return $node->id();
}

/**
 * Define the entity types that have associated provision contexts.
 *
 * @deprecated See issue #2763509. If you really need this, you can check
 * if an entity ID is in the hosting_context table.
 */
function hosting_context_node_types() {
  return hosting_context_entity_types();
}

/**
 * Return the entity types that have associated provision contexts.
 */
function hosting_context_entity_types() {
  return array('hosting_site', 'hosting_platform', 'hosting_server');
}

/**
 * Return a list of log entry types.
 */
function hosting_log_types() {
  $known_types = [
    'error',
    'info',
    'message',
    'notice',
    'ok',
    'status',
    'success',
    'warning',
  ];
  $types_from_logs = \Drupal::database()->query('SELECT DISTINCT type FROM {hosting_task_log}')->fetchCol();
  $types = array_unique(array_merge($known_types, $types_from_logs));
  return array_combine($types, $types);
}

/**
 * General settings form.
 */
function hosting_settings($form, &$form_state) {
  $form['#attached']['library'][] = 'hosting/admin';
  $config = \Drupal::config('hosting.settings');
  $form['settings'] = array(
    '#type' => 'item',
    '#title' => t('General Hosting settings'),
    '#value' => t('Here you may set various general settings that apply to site management or to the frontend system.'),
    '#weight' => 0,
  );

  $profiles = array();
  foreach (hosting_get_profiles() as $id => $name) {
    $profile = hosting_package_instance_load(array('p.id' => $id));
    $profiles[$profile->short_name] = \Drupal::service('theme.manager')->render('hosting_site_profile', array('profile' => $profile, 'html' => ''));
    // Don't allow a site to be provisioned a restricted profile.
    if (in_array($name, array('Hostslave', 'Hostmaster'))) {
      unset($profiles[$profile->short_name]);
    }
  }
  natcasesort($profiles);
  $default_value = hosting_package_instance_load(array('p.id' => hosting_get_default_profile()))->short_name;
  $form['hosting_default_profile'] = array(
    '#type' => 'select',
    '#title' => t('Default profile'),
    '#options' => $profiles,
    '#description' => t('The default install profile to use when creating new sites.'),
    '#default_value' => $default_value,
  );
  $form['hosting_ignore_default_profiles'] = array(
    '#type' => 'checkbox',
    '#title' => t('Hide platforms with non-default profiles'),
    '#description' => t('When selecting a Drupal core profile, hide platforms that also contain other profiles (i.e intended as distributions). Warning: requires a platform other than the Hostmaster platform.'),
    '#default_value' => $config->get('hosting_ignore_default_profiles') ?? FALSE,
  );
  $form['hosting_lock_platforms_by_default'] = array(
    '#type' => 'checkbox',
    '#title' => t('Lock platforms by default on initial creation'),
    '#description' => t("When verifying a new platform, set its initial state to 'Locked'. This can avoid having sites created on a new platform before there has been a chance to test it. Those users with the 'create sites on locked platforms' permission (e.g., with the 'platform manager' role) will still be able to build sites."),
    '#default_value' => $config->get('hosting_lock_platforms_by_default') ?? FALSE,
  );
  $form['hosting_platform_automatic_site_import'] = array(
    '#type' => 'checkbox',
    '#title' => t('Automatically import sites when verifying platforms'),
    '#description' => t("When verifying a platform, if sites are found that do not yet exist in the front-end, automatically import them."),
    '#default_value' => $config->get('hosting_platform_automatic_site_import') ?? TRUE,
  );
  $form['hosting_require_disable_before_delete'] = array(
    '#type' => 'checkbox',
    '#title' => t('Require site to be disabled before deletion'),
    '#description' => t('Check if you wish for users to run the Disable task on a site prior to running the Delete task.'),
    '#default_value' => $config->get('hosting_require_disable_before_delete') ?? TRUE,
  );
  $form['hosting_delete_force'] = array(
    '#type' => 'checkbox',
    '#title' => t('Force sites, platforms, and servers to be removed when running the Delete task.'),
    '#description' => t('If something goes wrong when deleting a site, platform, or server, the task will fail. Check this box to force contexts to be removed when Delete tasks are run.'),
    '#default_value' => $config->get('hosting_delete_force') ?? FALSE,
  );
  if (hosting_feature('cron')) {
    $form['hosting_cron_use_backend'] = array(
      '#type' => 'radios',
      '#title' => t('Cron method'),
      '#description' => t('For running cron on a site. You can use the drush cron implementation or the web-based cron.php method using builtin HTTP requests. The drush implementation is more reliable but will be slower than the web-based approach if the webserver has an opcode cache (like APC) configured.'),
      '#options' => array('Web-based', 'Drush'),
      '#default_value' => $config->get('hosting_cron_use_backend') ?? TRUE,
    );
  }

  $types = hosting_log_types();

  $form['hosting_task_logs_types_display'] = array(
    '#type' => 'checkboxes',
    '#title' => t('Task Logs to Display'),
    '#description' => t('Select the types of logs you wish to show to the user.'),
    '#options' => $types,
    '#default_value' => $config->get('hosting_task_logs_types_display') ?? $types,
  );
  $form['#submit'][] = 'hosting_settings_submit';
  return $form;
}

/**
 * Submit handler for hosting settings.
 */
function hosting_settings_submit($form, &$form_state) {
  $values = is_object($form_state) && method_exists($form_state, 'getValues')
    ? $form_state->getValues()
    : $form_state['values'];
  $config = \Drupal::configFactory()->getEditable('hosting.settings');
  $keys = array(
    'hosting_default_profile',
    'hosting_ignore_default_profiles',
    'hosting_lock_platforms_by_default',
    'hosting_platform_automatic_site_import',
    'hosting_require_disable_before_delete',
    'hosting_delete_force',
    'hosting_cron_use_backend',
    'hosting_task_logs_types_display',
  );
  foreach ($keys as $key) {
    if (array_key_exists($key, $values)) {
      $config->set($key, $values[$key]);
    }
  }
  $config->save();
}

/**
 * Create the default hosting roles.
 */
function hosting_create_roles() {
  // Only allow access to our splash pages for anyone without a specific role.
  $access_roles = [
    \Drupal\user\RoleInterface::ANONYMOUS_ID,
    \Drupal\user\RoleInterface::AUTHENTICATED_ID,
  ];
  foreach ($access_roles as $role_id) {
    $role = \Drupal\user\Entity\Role::load($role_id);
    if ($role) {
      $role->grantPermission('access disabled sites');
      $role->save();
    }
  }

  $default_roles = [
    'aegir_client' => [
      'label' => 'aegir client',
      'weight' => 4,
    ],
    'aegir_account_manager' => [
      'label' => 'aegir account manager',
      'weight' => 6,
    ],
    'aegir_platform_manager' => [
      'label' => 'aegir platform manager',
      'weight' => 8,
    ],
    'aegir_administrator' => [
      'label' => 'aegir administrator',
      'weight' => 10,
    ],
  ];

  foreach ($default_roles as $role_id => $info) {
    $role = \Drupal\user\Entity\Role::load($role_id);
    if (!$role) {
      $role = \Drupal\user\Entity\Role::create([
        'id' => $role_id,
        'label' => $info['label'],
        'weight' => $info['weight'],
      ]);
    }
    else {
      $role->set('label', $info['label']);
      $role->setWeight($info['weight']);
    }
    $role->save();
  }

  // Create a default role for site administrators,
  // with all available permissions assigned.
  $admin_role = \Drupal\user\Entity\Role::load('administrator');
  if (!$admin_role) {
    $admin_role = \Drupal\user\Entity\Role::create([
      'id' => 'administrator',
      'label' => 'administrator',
      'weight' => 20,
    ]);
  }
  $admin_role->set('permissions', array_keys(\Drupal::service('user.permissions')->getPermissions()));
  $admin_role->save();

  // Set this as the administrator role.
  \Drupal::state()->set('user_admin_role', $admin_role->id());

  // Assign user 1 the "administrator" role.
  $user = \Drupal::entityTypeManager()->getStorage('user')->load(1);
  if ($user) {
    $user->addRole($admin_role->id());
    $user->save();
  }
}

/**
 * Implements hook_modules_enabled().
 */
function hosting_modules_enabled($modules) {
  // List any features whose module was just enabled.
  $features = hosting_get_features();
  $enable = array();
  $config = \Drupal::config('hosting.features');
  foreach ($features as $feature => $info) {
    $status = $config->get('features.' . $feature);
    if (in_array($info['module'], $modules) && !$status) {
      $enable[$info['module']] = $feature;
    }
  }

  hosting_features_enable($enable, TRUE, FALSE);

  $refresh_admin = FALSE;
  foreach ($modules as $module) {
    if ($module === 'hosting' || str_starts_with($module, 'hosting_')) {
      $refresh_admin = TRUE;
      hosting_install_view_configs($module);
      hosting_install_form_display_configs($module);
      if ($module === 'hosting_site' || $module === 'hosting_platform') {
        hosting_install_action_configs($module);
      }
    }
  }

  if ($refresh_admin) {
    $admin_role_id = \Drupal::state()->get('user_admin_role') ?: 'administrator';
    $admin_role = \Drupal\user\Entity\Role::load($admin_role_id);
    if ($admin_role) {
      $admin_role->set('permissions', array_keys(\Drupal::service('user.permissions')->getPermissions()));
      $admin_role->save();
    }
  }
}

/**
 * Implements hook_modules_disabled().
 */
function hosting_modules_disabled($modules) {
  // List any features whose module was just disabled.
  $features = hosting_get_features();
  $disable = array();
  $config = \Drupal::config('hosting.features');
  foreach ($features as $feature => $info) {
    $status = $config->get('features.' . $feature);
    if (in_array($info['module'], $modules) && $status !== 0 && $status !== NULL) {
      $disable[$info['module']] = $feature;
    }
  }

  hosting_features_disable($disable, $rebuild = TRUE, $disable_module = FALSE);
}

/**
 * Return a logger suitable for CLI or web requests.
 */
function hosting_logger($channel = 'hosting') {
  if (class_exists(\Drush\Drush::class) && \Drush\Drush::hasContainer()) {
    return \Drush\Drush::logger();
  }
  return \Drupal::logger($channel);
}

/**
 * Log a message with a normalized severity level.
 */
function hosting_log($message, $severity = 'notice', array $context = [], $channel = 'hosting') {
  $levels = [
    'ok' => 'info',
    'success' => 'info',
    'queue' => 'info',
    'message' => 'notice',
  ];
  $level = $levels[$severity] ?? $severity;
  hosting_logger($channel)->log($level, (string) $message, $context);
}

/**
 * Read a CLI option when running under Drush.
 */
function hosting_get_cli_option($keys, $default = NULL) {
  if (!class_exists(\Drush\Drush::class) || !\Drush\Drush::hasContainer()) {
    return $default;
  }
  $input = \Drush\Drush::input();
  foreach ((array) $keys as $key) {
    if ($input->hasOption($key)) {
      $value = $input->getOption($key);
      if ($value !== NULL) {
        return $value;
      }
    }
  }
  return $default;
}

/**
 * Execute a Drush command and return its output details.
 */
function hosting_run_drush_command($site_alias, $command, array $args = [], array $options = [], array $backend_options = []) {
  if (!class_exists(\Drush\Drush::class) || !\Drush\Drush::hasContainer()) {
    throw new \Drush\Exceptions\UserAbortException('Drush is not available for backend invocation.');
  }

  $alias = \Drush\Drush::aliasManager()->get($site_alias);
  if (!$alias) {
    throw new \Drush\Exceptions\UserAbortException("Alias {$site_alias} not found.");
  }

  $fork = !empty($backend_options['fork']);
  $backend_cli_options = $backend_options;
  unset($backend_cli_options['fork']);
  $options = $backend_cli_options + $options;

  $process = \Drush\Drush::drush($alias, $command, $args, $options);
  if ($fork) {
    $process->start();
    return [
      'error_status' => 0,
      'output' => '',
      'error' => '',
    ];
  }

  $process->run();
  return [
    'error_status' => $process->getExitCode() ?? 1,
    'output' => $process->getOutput(),
    'error' => $process->getErrorOutput(),
  ];
}

/**
 * Store per-process task context for hosting:task execution.
 */
function &hosting_task_context_storage() {
  static $store = [
    'task' => NULL,
    'output' => [],
    'options' => [],
    'errors' => [],
    'last_error' => NULL,
  ];
  return $store;
}

function hosting_task_set_current($task) {
  $store = &hosting_task_context_storage();
  $store['task'] = $task;
}

function hosting_task_get_current() {
  $store = &hosting_task_context_storage();
  return $store['task'];
}

function hosting_task_set_output(array $output) {
  $store = &hosting_task_context_storage();
  $store['output'] = $output;
}

function hosting_task_get_output(): array {
  $store = &hosting_task_context_storage();
  return $store['output'];
}

function hosting_task_set_options(array $options) {
  $store = &hosting_task_context_storage();
  $store['options'] = $options;
}

function hosting_task_get_option($key, $default = NULL) {
  $store = &hosting_task_context_storage();
  return array_key_exists($key, $store['options']) ? $store['options'][$key] : $default;
}

function hosting_task_set_error($code, $message) {
  $store = &hosting_task_context_storage();
  $store['errors'][$code] = $message;
  $store['last_error'] = $message;
}

function hosting_task_has_error($code): bool {
  $store = &hosting_task_context_storage();
  return array_key_exists($code, $store['errors']);
}

function hosting_task_get_last_error() {
  $store = &hosting_task_context_storage();
  return $store['last_error'];
}

function hosting_task_clear_errors(): void {
  $store = &hosting_task_context_storage();
  $store['errors'] = [];
  $store['last_error'] = NULL;
}

/**
 * Check backend output for a specific error code.
 */
function hosting_output_has_error_code(array $output, $code): bool {
  if (empty($output['error_log']) || !is_array($output['error_log'])) {
    return FALSE;
  }
  foreach ($output['error_log'] as $entry) {
    if (is_array($entry)) {
      foreach ($entry as $value) {
        if (is_scalar($value) && strpos((string) $value, $code) !== FALSE) {
          return TRUE;
        }
      }
    }
    elseif (is_scalar($entry) && strpos((string) $entry, $code) !== FALSE) {
      return TRUE;
    }
  }
  return FALSE;
}
