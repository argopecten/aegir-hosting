<?php

/**
 * @file
 * Hosting module.
 *
 * Contains just about all the interface magic of hostmaster.
 */

/**
 * The maximum length for a site alias.
 * Leaving room to append '.alias.drushrc.php' and keep filenames below 255.
 */
define('HOSTING_MAX_ALIAS_LENGTH', 235);

/**
 * A serial queue type.
 *
 * This queue will be processed at a specified interval. When the interval has
 * elapsed a configurable number of the items will be processed.
 */
define('HOSTING_QUEUE_TYPE_SERIAL', 'serial');

/**
 * A batch queue type.
 *
 * This queue type aims to process repeatable tasks spread out over a
 * configurable interval.
 *
 * See the processing code in hosting_get_queues() for the exact
 * implementation.
 *
 * This queue type will:
 * - Process items in the queue at some small number of specific points, evenly spaced throughout
 *   the configurable interval.
 * - Process as many items at those intervals so that all the items are
 *   processed at least once over the configurable interval.
 *
 * @see HOSTING_QUEUE_TYPE_SPREAD
 */
define('HOSTING_QUEUE_TYPE_BATCH', 'batch');

/**
 * A spread queue type.
 *
 * This queue type aims to process repeatable tasks spread out over a
 * configurable interval.
 *
 * See the processing code in hosting_get_queues() for the exact
 * implementation.
 *
 * This queue type will attempt to:
 * - Process items at as many points as possible evenly spread over the
 *   configurable interval.
 * - Points will be at least 1 minute apart to allow for the default dispatcher to execute them.
 * - At each point process the minimum number of items needed to result in all
 *   items being processed at least once over the configurable interval.
 *
 * @see HOSTING_QUEUE_TYPE_BATCH
 */
define('HOSTING_QUEUE_TYPE_SPREAD', 'spread');

/**
 * Default lock wait time for queue processing.
 */
define('HOSTING_QUEUE_DEFAULT_LOCK_WAIT', 30);

/**
 * Lock timeout for queue processing.
 */
define('HOSTING_QUEUE_LOCK_TIMEOUT', 3600.0);

/**
 * Not split for performance reasons. Just to keep code together.
 */
include_once dirname(__FILE__) . '/hosting.inc';
include_once dirname(__FILE__) . '/hosting.queues.inc';
include_once dirname(__FILE__) . '/hosting.features.inc';

/**
 * Return the entity ID for a hosting entity.
 */
function hosting_entity_id($entity) {
  if (is_numeric($entity)) {
    return (int) $entity;
  }
  if ($entity instanceof \Drupal\Core\Entity\EntityInterface) {
    return (int) $entity->id();
  }
  return NULL;
}

/**
 * Return the entity type ID for a hosting entity.
 */
function hosting_entity_type_id($entity) {
  if ($entity instanceof \Drupal\Core\Entity\EntityInterface) {
    return $entity->getEntityTypeId();
  }
  if (is_string($entity)) {
    return $entity;
  }
  return NULL;
}

/**
 * Map an entity type ID to a task scope string.
 */
function hosting_entity_type_to_task_scope($entity_type_id) {
  $map = array(
    'hosting_site' => 'site',
    'hosting_platform' => 'platform',
    'hosting_server' => 'server',
    'hosting_client' => 'client',
    'hosting_package' => 'package',
    'hosting_task' => 'task',
  );
  return isset($map[$entity_type_id]) ? $map[$entity_type_id] : $entity_type_id;
}

/**
 * Map a task scope string to a hosting entity type ID.
 */
function hosting_entity_type_from_task_scope($scope) {
  $map = array(
    'site' => 'hosting_site',
    'platform' => 'hosting_platform',
    'server' => 'hosting_server',
    'client' => 'hosting_client',
    'package' => 'hosting_package',
    'task' => 'hosting_task',
  );
  return isset($map[$scope]) ? $map[$scope] : $scope;
}

/**
 * Return the task scope string for a hosting entity.
 */
function hosting_entity_task_scope($entity) {
  $entity_type_id = hosting_entity_type_id($entity);
  return $entity_type_id ? hosting_entity_type_to_task_scope($entity_type_id) : NULL;
}

/**
 * Resolve a hosting entity type ID from a context name.
 */
function hosting_entity_type_from_context_name($name) {
  $name = ltrim($name, '@');
  $prefix = strtok($name, '_');
  if ($prefix === FALSE || $prefix === '') {
    return NULL;
  }
  return hosting_entity_type_from_task_scope($prefix);
}

/**
 * Load a hosting entity using the hosting_context mapping.
 */
function hosting_entity_load_from_context_id($id) {
  $name = \Drupal::database()->query("SELECT name FROM {hosting_context} WHERE entity_id = :entity_id", [':entity_id' => $id])->fetchField();
  if ($name) {
    $entity_type_id = hosting_entity_type_from_context_name($name);
    if ($entity_type_id) {
      return \Drupal::entityTypeManager()->getStorage($entity_type_id)->load($id);
    }
  }
  return hosting_entity_load_any($id);
}

/**
 * Attempt to load a hosting entity by ID when no context mapping exists.
 */
function hosting_entity_load_any($id) {
  if (!is_numeric($id)) {
    return NULL;
  }
  $entity_types = array(
    'hosting_site',
    'hosting_platform',
    'hosting_server',
    'hosting_client',
    'hosting_package',
    'hosting_task',
  );
  foreach ($entity_types as $entity_type_id) {
    $entity = \Drupal::entityTypeManager()->getStorage($entity_type_id)->load($id);
    if ($entity) {
      return $entity;
    }
  }
  return NULL;
}

/**
 * Return a display label for a hosting entity.
 */
function hosting_entity_label($entity) {
  if ($entity instanceof \Drupal\Core\Entity\EntityInterface) {
    if ($entity->getEntityTypeId() === 'hosting_site') {
      return hosting_site_canonical_url($entity);
    }
    return $entity->label();
  }
  return NULL;
}

/**
 * Run post-install hooks once the hostmaster site exists.
 */
function hosting_post_install_if_ready($hostmaster_id = NULL) {
  $state = \Drupal::state();
  if ($state->get('hosting_post_install_complete')) {
    return FALSE;
  }

  $hostmaster_id = $hostmaster_id ?: (int) $state->get('aegir_hostmaster_site_id');
  if (!$hostmaster_id) {
    return FALSE;
  }

  $hostmaster = \Drupal::entityTypeManager()->getStorage('hosting_site')->load($hostmaster_id);
  if (!$hostmaster instanceof \Drupal\Core\Entity\EntityInterface) {
    return FALSE;
  }

  \Drupal::moduleHandler()->invokeAll('hosting_post_install', [$hostmaster]);
  $state->set('hosting_post_install_complete', $hostmaster_id);
  return TRUE;
}

/**
 * Return a normalized status value for a hosting entity.
 */
function hosting_entity_status($entity, $scope = NULL) {
  if ($entity instanceof \Drupal\Core\Entity\ContentEntityInterface && $entity->hasField('status')) {
    return (int) $entity->get('status')->value;
  }
  if (is_object($entity)) {
    if (isset($entity->status)) {
      return (int) $entity->status;
    }
    if ($scope) {
      $scoped = $scope . '_status';
      if (isset($entity->$scoped)) {
        return (int) $entity->$scoped;
      }
    }
    if (isset($entity->site_status)) {
      return (int) $entity->site_status;
    }
    if (isset($entity->platform_status)) {
      return (int) $entity->platform_status;
    }
  }
  return NULL;
}



/**
 * Page callback for a page to be rendered in modal frame.
 */
function hosting_js_page() {
  $args = func_get_args();
  $path = implode('/', $args);
  $path = '/' . ltrim($path, '/');

  $request = \Symfony\Component\HttpFoundation\Request::create($path);
  return \Drupal::service('http_kernel')->handle($request, \Symfony\Component\HttpKernel\HttpKernelInterface::SUB_REQUEST);
}


/**
 * Page callback for denied access.
 */
function hosting_access_denied() {
  throw new \Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException();
}

/**
 * Page callback for a site that has been disabled.
 */
function hosting_disabled_site() {
  return t("This site has been disabled by the site administrators");
}

/**
 * Page callback for a site that is undergoing maintenance.
 */
function hosting_site_maintenance() {
  return t("This site is currently in maintenance. Check back later.");
}

/**
 * Implements hook_page_attachments().
 */
function hosting_page_attachments(array &$attachments) {
  $attachments['#attached']['library'][] = 'hosting/base';
}

/**
 * Implements hook_theme().
 */
function hosting_theme($existing, $type, $theme, $path) {
  return array(
    'hosting_queues_configure' => array(
      'file' => 'hosting.module',
      'render element' => 'form',
    ),
    'hosting_feature_dependencies' => array(
      'file' => 'hosting.features.inc',
      'arguments' => array(
        'dependencies' => NULL,
        'prefix' => NULL,
        'features' => NULL,
      ),
    ),
  );
}

/**
 * Generates a link to a hosting entity.
 */
function _hosting_node_link($entity_or_id, $title = NULL) {
  if (is_null($entity_or_id)) {
    return t("None");
  }
  $entity = NULL;
  if ($entity_or_id instanceof \Drupal\Core\Entity\EntityInterface) {
    $entity = $entity_or_id;
  }
  else {
    $entity_id = hosting_entity_id($entity_or_id);
    $context_name = $entity_id ? \Drupal::database()->query("SELECT name FROM {hosting_context} WHERE entity_id = :entity_id", [':entity_id' => $entity_id])->fetchField() : NULL;
    $entity_type_id = $context_name ? hosting_entity_type_from_context_name($context_name) : NULL;
    if ($entity_type_id) {
      $entity = \Drupal::entityTypeManager()->getStorage($entity_type_id)->load($entity_id);
    }
    if (!$entity) {
      $entity = hosting_entity_load_any($entity_id);
    }
  }

  if (!isset($title)) {
    $title = hosting_entity_label($entity);
    if ($entity instanceof \Drupal\Core\Entity\ContentEntityInterface && $entity->hasField('human_name') && !$entity->get('human_name')->isEmpty()) {
      $title = $entity->get('human_name')->value;
    }
  }
  $title = \Drupal\Component\Utility\Xss::filter($title ?? '');
  if ($entity instanceof \Drupal\Core\Entity\EntityInterface) {
    return $entity->access('view') ? \Drupal\Core\Link::fromTextAndUrl($title, $entity->toUrl('canonical'))->toString() : $title;
  }
  return $title;
}

/**
 * Build a block summarising the hosting queues.
 */
function hosting_queue_summary_block() {
  if (\Drupal::currentUser()->hasPermission('administer hosting queues')) {
    $queues = hosting_get_queues();
    $date_formatter = \Drupal::service('date.formatter');
    $output = '';
    foreach ($queues as $queue => $info) {
      $disp = array();
      // Special case.
      if (!$info['enabled']) {
        $disp[] = t('Status: disabled');
        continue;
      }
      $disp[] = t('Status: enabled');
      foreach (array(
        'description' => t('Description'),
        'frequency' => t('Frequency'),
        'items' => t('Items per run'),
        'total_items' => t('Items in queue'),
        'last_run' => t('Last run'),
      ) as $key => $title) {
        if ($key == 'last_run') {
          $info[$key] = hosting_format_interval($info[$key]);
        }
        elseif ($key == 'frequency') {
          $info[$key] = t('every @interval', array('@interval' => $date_formatter->formatInterval($info[$key])));
        }
        $disp[] = $title . ": " . $info[$key];
      }
      $output .= \Drupal::service('theme.manager')->render('item_list', array('items' => $disp, 'title' => $info['name']));
    }
    return $output;
  }
}

/**
 * Build a block of the hosting queues.
 *
 * @see hosting_TASK_SINGULAR_summary()
 */
function hosting_queue_block() {
  if (\Drupal::currentUser()->hasPermission('access task logs')) {
    $queues = hosting_get_queues();
    $output = '';
    foreach ($queues as $queue => $info) {
      // Invoke hosting_TASK_SINGULAR_summary().
      $func = 'hosting_' . $info['singular'] . '_summary';
      if (function_exists($func)) {
        $output .= $func();
      }
    }
    return $output;
  }
}

