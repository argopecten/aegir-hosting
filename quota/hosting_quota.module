<?php
/**
 * @file
 * Implement quota's for the resource used by client.
 */

/**
 * Provide dynamic quota permissions.
 */
function hosting_quota_permissions() {
  $permissions = [];
  $all_resources = \Drupal::moduleHandler()->invokeAll('hosting_quota_resource');
  foreach ($all_resources as $resource => $data) {
    $permissions["bypass resource $resource limit"] = [
      'title' => t('bypass resource @resource limit', ['@resource' => $resource]),
    ];
  }
  return $permissions;
}

/**
 * Get info about hosting quotas
 *
 * We call here every declaration of hook_hosting_quota_resource
 *
 * @param $resource string
 *   The name of the requested resource
 * @return array|bool
 *   A multidimensional array containing the resource, or false if the provided resource does not validate
 */
function hosting_quota_get($resource) {
  $all_resources = \Drupal::moduleHandler()->invokeAll('hosting_quota_resource');

  if (in_array($resource, array_keys($all_resources))) {
    return $all_resources[$resource];
  }
  else {
    // $resource is not valid, so generate an error
    \Drupal::logger('hosting_quota')->error('Invalid resource called');
    return FALSE;
  }
}

/**
 * Get the usage for the specified resource
 *
 * This function does not always return a human readable value - in some
 * cases the value may be in bits or bytes, and needs the appropriate
 * hook_hosting_quota_render_resource function to be called in order to
 * be readable.
 *
 * @param $client int
 *   The id of the client entity
 * @param $resource string
 *   The machine name of the resource, or a resource as returned by hosting_quota_get
 * @param $start string
 *   Optional start date of the checking perios, defaults to 1st of last month
 * @param $end string
 *   Optional end date of the checked period, defaults to 1st of this month
 * @return
 *   An integer representing the quota usage
 */

/**
 * @todo Please document this function.
 * @see http://drupal.org/node/1354
 */
function hosting_quota_get_usage($client, $resource, $start = NULL, $end = NULL) {
  $quota_usage = 0;

  // Set up some default dates for the last month if necessary
  if (!$start || !$end) {
    $end = date('Y-m-d', mktime(0, 0, 0, date("m"), 1,    date("Y")));
    $start = date('Y-m-d', mktime(0, 0, 0, date("m") -1, 1,    date("Y")));
  }

  // Get the resource info if necessary
  if (!is_array($resource)) {
    $resource = hosting_quota_get($resource);
  }
  $resource_name = key($resource);
  $resource = $resource[$resource_name];
  // We're finally ready to fetch the usage info!
  if ($resource['module']) {
    $quota_usage = \Drupal::moduleHandler()->invoke($resource['module'], 'hosting_quota_get_usage', [$client, $resource_name, $start, $end]);
  }

  return $quota_usage;
}

/**
 * Rendering function for quotas
 *
 * @param $resource array|string
 *   Either a resource retrieved via hosting_quota_get or the machine name of a resource
 * @param $usage int
 *   The usage as returned by hosting_quota_get_usage
 * @return mixed
 *   The rendered usage string
 */
function hosting_quota_resource_render($resource, $usage) {
  $rendered_usage = '';
  if (!is_array($resource)) {
    $resource = hosting_quota_get($resource);
  }
  $resource_name = key($resource);
  $resource = $resource[$resource_name];
  if ($resource['module']) {
    $rendered_usage = \Drupal::moduleHandler()->invoke($resource['module'], 'hosting_quota_resource_render', [$resource_name, $usage]);
  }

  return $rendered_usage;
}

/**
 * Set the hosting quota for a given resource.
 *
 * @param $client
 *   The id of the client entity.
 * @param $resource
 *   The machine name of the resource.
 * @param $value
 *   The new value for the resource.
 */
function hosting_quota_set_limit($client, $resource, $value) {
  if (\Drupal::database()->query("SELECT COUNT(*) FROM {hosting_client_quota} WHERE client = :client AND resource = :resource", array(':client' => $client, ':resource' => $resource))->fetchField()) {
    $id = \Drupal::database()->update('hosting_client_quota')
      ->fields(array(
        'value' => $value,
      ))
      ->condition('client', $client)
      ->condition('resource', $resource)
      ->execute();
  }
  else {
    $id = \Drupal::database()->insert('hosting_client_quota')
      ->fields(array(
        'client' => $client,
        'resource' => $resource,
        'value' => $value,
      ))
      ->execute();
  }
}

/**
 * Quickly check if a given quota has been exceeded
 *
 * @param $client int
 *   The id of the client entity
 * @param $resource string
 *   The machine name of the resource, or a resource as returned by hosting_quota_get
 * @param $start string
 *   Optional start date of the checking perios, defaults to 1st of last month
 * @param $end string
 *   Optional end date of the checked period, defaults to 1st of this month
 * @return bool|null
 *   True if the limit is higher than usage, false otherwise, or null if the resource could not be checked
 */
function hosting_quota_check($client, $resource, $start = NULL, $end = NULL) {
  // Set up some default dates for the last month if necessary
  if (!$start || !$end) {
    $end = date('Y-m-d', mktime(0, 0, 0, date("m"), 1,    date("Y")));
    $start = date('Y-m-d', mktime(0, 0, 0, date("m") -1, 1,    date("Y")));
  }

  // Get info about the resource if necessary
  if (!is_array($resource)) {
    $resource_name = $resource;
    $resource = hosting_quota_get($resource);
  }
  // Get usage and limit for the selected resource
  if ($resource['module']) {
    if (\Drupal::currentUser()->hasPermission("bypass all quotas")) {
      return TRUE;
    }
    if (\Drupal::currentUser()->hasPermission("bypass resource $resource_name limit")) {
      return TRUE;
    }
    $resource_usage = \Drupal::moduleHandler()->invoke($resource['module'], 'hosting_quota_get_usage', [$client, $resource_name, $start, $end]);
    $resource_limit = \Drupal::database()->query('SELECT value FROM {hosting_client_quota} WHERE client = :client AND resource = :resource', array(':client' => $client, ':resource' => $resource_name))->fetchField();
    // Return the appropriate values
    if ($resource_limit > $resource_usage) {
      return TRUE;
    }
    else {
      return FALSE;
    }
  }

  return NULL;
}

/**
 * Get the rendered usage and info for all resources
 *
 * @param $client int
 *   The id of the client entity
 * @param $start string
 *   Optional start date of the checking perios, defaults to 1st of last month
 * @param $end string
 *   Optional end date of the checked period, defaults to 1st of this month
 * @return
 *   An array of info about the clients quotas
 */

/**
 * @todo Please document this function.
 * @see http://drupal.org/node/1354
 */
function hosting_quota_get_all_info($client, $start = NULL, $end = NULL) {
  static $quota_info;

  if (!isset($quota_info)) {
    $quota_info = array();
    // Set up some default dates for the last month if necessary
    if (!$start || !$end) {
      $end = date('Y-m-d', mktime(0, 0, 0, date("m"), 1,    date("Y")));
      $start = date('Y-m-d', mktime(0, 0, 0, date("m") -1, 1,    date("Y")));
    }

    $all_resources = \Drupal::moduleHandler()->invokeAll('hosting_quota_resource');

    foreach ($all_resources as $resource_name => $resource_data) {

      // First read in the info from the resource
      $quota_info[$resource_name] = $resource_data;
      // We have to format this way to to dependencies in quota imps
      $resource = array(
        $resource_name => $resource_data,
      );

      // Get usage info
      $quota_info[$resource_name]['usage'] = hosting_quota_get_usage($client, $resource, $start, $end);

      // Fetch info about the quota limit directly from the db
      $quota_info[$resource_name]['limit'] = \Drupal::database()->query('SELECT value FROM {hosting_client_quota} WHERE client = :client AND resource = :resource', array(':client' => $client, ':resource' => $resource_name))->fetchField();

      // Render both limits and usage
      $quota_info[$resource_name]['rendered usage'] = hosting_quota_resource_render($resource, $quota_info[$resource_name]['usage']);
      $quota_info[$resource_name]['rendered limit'] = hosting_quota_resource_render($resource, $quota_info[$resource_name]['limit']);
    }

  }

  return $quota_info;
}

/**
 * Implements hook_hosting_client_update().
 */
function hosting_quota_hosting_client_update(\Drupal\Core\Entity\EntityInterface $entity) {
  if ($entity->getEntityTypeId() !== 'hosting_client' || !\Drupal::currentUser()->hasPermission('edit all quotas')) {
    return;
  }

  $values = array();
  if (isset($entity->quota_limits) && is_array($entity->quota_limits)) {
    $values = $entity->quota_limits;
  }
  elseif (isset($entity->quota) && is_array($entity->quota)) {
    foreach ($entity->quota as $resource => $info) {
      if (isset($info['limit'])) {
        $values['quota-' . $resource] = $info['limit'];
      }
    }
  }

  if ($values) {
    hosting_quota_save_limits_from_values($values, $entity->id());
  }
}

/**
 * Implements hook_hosting_client_insert().
 */
function hosting_quota_hosting_client_insert(\Drupal\Core\Entity\EntityInterface $entity) {
  hosting_quota_hosting_client_update($entity);
}

/**
 * Implements hook_hosting_client_load().
 */
function hosting_quota_hosting_client_load(array $entities) {
  foreach ($entities as $entity) {
    if ($entity instanceof \Drupal\Core\Entity\EntityInterface && $entity->getEntityTypeId() === 'hosting_client') {
      $entity->quota = hosting_quota_get_all_info($entity->id());
    }
  }
}

/**
 * Implements hook_hosting_client_view().
 */
function hosting_quota_hosting_client_view(array &$build, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display, $view_mode) {
  if ($entity->getEntityTypeId() !== 'hosting_client') {
    return;
  }
  $allowed_clients = array_keys(hosting_get_client_from_user(\Drupal::currentUser()->id()));
  if (\Drupal::currentUser()->hasPermission('view all quotas') || (in_array($entity->id(), $allowed_clients) && \Drupal::currentUser()->hasPermission('view own quota'))) {
    $build['info']['quota'] = array(
      '#type' => 'item',
      '#title' => t('Quota'),
      '#markup' => \Drupal::service('theme.manager')->render('hosting_quota_client', array('node' => $entity)),
      '#weight' => 5,
    );
  }
}

/**
 * Insert edit controls for the hosting quotas into the client edit form
 */
function hosting_quota_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $entity = NULL;
  if ($form_id === 'client_node_form' && isset($form['#node'])) {
    $entity = $form['#node'];
  }
  elseif ($form_id === 'hosting_client_form' && isset($form['#entity'])) {
    $entity = $form['#entity'];
  }

  if (\Drupal::currentUser()->hasPermission('edit all quotas') && $entity) {
    $config = \Drupal::config('hosting_quota.settings');

    if (!isset($entity->quota)) {
      $quota_info = \Drupal::moduleHandler()->invokeAll('hosting_quota_resource');
    }
    else{
      $quota_info = $entity->quota;
    }

    $form['quota'] = array(
      '#type' => 'fieldset',
      '#title' => t('Client quota settings'),
      '#access' => \Drupal::currentUser()->hasPermission('edit all quotas'),
      '#collapsible' => TRUE,
      '#collapsed' => TRUE,
    );

    foreach ($quota_info as $resource => $quota) {
      if (!isset($quota['limit'])) {
        $quota['limit'] = $config->get('default_limits.' . $resource) ?? 0;
      }
      $form['quota']['quota-' . $resource] = array(
        '#title' => \Drupal\Component\Utility\Html::escape($quota['title']),
        '#description' => \Drupal\Component\Utility\Html::escape($quota['description']),
        '#type' => 'textfield',
        '#default_value' => $quota ? $quota['limit'] : 0,
      );

      // Validate that a number was submitted for the quota
      $form['#validate'][] = 'hosting_quota_numeric_value';

    }
    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#submit'][] = 'hosting_quota_client_form_submit';
    }
  }
}

/**
 * Validate that quota values are numeric
 */
function hosting_quota_numeric_value($form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $values = $form_state->getValues();
  $candidate_sets = array($values);
  if (isset($values['quota']) && is_array($values['quota'])) {
    $candidate_sets[] = $values['quota'];
  }
  foreach ($candidate_sets as $set) {
    foreach ($set as $key => $value) {
      if ((substr($key, 0, 5) == 'quota') && !(is_numeric($value))) {
        $form_state->setErrorByName($key, 'You must set a number as a quota value!');
      }
    }
  }
}

/**
 * Submit handler for hosting client quota updates.
 */
function hosting_quota_client_form_submit(array &$form, \Drupal\Core\Form\FormStateInterface $form_state) {
  if (!\Drupal::currentUser()->hasPermission('edit all quotas')) {
    return;
  }

  $client_id = NULL;
  if (isset($form['#entity']) && $form['#entity'] instanceof \Drupal\Core\Entity\EntityInterface) {
    $client_id = $form['#entity']->getEntityTypeId() === 'hosting_client' ? $form['#entity']->id() : NULL;
  }
  if (!$client_id && isset($form['#node']) && is_object($form['#node']) && hosting_entity_id($form['#node'])) {
    $client_id = hosting_entity_id($form['#node']);
  }
  if (!$client_id && $form_state->getFormObject() && method_exists($form_state->getFormObject(), 'getEntity')) {
    $entity = $form_state->getFormObject()->getEntity();
    if ($entity instanceof \Drupal\Core\Entity\EntityInterface && $entity->getEntityTypeId() === 'hosting_client') {
      $client_id = $entity->id();
    }
  }
  if (!$client_id) {
    return;
  }

  hosting_quota_save_limits_from_values($form_state->getValues(), $client_id);
}

/**
 * Save quota limits from form or entity values.
 */
function hosting_quota_save_limits_from_values(array $values, $client_id) {
  $config = \Drupal::config('hosting_quota.settings');
  if (isset($values['quota']) && is_array($values['quota'])) {
    $values = $values['quota'] + $values;
  }
  foreach ($values as $field => $value) {
    if (substr($field, 0, 6) !== 'quota-') {
      continue;
    }
    $quota = substr($field, 6);
    if ($value === '' || $value === NULL) {
      $value = $config->get('default_limits.' . $quota) ?? 0;
    }
    hosting_quota_set_limit($client_id, $quota, $value);
  }
}

/**
 * Implements hook_theme().
 */
function hosting_quota_theme($existing, $type, $theme, $path) {
  return array(
    'hosting_quota_client' => array(
      'variables' => array(
        'node' => NULL,
      ),
    ),
    'hosting_quota_admin_list' => array(
      'variables' => array(
        'client_quotas' => array(),
        'resources' => array(),
        'items_per_page' => 25,
      ),
    ),
  );
}

/**
 * Theme the admin list of client quotas
 *
 * @param $variables array
 * @return string
 *   String containing table
 */
function theme_hosting_quota_admin_list($variables) {
  $client_quotas = $variables['client_quotas'];
  $resources = $variables['resources'];
  $items_per_page = $variables['items_per_page'];
  $header = array(t('Client'));
  $rows = array();

  foreach ($resources as $resource) {
    $header[] = t('@resource (Used / Limit)', array('@resource' => $resource['title']));
  }
  foreach ($client_quotas as $client_id => $quotas) {
    $row = array();
    $row[] = \Drupal\Core\Link::fromTextAndUrl($quotas['name'], \Drupal\Core\Url::fromUserInput('/hosting/client/' . $client_id))->toString();

    foreach ($resources as $resource => $resource_info) {
      // Provide a visual indication if the usage is over the limit
      if ($quotas[$resource]['usage'] > $quotas[$resource]['limit']) {
        $row[] = array(
          'data' => "{$quotas[$resource]['rendered usage']} / {$quotas[$resource]['rendered limit']}",
          'class' => array('warning'),
        );
      }
      else {
        $row[] = "{$quotas[$resource]['rendered usage']} / {$quotas[$resource]['rendered limit']}";
      }
    }
    $rows[] = $row;
  }
  return '<p>' . t('Usage information for the last month.') . '</p>' . \Drupal::service('theme.manager')->render('table', array('header' => $header, 'rows' => $rows)) . \Drupal::service('theme.manager')->render('pager', array('tags' => array()));
}

/**
 * Theme the client quota information.
 *
 * @param $variables array
 *
 * @return string
 */
function theme_hosting_quota_client($variables) {
  $node = $variables['node'];
  if (!empty($node->quota)) {
    $header = array(t('Resource'), t('Used'), t('Quota'));
    foreach ($node->quota as $resource => $value) {
      $row = array();
      $row[] = $value['title'];
      $row[] = $value['rendered usage'];
      $row[] = $value['rendered limit'];
      $rows[] = $row;
    }
    return \Drupal::service('theme.manager')->render('table', array('header' => $header, 'rows' => $rows));
  }
  return '';
}
